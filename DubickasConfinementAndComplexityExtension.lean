  change 2 ^ S_K * (2 ^ (10 * L_2 (K + 1)) * W (K + 1)) + 19 * Acc_K =
      3 ^ S_K * (3 ^ (10 * L_2 0) * W 0) at hm_K
  set W_tail := fun t => W (K + 1 + t)
  set L_2_tail := fun t => L_2 (K + 1 + t)
  set L_1_tail := fun t => L_1 (K + 1 + t)
