            p * (p * S_pre + 10 * (p + q) * L2_0 + q * W_0) :=
        Nat.mul_le_mul_left p (le_of_lt hpre)
      have hm_suf :
          q * (q * (E_suf + 10 * L2_end + 22)) <
            q * (p * (S_pre + 10 * L2_r2 + S_K + E_mid) + 10 * (p + q) * L2_0 + q * W_0) :=
        Nat.mul_lt_mul_of_pos_left hsuf_cancel hq_pos
      have h1 :
