    2 * 3 ^ (7 * L_1_1 + 10 * L_2_1 - 1) * W_1 < 2 ^ (7 * L_1_1 + 10 * L_2_2) * W_2 ∧
    -- 2. Immediate 3^(10*(L_2_1 - L_2_2)) = 59,049^(L_2_1 - L_2_2) exponential rebound when L_2_2 ≤ L_2_1:
    (L_2_2 ≤ L_2_1 →
