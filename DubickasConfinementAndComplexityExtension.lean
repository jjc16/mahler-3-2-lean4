    hcancel_2059.trans hpow3_W2
  have hmod19 :
      (2 ^ (7 * L_3 + 10 * L_4) * W_4) % 19 = (3 ^ (10 * L_2 + 7 * L_3) * W_2) % 19 := by
    have hm := congrArg (fun x => x % 19) hwave_W
