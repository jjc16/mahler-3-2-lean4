   $$\big(58025 \cdot 3^{7 m_1} U_1 + 19\big) \bmod 1024 = 0, \qquad
     \big(58025 \cdot 3^{7 m_1} U_1 + 19\big) \bmod 2059 = 0.$$ -/
theorem dense_core_one_to_two_run_interface_syzygy_and_ten_mul_valuation_lock
    {V j : ℕ → ℕ} {r_1 m_1 m_2 : ℕ}
    (hV0_pos : 1 ≤ V 0)
