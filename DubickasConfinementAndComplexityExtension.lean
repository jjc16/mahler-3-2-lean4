theorem dense_core_dual_multi_wave_homogeneous_difference_and_124499856384_growth
    {U L_1 L_2 : ℕ → ℕ} {N W_first : ℕ}
    (hL2 : ∀ t ≤ N, 1 ≤ L_2 t)
