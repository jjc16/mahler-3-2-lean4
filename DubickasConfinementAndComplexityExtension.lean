  -- Apply Section 126 Part 1 with S_end_eff := S_2 + 10 * L_2 0 + E_suf1 and S_K_eff := S_K2 + 10 * L_2 0 + E_suf1:
  set S_end_eff := S_2 + 10 * L_2 0 + E_suf1
