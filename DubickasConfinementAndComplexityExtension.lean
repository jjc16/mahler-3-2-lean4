      linarith only [hVr3_eq, hd]
    have hpow3_L2 : 3 ^ (10 * L_2) = 2187 * 3 ^ (10 * m_2 + 3) := by
      have hexp : 10 * L_2 = 7 + (10 * m_2 + 3) := by omega
      rw [hexp, Nat.pow_add]
    have hcross :
        (58025 * 2 ^ (7 * L_3)) * U_3 + 2187 * 19 =
          2187 * (2059 * 3 ^ (10 * m_2 + 3) * U_2) := by
