        _ = (2 ^ 17 * U_2A) * W_3 + (2 ^ 17 * U_2B) * W_4 := by rw [hU2A, hU2B]
        _ = 2 ^ 17 * (U_2A * W_3 + U_2B * W_4) := by ring
