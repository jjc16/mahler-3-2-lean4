    (h23 : 58025 * 2 ^ (7 * L_3) * W_3 + 19 = 2059 * 3 ^ (10 * L_2) * W_2)
    (h34 : 58025 * 3 ^ (7 * L_3) * W_3 + 19 = 2 ^ (10 * L_4) * 2059 * W_4)
    (h45 : 58025 * 2 ^ (7 * L_5) * W_5 + 19 = 2059 * 3 ^ (10 * L_4) * W_4)
