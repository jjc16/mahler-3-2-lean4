      ∀ r_1 r_2 K : ℕ, r_1 < r_2 →
        let E_K := defectStepSum (fun t => j (r_1 + 1 + t)) K
        ((∀ t ≤ K, j (r_1 + t) = j (r_2 + t)) ↔ 2 ^ (E_K + 7) ∣ (V r_2 - V r_1)) ∧
        (2 ^ (E_K + 7) ∣ (V r_2 - V r_1) ↔ V r_1 % 2 ^ (E_K + 7) = V r_2 % 2 ^ (E_K + 7)) := by
