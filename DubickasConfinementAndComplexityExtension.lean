    change 3 ^ S_N * (3 ^ (7 * L_1 0) * U 0) + 19 * Acc_N =
        2 ^ S_N * (2 ^ (7 * L_1 (N + 1)) * U (N + 1)) at hm
    have hp3 :
        3 ^ S_N * (3 ^ (7 * L_1 0) * U 0) = 3 ^ (S_N + 7 * L_1 0) * U 0 := by
