  have hfwd_W' :
      58024 * 3 ^ (S_2 + 10 * L_2 0 + E_suf1) <
        2 ^ (S_2 - S_K2 + 10 * L_2' (N_2' + 1)) * W' (N_2' + 1) := by
    have hle1 : 2 ^ (S_2 - S_K2) * (Y_end' - Y_end) ≤ 2 ^ (S_2 - S_K2) * Y_end' :=
