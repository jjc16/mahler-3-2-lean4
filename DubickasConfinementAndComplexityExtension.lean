  intro W L_2 L_1 N U_0 U_N hW0 hWN1 hU0 hL2_0 hL2_N1 hL1 hrec hout0 hinN
  have hY0_lt_X0 : scaledWaveY W L_2 0 < scaledWaveX W L_2 0 := by
