      have hexp2 : 2059 * ((2187 * 3 ^ (10 * m_2 + 3)) * U_2 + 8) =
          2187 * (2059 * 3 ^ (10 * m_2 + 3) * U_2) + 16472 := by ring
      have hexp3 : 58025 * (2 ^ (7 * L_3) * U_3 + 1) =
