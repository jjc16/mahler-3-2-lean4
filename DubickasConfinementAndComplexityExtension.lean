    ⟨58025 * 3 ^ (7 * m_1) * U_1 + 19, hcross.symm⟩
  have hcop_2187 : Nat.Coprime 2187 (2 ^ (10 * L_2) * 2059) := by
    have hc1 : Nat.Coprime (3 ^ 7) (2 ^ (10 * L_2)) :=
