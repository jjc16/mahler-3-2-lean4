      rw [hSK_eq] at h64
      have hd2_Acc : 2 ^ S_K ∣ 19 * (Acc_end - Acc_end') := by
        have hd1 : 2 ^ S_K ∣ (126900675 * 2 ^ S_K) := ⟨126900675, by ring⟩
