    · have hB1 : B_1 = 128 := by change 2 ^ (3 * j (r_1 + K + 1) + 4) = 128; rw [h1_1]; rfl
      have hB2 : B_2 = 1024 := by change 2 ^ (3 * j (r_2 + K + 1) + 4) = 1024; rw [h2_2]; rfl
      rw [hB1, hB2]
