      rw [hM_succ]; exact hdvd_super
    have h59_2 :=
      (dense_core_multi_wave_58025_super_divisibility_and_22_bit_repetition_cutoff.2
        W L_2 L_1 L_2_1 L_1_1 M N W_0 (W r_1) (L_2 (r_1 + N + 1))
