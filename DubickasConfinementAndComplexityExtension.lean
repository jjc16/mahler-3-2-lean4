      change waveInteriorExp L_2 L_1 K + (10 * L_2 (K + 1) + 7 * L_1 (K + 1)) =
        waveInteriorExp L_2 L_1 K + 10 * L_2 (K + 1) + 7 * L_1 (K + 1 + 0)
      have h0 : K + 1 + 0 = K + 1 := by omega
      rw [h0]
      omega
  | succ m ih =>
      change waveInteriorExp L_2 L_1 (K + 1 + m) +
