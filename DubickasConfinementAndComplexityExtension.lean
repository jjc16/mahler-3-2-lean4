private lemma waveInteriorExp_shift_comp
    (L_2 L_1 : ℕ → ℕ) (K d : ℕ) :
    waveInteriorExp L_2 L_1 (K + 1 + d) =
      waveInteriorExp L_2 L_1 K + 10 * L_2 (K + 1) +
        waveInteriorExp (fun t => L_2 (K + 1 + t)) (fun t => L_1 (K + 1 + t)) d := by
  induction d with
