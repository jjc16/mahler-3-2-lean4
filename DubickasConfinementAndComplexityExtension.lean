      have hdR : Nat.gcd (U (N + 1)) (19 * Acc_N) ∣ (19 * Acc_N) := Nat.gcd_dvd_right _ _
      have hm_comm : 19 * Acc_N + 3 ^ (S_N + 7 * L_1 0) * U 0 =
