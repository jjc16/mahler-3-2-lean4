        (Nat.dvd_add_iff_left hd2_Acc).mpr hd2_Y
      exact hcop58_2.mul_dvd_of_dvd_of_dvd hd58_X (hcop23.dvd_of_dvd_mul_left hd2_rhs)
    · intro hL1_suf hL2_suf
      have hsuf :=
