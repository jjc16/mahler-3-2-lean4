  have hupper121 : E1 * W_3 < S1 * (U_1 + 1) := by
    have hdist : S1 * (U_1 + 1) = S1 * U_1 + S1 := by ring
    omega
  have hbez121 := mod_and_div_of_bezout (V := E1 * W_3) (M := S1) (a := 0) (b := U_1)
