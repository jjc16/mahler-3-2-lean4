          2 ^ (S_tail + 10 * L_2 (K + 2 + d)) * W (K + 2 + d))) ≤
          2059 * (Acc_full * W (K + 1)) :=
      Nat.mul_le_mul_left 2059 hsum_le
    have hm_up :
