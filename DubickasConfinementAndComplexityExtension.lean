    refine ⟨hWr1_lt_Wr2, hdvd_super, h2_22_lt, ?_⟩
    intro p q hq hpq_le
    have hcut := h59_2 p q hq hpq_le
    have hL_end_pos : 1 ≤ L_2 (r_1 + N + 1) := hL2_pos (r_1 + N + 1)
