    intro W_end hle
    refine Nat.le_of_not_lt (fun hlt => ?_)
    have hc := hcut_B W_end hlt
    omega
  exact ⟨i, j, hij, hL_eq, hS_eq, hdvd_W, hcut_B, hcontra_B⟩

