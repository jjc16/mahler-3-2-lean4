    have hrec_2 :
        ∀ n ≤ N,
          2 ^ (7 * L_1_2 n + 10 * L_2_2 (n + 1)) * W_2 (n + 1) +
            19 * ((3 ^ (7 * L_1_2 n) - 2 ^ (7 * L_1_2 n)) / 2059) =
            3 ^ (10 * L_2_2 n + 7 * L_1_2 n) * W_2 n := by
      intro n _
      dsimp [W_2, L_2_2, L_1_2]
