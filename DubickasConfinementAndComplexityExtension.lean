    · intro hL3_1
      subst hL3_1
      have hlin : 3 ^ 17 * W_3 + 19 = 1024 * (3 ^ 7 * W_3 + U_10 * 2059 * W_4) := hrew1024
      set K := 3 ^ 7 * W_3 + U_10 * 2059 * W_4
      have hbez :
          W_3 + 1024 * (94206740 * W_3 + 14) =
            1024 * (747 * K) + 143 := by
        have h17 : (3 : ℕ) ^ 17 = 129140163 := by decide
        rw [h17] at hlin
