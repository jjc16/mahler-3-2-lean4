          fun h1 => (hd.2.1 (k + 1) hm1.1 hm1.2 hm2.1 hm2.2 hm3.1 hm3.2 h1).1
        have hno000 := hex000 k hk
        rcases hb0 with h0 | h0 <;> rcases hb1 with h1 | h1 <;> rcases hb2 with h2 | h2
        · exfalso; exact hno000 h0 h1 h2
        · omega
        · omega
