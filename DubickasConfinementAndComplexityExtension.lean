  have hlt1_P3 :
      P3_K * (2059 * (3 ^ (10 * L_2 0 + S_tail) * W 0 +
        2 ^ (S_tail + 10 * L_2 (K + 2 + d)) * W (K + 2 + d))) <
        P3_K * (2187 * 3 ^ (10 * L_2 (K + 1) + S_tail) * W (K + 1)) := by
    have hm_sum :
