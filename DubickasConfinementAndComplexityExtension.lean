  have hp := two_pow_seven_mul_mod_71 L_3
  have hm := hmod
  rw [Nat.add_mod, Nat.mul_mod, Nat.mul_mod 58025] at hm
  have h1 : L_3 % 5 = 1 → W_3 % 71 = 46 := by
    intro h; rw [hp.2.1 h] at hm
