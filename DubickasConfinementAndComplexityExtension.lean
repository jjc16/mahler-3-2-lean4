            (2 ^ (S_K + 10 * L_2 (K + 1)) * Acc_tail) * W (K + 1) := by
      rw [hAcc_comp]; ring
    linarith only [hm1, hm2, hd1, hd1_r, hd2, hd2_r, hd_full]
