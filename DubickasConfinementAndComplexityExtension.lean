    have hm_SM : p * waveInteriorExp L_2 L_1 M ≤ p * waveInteriorExp L_2 L_1 C :=
      Nat.mul_le_mul_left p hSM_le_SC
    exact ⟨by linarith only [hcut.1, hm1, hm_SM], by linarith only [hcut.2, hm2, hm_SM]⟩
