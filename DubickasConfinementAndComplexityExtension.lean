    {U_1 W_2 W_3 W_4 m_1 L_2 L_3 L_4 Q_L3 R_L2 : ℕ}
    (hW2_pos : 1 ≤ W_2) (hL2_pos : 1 ≤ L_2) (hL3_pos : 1 ≤ L_3)
