  have h24_bound := Nat.mod_lt W_3 (by decide : 0 < 24)
  have h29_bound := Nat.mod_lt W_3 (by decide : 0 < 29)
  have h464_bound := Nat.mod_lt W_3 (by decide : 0 < 464)
  have h1392_bound := Nat.mod_lt W_3 (by decide : 0 < 1392)
