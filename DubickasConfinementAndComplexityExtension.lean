  have h19R_lt_S1 : 19 * R_L2 < S1 := by
    have hp : 1 ≤ 3053 * 3 ^ (7 * m_1) := by
      have h3p : 1 ≤ 3 ^ (7 * m_1) := Nat.pow_pos (by decide)
