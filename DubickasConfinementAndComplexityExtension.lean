theorem dense_core_full_exponent_archimedean_wave_bound_and_step_sum_expansion
    {W L_2 L_1 : ℕ → ℕ} {N : ℕ}
    (hW0 : 1 ≤ W 0) (hL2_0 : 1 ≤ L_2 0)
    (hL1 : ∀ t ≤ N, 1 ≤ L_1 t)
