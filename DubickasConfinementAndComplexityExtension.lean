  have h130_1 :=
    dense_core_same_run_junction_16243286400_sieve_and_bidirectional_cutoffs.1
      (hL1 (r i)).1 (hL1 (r j)).1 (hL1 (r i - 1)).1 (hL1 (r j - 1)).1
