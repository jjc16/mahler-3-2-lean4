    have hW1_0_pos : 1 ≤ W_1 0 := hW_pos r_1
    have hW1_lt_W2 : W_1 0 < W_2 0 := hWr1_lt_Wr2
    have h2_22_lt : 2 ^ (S_sub + 10 * L_2 (r_1 + N + 1) + 22) < W r_2 := by
