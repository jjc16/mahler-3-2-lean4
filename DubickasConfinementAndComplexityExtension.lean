  have hdvd_E7 : 2 ^ (E_K + 7) ∣ (V r_2 - V r_1) := by
    rcases h128_dvd_B with ⟨U, hU⟩
    have hpow7 : 2 ^ (E_K + 7) = 2 ^ E_K * 128 := by rw [Nat.pow_add]
    have hdvd_prod : 2 ^ (E_K + 7) ∣ 3 ^ S_K1 * (V r_2 - V r_1) := by
      refine ⟨U, ?_⟩
      rw [← hext_eq, hU, hpow7]
