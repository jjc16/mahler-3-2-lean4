theorem normalizedDefectAcc_cocycle_composition_law
    (j : ℕ → ℕ) (d_1 m : ℕ) :
    defectStepSum j (d_1 + m) =
      defectStepSum j d_1 + defectStepSum (fun t => j (d_1 + t)) m ∧
    normalizedDefectAcc j (d_1 + m) =
