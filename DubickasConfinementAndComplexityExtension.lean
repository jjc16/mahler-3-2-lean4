    have hW3_eq : U_3 = 2187 * W_3 := (Nat.mul_div_cancel' hdvd_2187).symm
    have hW3_odd : W_3 % 2 = 1 := by
      rcases Nat.mod_two_eq_zero_or_one W_3 with h0 | h1
