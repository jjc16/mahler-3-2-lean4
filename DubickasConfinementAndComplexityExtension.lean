theorem defectNormalizedQuotient_ternary_cooldown_mod_128_sieve
    {V_1 V_2 j_1 j_2 : ℕ}
    (hj2 : 1 ≤ j_2)
    (hrec : 2 ^ (3 * j_2 + 4) * V_2 + 1 = 3 ^ (3 * j_1 + 4) * V_1) :
    (j_1 = 1 → V_1 % 128 = 35) ∧
    (j_1 = 2 → V_1 % 128 = 25) ∧
    (j_1 = 3 → V_1 % 128 = 91) := by
  have h12 := defectNormalizedQuotient_cooldown_mod_128_and_three_adic_lock.1
