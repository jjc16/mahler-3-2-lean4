  have h3_le_sub : 3 ^ (S_K1 + E_mid) ≤ 2 ^ (E_suf2 - E_suf1) * q_Y2 - q_Y1 := by
    rw [hKY]; exact Nat.le_mul_of_pos_right _ hKY_pos
  have h3_lt_Y : 3 ^ (S_K1 + E_mid) < 2 ^ (E_suf2 - E_suf1) * q_Y2 := by
    have hle_qY1 : q_Y1 ≤ 2 ^ (E_suf2 - E_suf1) * q_Y2 := by omega
    have hadd := Nat.sub_add_cancel hle_qY1
    linarith only [h3_le_sub, hadd, hqY1_pos]
  exact ⟨h2_lt_X, h3_lt_Y⟩

/-!
## Section 111: Archimedean Cutoff from Four-Window Middle-Defect Cancellation (`(p + q) * (S_K1 + E_mid) + p * E_suf2 + q * E_suf1 + 15 * q < p * S_M + ...`)

When the second anagram pair in Section 110 ends at horizon `M + 1` along an orbit starting from
`W(0) < 2^W_0`:
1. Since `Y(M + 1) > Y(M + 1) - Y_a = 58025 * 3^E_suf2 * q_Y2` and Section 110 gives
   `3^(S_K1 + E_mid) < 2^(E_suf2 - E_suf1) * q_Y2`, multiplying by `58025 * 3^E_suf2` yields:
     `2^15 * 3^(S_K1 + E_mid + E_suf2) < 2^(E_suf2 - E_suf1) * Y(M + 1)`!
2. Combining this with `2^S_M * Y(M + 1) < 3^(S_M + 10*L_2(0)) * 2^W_0` and canceling
   `3^(S_K1 + E_mid + E_suf2)` against `3^(S_M + 10*L_2(0))` proves:
     `2^(S_M + 15) < 3^(S_M + 10*L_2(0) - (S_K1 + E_mid + E_suf2)) * 2^(E_suf2 - E_suf1 + W_0)`,
   which for every `3^q ≤ 2^(p + q)` (`q ≥ 1`) forces:
     `(p + q) * (S_K1 + E_mid) + p * E_suf2 + q * E_suf1 + 15 * q < p * S_M + 10 * (p + q) * L_2(0) + q * W_0`!
   Crucially, **`E_mid` now appears on the LEFT-HAND SIDE with full weight `(p + q) = 27`** (against
   `p = 10` on `S_M`), instead of appearing on the right-hand side as a penalty!
-/

/-- **Archimedean Cutoff from Four-Window Middle-Defect Cancellation:**
Whenever `3^(S_K1 + E_mid) < 2^(E_suf2 - E_suf1) * q_Y2` and `58,025 * 3^E_suf2 * q_Y2 ≤ Y(M + 1)`
along an orbit starting from `W(0) < 2^W_0` (`E_suf1 ≤ E_suf2`, `S_K1 + E_mid + E_suf2 ≤ S_M + 10*L_2(0)`),
`(p + q) * (S_K1 + E_mid) + p * E_suf2 + q * E_suf1 + 15 * q < p * S_M + 10 * (p + q) * L_2(0) + q * W_0`
for every `3^q ≤ 2^(p + q)` (`q ≥ 1`). -/
theorem dense_core_four_window_middle_cancellation_archimedean_cutoff
    {W L_2 L_1 : ℕ → ℕ} {M W_0 S_K1 E_mid E_suf1 E_suf2 q_Y2 : ℕ}
    (hW0_lt : W 0 < 2 ^ W_0)
    (hL1_0 : 1 ≤ L_1 0)
    (hrec : ∀ n ≤ M,
      2 ^ (7 * L_1 n + 10 * L_2 (n + 1)) * W (n + 1) +
        19 * ((3 ^ (7 * L_1 n) - 2 ^ (7 * L_1 n)) / 2059) =
        3 ^ (10 * L_2 n + 7 * L_1 n) * W n)
    (hEsuf_le : E_suf1 ≤ E_suf2)
    (hsum_le : S_K1 + E_mid + E_suf2 ≤ waveInteriorExp L_2 L_1 M + 10 * L_2 0)
    (h3_lt_Y2 : 3 ^ (S_K1 + E_mid) < 2 ^ (E_suf2 - E_suf1) * q_Y2)
    (hY_ge : 58025 * 3 ^ E_suf2 * q_Y2 ≤ scaledWaveY W L_2 (M + 1)) :
    let S_M := waveInteriorExp L_2 L_1 M
    2 ^ 15 * 3 ^ (S_K1 + E_mid + E_suf2) <
      2 ^ (E_suf2 - E_suf1) * scaledWaveY W L_2 (M + 1) ∧
    2 ^ (S_M + 15) <
      3 ^ (S_M + 10 * L_2 0 - (S_K1 + E_mid + E_suf2)) * 2 ^ (E_suf2 - E_suf1 + W_0) ∧
    (∀ p q : ℕ, 1 ≤ q → 3 ^ q ≤ 2 ^ (p + q) →
      (p + q) * (S_K1 + E_mid) + p * E_suf2 + q * E_suf1 + 15 * q <
        p * S_M + 10 * (p + q) * L_2 0 + q * W_0) ∧
    27 * (S_K1 + E_mid) + 10 * E_suf2 + 17 * E_suf1 + 255 <
      10 * S_M + 270 * L_2 0 + 17 * W_0 := by
  intro S_M
  set E_tot := S_K1 + E_mid + E_suf2
  set dE := E_suf2 - E_suf1
  have h2_15_lt : 2 ^ 15 * 3 ^ E_tot < 2 ^ dE * scaledWaveY W L_2 (M + 1) := by
    have h15 : (2 : ℕ) ^ 15 < 58025 := by decide
    have hp3_split : 3 ^ E_tot = 3 ^ E_suf2 * 3 ^ (S_K1 + E_mid) := by
      dsimp [E_tot]; rw [Nat.pow_add 3 (S_K1 + E_mid) E_suf2]; ring
    have hm1 :
        2 ^ 15 * (3 ^ E_suf2 * 3 ^ (S_K1 + E_mid)) <
          58025 * (3 ^ E_suf2 * (2 ^ dE * q_Y2)) := by
      have ha : 2 ^ 15 * 3 ^ E_suf2 < 58025 * 3 ^ E_suf2 :=
        Nat.mul_lt_mul_of_pos_right h15 (Nat.pow_pos (by decide))
      have hb :
          (58025 * 3 ^ E_suf2) * 3 ^ (S_K1 + E_mid) <
            (58025 * 3 ^ E_suf2) * (2 ^ dE * q_Y2) :=
        Nat.mul_lt_mul_of_pos_left h3_lt_Y2
          (Nat.mul_pos (by decide : 0 < 58025) (Nat.pow_pos (by decide : 0 < 3)))
      have hc : (2 ^ 15 * 3 ^ E_suf2) * 3 ^ (S_K1 + E_mid) ≤
          (58025 * 3 ^ E_suf2) * 3 ^ (S_K1 + E_mid) :=
        Nat.mul_le_mul_right _ (le_of_lt ha)
      calc 2 ^ 15 * (3 ^ E_suf2 * 3 ^ (S_K1 + E_mid))
          = (2 ^ 15 * 3 ^ E_suf2) * 3 ^ (S_K1 + E_mid) := by ring
        _ ≤ (58025 * 3 ^ E_suf2) * 3 ^ (S_K1 + E_mid) := hc
        _ < (58025 * 3 ^ E_suf2) * (2 ^ dE * q_Y2) := hb
        _ = 58025 * (3 ^ E_suf2 * (2 ^ dE * q_Y2)) := by ring
    have hm2 :
        58025 * (3 ^ E_suf2 * (2 ^ dE * q_Y2)) ≤ 2 ^ dE * scaledWaveY W L_2 (M + 1) := by
      calc 58025 * (3 ^ E_suf2 * (2 ^ dE * q_Y2))
          = 2 ^ dE * (58025 * 3 ^ E_suf2 * q_Y2) := by ring
        _ ≤ 2 ^ dE * scaledWaveY W L_2 (M + 1) := Nat.mul_le_mul_left _ hY_ge
    rw [hp3_split]
    exact lt_of_lt_of_le hm1 hm2
  have hAcc_pos : 1 ≤ waveInteriorAcc L_2 L_1 M := waveInteriorAcc_pos L_2 L_1 hL1_0 M
  have hm :=
    (dense_core_symmetric_multi_wave_master_identity_and_boundary_independence.2
      W L_2 L_1 M hrec).1
  change 2 ^ S_M * scaledWaveY W L_2 (M + 1) + 19 * waveInteriorAcc L_2 L_1 M =
      3 ^ S_M * (3 ^ (10 * L_2 0) * W 0) at hm
  have hp3_M : 3 ^ (S_M + 10 * L_2 0) * W 0 = 3 ^ S_M * (3 ^ (10 * L_2 0) * W 0) := by
    rw [Nat.pow_add]; ring
  have hup_W0 : 2 ^ S_M * scaledWaveY W L_2 (M + 1) < 3 ^ (S_M + 10 * L_2 0) * W 0 := by
    linarith only [hm, hp3_M, hAcc_pos]
  have hup_2W0 : 2 ^ S_M * scaledWaveY W L_2 (M + 1) < 3 ^ (S_M + 10 * L_2 0) * 2 ^ W_0 :=
    lt_trans hup_W0 (Nat.mul_lt_mul_of_pos_left hW0_lt (Nat.pow_pos (by decide)))
  have hcomb_lt :
      3 ^ E_tot * 2 ^ (S_M + 15) <
        3 ^ E_tot * (3 ^ (S_M + 10 * L_2 0 - E_tot) * 2 ^ (dE + W_0)) := by
    have hp_lhs : 3 ^ E_tot * 2 ^ (S_M + 15) = 2 ^ S_M * (2 ^ 15 * 3 ^ E_tot) := by
      rw [Nat.pow_add 2 S_M 15]; ring
    set E_rem := S_M + 10 * L_2 0 - E_tot
    have hexp : S_M + 10 * L_2 0 = E_tot + E_rem := by dsimp [E_rem, E_tot]; omega
    have hp_rhs :
        2 ^ dE * (3 ^ (S_M + 10 * L_2 0) * 2 ^ W_0) =
          3 ^ E_tot * (3 ^ E_rem * 2 ^ (dE + W_0)) := by
      calc 2 ^ dE * (3 ^ (S_M + 10 * L_2 0) * 2 ^ W_0)
          = 2 ^ dE * ((3 ^ E_tot * 3 ^ E_rem) * 2 ^ W_0) := by rw [hexp, Nat.pow_add]
        _ = 3 ^ E_tot * (3 ^ E_rem * (2 ^ dE * 2 ^ W_0)) := by ring
        _ = 3 ^ E_tot * (3 ^ E_rem * 2 ^ (dE + W_0)) := by rw [← Nat.pow_add 2 dE W_0]
    have hm_mid :
        2 ^ S_M * (2 ^ dE * scaledWaveY W L_2 (M + 1)) <
          2 ^ dE * (3 ^ (S_M + 10 * L_2 0) * 2 ^ W_0) := by
      have heq :
          2 ^ S_M * (2 ^ dE * scaledWaveY W L_2 (M + 1)) =
            2 ^ dE * (2 ^ S_M * scaledWaveY W L_2 (M + 1)) := by ring
      rw [heq]
      exact Nat.mul_lt_mul_of_pos_left hup_2W0 (Nat.pow_pos (by decide))
    rw [hp_lhs, ← hp_rhs]
    exact lt_trans (Nat.mul_lt_mul_of_pos_left h2_15_lt (Nat.pow_pos (by decide))) hm_mid
  have hcancel_lt :
      2 ^ (S_M + 15) < 3 ^ (S_M + 10 * L_2 0 - E_tot) * 2 ^ (dE + W_0) := by
    refine Nat.lt_of_not_le (fun hge => ?_)
    have hm_ge := Nat.mul_le_mul_left (3 ^ E_tot) hge
    linarith only [hcomb_lt, hm_ge]
  have hpq :
      ∀ p q : ℕ, 1 ≤ q → 3 ^ q ≤ 2 ^ (p + q) →
        (p + q) * (S_K1 + E_mid) + p * E_suf2 + q * E_suf1 + 15 * q <
          p * S_M + 10 * (p + q) * L_2 0 + q * W_0 := by
    intro p q hq hpq_le
    set E_lhs := S_M + 15
    set E_3 := S_M + 10 * L_2 0 - E_tot
    set E_2 := dE + W_0
    have hpow_q : (2 ^ E_lhs) ^ q < (3 ^ E_3 * 2 ^ E_2) ^ q :=
      pow_lt_pow_of_lt hcancel_lt hq
    have h3_le : (3 ^ E_3) ^ q ≤ 2 ^ ((p + q) * E_3) := by
      calc (3 ^ E_3) ^ q
          = 3 ^ (E_3 * q) := (Nat.pow_mul 3 E_3 q).symm
        _ = 3 ^ (q * E_3) := by rw [Nat.mul_comm E_3 q]
        _ = (3 ^ q) ^ E_3 := Nat.pow_mul 3 q E_3
        _ ≤ (2 ^ (p + q)) ^ E_3 := Nat.pow_le_pow_left hpq_le E_3
        _ = 2 ^ ((p + q) * E_3) := (Nat.pow_mul 2 (p + q) E_3).symm
    have hrhs_le : (3 ^ E_3 * 2 ^ E_2) ^ q ≤ 2 ^ ((p + q) * E_3 + q * E_2) := by
      calc (3 ^ E_3 * 2 ^ E_2) ^ q
          = (3 ^ E_3) ^ q * (2 ^ E_2) ^ q := Nat.mul_pow (3 ^ E_3) (2 ^ E_2) q
        _ ≤ 2 ^ ((p + q) * E_3) * (2 ^ E_2) ^ q := Nat.mul_le_mul_right _ h3_le
        _ = 2 ^ ((p + q) * E_3) * 2 ^ (E_2 * q) := by rw [← Nat.pow_mul 2 E_2 q]
        _ = 2 ^ ((p + q) * E_3) * 2 ^ (q * E_2) := by rw [Nat.mul_comm E_2 q]
        _ = 2 ^ ((p + q) * E_3 + q * E_2) := (Nat.pow_add 2 _ _).symm
    have hlhs_eq : (2 ^ E_lhs) ^ q = 2 ^ (q * E_lhs) := by
      rw [← Nat.pow_mul 2 E_lhs q, Nat.mul_comm E_lhs q]
    have hpow2_lt : 2 ^ (q * E_lhs) < 2 ^ ((p + q) * E_3 + q * E_2) := by
      rw [← hlhs_eq]; exact lt_of_lt_of_le hpow_q hrhs_le
    have hexp_lt : q * E_lhs < (p + q) * E_3 + q * E_2 := by
      refine Nat.lt_of_not_le (fun hge => ?_)
      have hpow_ge : 2 ^ ((p + q) * E_3 + q * E_2) ≤ 2 ^ (q * E_lhs) :=
        Nat.pow_le_pow_right (by decide) hge
      omega
    have hE3_add : E_3 + E_tot = S_M + 10 * L_2 0 := by dsimp [E_3, E_tot]; omega
    have hdE_add : dE + E_suf1 = E_suf2 := Nat.sub_add_cancel hEsuf_le
    have hexp_rhs :
        ((p + q) * E_3 + q * E_2) + (p + q) * E_tot + q * E_suf1 =
          q * S_M + q * E_suf2 + (p * S_M + 10 * (p + q) * L_2 0 + q * W_0) := by
      calc ((p + q) * E_3 + q * E_2) + (p + q) * E_tot + q * E_suf1
          = (p + q) * (E_3 + E_tot) + q * (dE + E_suf1) + q * W_0 := by
              dsimp [E_2]; ring
        _ = (p + q) * (S_M + 10 * L_2 0) + q * E_suf2 + q * W_0 := by
              rw [hE3_add, hdE_add]
        _ = q * S_M + q * E_suf2 + (p * S_M + 10 * (p + q) * L_2 0 + q * W_0) := by ring
    have hexp_lhs :
        q * E_lhs + (p + q) * E_tot + q * E_suf1 =
          q * S_M + q * E_suf2 +
            ((p + q) * (S_K1 + E_mid) + p * E_suf2 + q * E_suf1 + 15 * q) := by
      dsimp [E_lhs, E_tot]; ring
    omega
  have h10_17 := hpq 10 17 (by decide) (by decide : 3 ^ 17 ≤ 2 ^ (10 + 17))
  exact ⟨h2_15_lt, hcancel_lt, hpq, by linarith only [h10_17]⟩

/-!
## Section 112: General Two-Window `+19`-Elimination Wronskian Syzygy, Coprime `(2, 3)`-Adic Valuation Transfer & the `2059 : 2187` Ratio Band Across Arbitrary Windows

What relates **any two windows** `(X_1, Y_1, S_1, Acc_1)` and `(X_2, Y_2, S_2, Acc_2)` of arbitrary
lengths `N, M ∈ ℕ` along an orbit—even when they share **zero** runs and are **not** anagrams (`S_1 ≠ S_2`)?
From `2^S_1 * Y_1 + 19 * Acc_1 = 3^S_1 * X_1` and `2^S_2 * Y_2 + 19 * Acc_2 = 3^S_2 * X_2`:
1. **Exact `+19`-Free Cross-Multiplied Wronskian Syzygy:**
     `Acc_2 * (3^S_1 * X_1 - 2^S_1 * Y_1) = Acc_1 * (3^S_2 * X_2 - 2^S_2 * Y_2)`,
   and in positive-term form:
     `3^S_1 * Acc_2 * X_1 + 2^S_2 * Acc_1 * Y_2 = 3^S_2 * Acc_1 * X_2 + 2^S_1 * Acc_2 * Y_1`!
2. **Exact Coprime `(2, 3)`-Adic Valuation Transfer:**
   Since `gcd(Acc_i, 6) = 1` (Section 57), for **every** `a, b ∈ ℕ`:
     `2^a ∣ (3^S_1 * X_1 - 2^S_1 * Y_1) ↔ 2^a ∣ (3^S_2 * X_2 - 2^S_2 * Y_2)`  and
     `3^b ∣ (3^S_1 * X_1 - 2^S_1 * Y_1) ↔ 3^b ∣ (3^S_2 * X_2 - 2^S_2 * Y_2)`!
3. **Universal `2059 : 2187` Archimedean Ratio Band (`1 ≤ X_2`):**
   Eliminating `Acc_1` and `Acc_2` via Section 79 (`2059 * 3^(S_i - 7) ≤ 2059 * Acc_i < 2187 * 3^(S_i - 7)`)
   and canceling `3^(S_1 - 7) * 3^(S_2 - 7)` proves:
     `2059 * (3^S_1 * X_1 - 2^S_1 * Y_1) < 2187 * (3^S_2 * X_2 - 2^S_2 * Y_2)`  (normalized by `3^(S_2 - 7)` vs `3^(S_1 - 7)`)!
-/

/-- **General Two-Window `+19`-Elimination Wronskian Syzygy, Coprime `(2, 3)`-Adic Valuation Transfer & `2059 : 2187` Ratio Band:**
Across any two windows `(W, L_2, L_1, N)` and `(W', L'_2, L'_1, M)`, eliminating `+ 19` yields the
exact Wronskian syzygy `Acc'_M * (3^S_N * X_0 - 2^S_N * Y_end) = Acc_N * (3^S'_M * X'_0 - 2^S'_M * Y'_end)`,
bi-directional `(2^a, 3^b)` divisibility equivalence, and the `2059 : 2187` archimedean ratio bound. -/
theorem dense_core_general_two_window_wronskian_elimination_and_coprime_transfer
    {W L_2 L_1 W' L_2' L_1' : ℕ → ℕ} {N M : ℕ}
    (hL1 : ∀ t ≤ N, 1 ≤ L_1 t)
    (hL1' : ∀ t ≤ M, 1 ≤ L_1' t)
    (hrec : ∀ n ≤ N,
      2 ^ (7 * L_1 n + 10 * L_2 (n + 1)) * W (n + 1) +
        19 * ((3 ^ (7 * L_1 n) - 2 ^ (7 * L_1 n)) / 2059) =
        3 ^ (10 * L_2 n + 7 * L_1 n) * W n)
    (hrec' : ∀ n ≤ M,
      2 ^ (7 * L_1' n + 10 * L_2' (n + 1)) * W' (n + 1) +
        19 * ((3 ^ (7 * L_1' n) - 2 ^ (7 * L_1' n)) / 2059) =
        3 ^ (10 * L_2' n + 7 * L_1' n) * W' n) :
    let S_1 := waveInteriorExp L_2 L_1 N
    let S_2 := waveInteriorExp L_2' L_1' M
    let Acc_1 := waveInteriorAcc L_2 L_1 N
    let Acc_2 := waveInteriorAcc L_2' L_1' M
    let X_1 := scaledWaveX W L_2 0
    let Y_1 := scaledWaveY W L_2 (N + 1)
    let X_2 := scaledWaveX W' L_2' 0
    let Y_2 := scaledWaveY W' L_2' (M + 1)
    -- 1. Exact +19-free cross-multiplied Wronskian syzygy:
    Acc_2 * (3 ^ S_1 * X_1 - 2 ^ S_1 * Y_1) = Acc_1 * (3 ^ S_2 * X_2 - 2 ^ S_2 * Y_2) ∧
    3 ^ S_1 * Acc_2 * X_1 + 2 ^ S_2 * Acc_1 * Y_2 =
      3 ^ S_2 * Acc_1 * X_2 + 2 ^ S_1 * Acc_2 * Y_1 ∧
    -- 2. Bi-directional coprime (2^a, 3^b) valuation transfer:
    (∀ a : ℕ, 2 ^ a ∣ (3 ^ S_1 * X_1 - 2 ^ S_1 * Y_1) ↔ 2 ^ a ∣ (3 ^ S_2 * X_2 - 2 ^ S_2 * Y_2)) ∧
    (∀ b : ℕ, 3 ^ b ∣ (3 ^ S_1 * X_1 - 2 ^ S_1 * Y_1) ↔ 3 ^ b ∣ (3 ^ S_2 * X_2 - 2 ^ S_2 * Y_2)) ∧
    -- 3. Universal 2059 : 2187 archimedean ratio band:
    2059 * 3 ^ (S_2 - 7) * (3 ^ S_1 * X_1 - 2 ^ S_1 * Y_1) <
      2187 * 3 ^ (S_1 - 7) * (3 ^ S_2 * X_2 - 2 ^ S_2 * Y_2) := by
  intro S_1 S_2 Acc_1 Acc_2 X_1 Y_1 X_2 Y_2
  have hm1 :=
    (dense_core_symmetric_multi_wave_master_identity_and_boundary_independence.2
      W L_2 L_1 N hrec).1
  have hm2 :=
    (dense_core_symmetric_multi_wave_master_identity_and_boundary_independence.2
      W' L_2' L_1' M hrec').1
  change 2 ^ S_1 * Y_1 + 19 * Acc_1 = 3 ^ S_1 * X_1 at hm1
  change 2 ^ S_2 * Y_2 + 19 * Acc_2 = 3 ^ S_2 * X_2 at hm2
  have hsub1 : 3 ^ S_1 * X_1 - 2 ^ S_1 * Y_1 = 19 * Acc_1 := by omega
  have hsub2 : 3 ^ S_2 * X_2 - 2 ^ S_2 * Y_2 = 19 * Acc_2 := by omega
  have hsyz1 :
      Acc_2 * (3 ^ S_1 * X_1 - 2 ^ S_1 * Y_1) = Acc_1 * (3 ^ S_2 * X_2 - 2 ^ S_2 * Y_2) := by
    rw [hsub1, hsub2]; ring
  have hsyz2 :
      3 ^ S_1 * Acc_2 * X_1 + 2 ^ S_2 * Acc_1 * Y_2 =
        3 ^ S_2 * Acc_1 * X_2 + 2 ^ S_1 * Acc_2 * Y_1 := by
    have hc1 := congrArg (fun x => Acc_2 * x) hm1
    have hc2 := congrArg (fun x => Acc_1 * x) hm2
    have hd1 :
        Acc_2 * (2 ^ S_1 * Y_1 + 19 * Acc_1) =
          2 ^ S_1 * Acc_2 * Y_1 + 19 * Acc_1 * Acc_2 := by ring
    have hd2 : Acc_2 * (3 ^ S_1 * X_1) = 3 ^ S_1 * Acc_2 * X_1 := by ring
    have hd3 :
        Acc_1 * (2 ^ S_2 * Y_2 + 19 * Acc_2) =
          2 ^ S_2 * Acc_1 * Y_2 + 19 * Acc_1 * Acc_2 := by ring
    have hd4 : Acc_1 * (3 ^ S_2 * X_2) = 3 ^ S_2 * Acc_1 * X_2 := by ring
    linarith only [hc1, hc2, hd1, hd2, hd3, hd4]
  -- Coprimality of Acc_1 and Acc_2 with 2 and 3 (Section 57):
  have h57_1 :=
    dense_core_waveInteriorAcc_telescopic_cross_defect_and_mirror_collapses.1 L_2 L_1 N hL1
  have h57_2 :=
    dense_core_waveInteriorAcc_telescopic_cross_defect_and_mirror_collapses.1 L_2' L_1' M hL1'
  have hAcc1_odd : Acc_1 % 2 = 1 := h57_1.2.2.2.2.2.1
  have hAcc2_odd : Acc_2 % 2 = 1 := h57_2.2.2.2.2.2.1
  have hAcc1_ndvd3 : ¬(3 ∣ Acc_1) := h57_1.2.2.2.2.2.2.2
  have hAcc2_ndvd3 : ¬(3 ∣ Acc_2) := h57_2.2.2.2.2.2.2.2
  have hcop2_1 : ∀ a : ℕ, Nat.Coprime (2 ^ a) Acc_1 := fun a =>
    Nat.Coprime.pow_left a ((Nat.Prime.coprime_iff_not_dvd (by decide : Nat.Prime 2)).mpr
      (by intro hd; have := Nat.mod_eq_zero_of_dvd hd; omega))
  have hcop2_2 : ∀ a : ℕ, Nat.Coprime (2 ^ a) Acc_2 := fun a =>
    Nat.Coprime.pow_left a ((Nat.Prime.coprime_iff_not_dvd (by decide : Nat.Prime 2)).mpr
      (by intro hd; have := Nat.mod_eq_zero_of_dvd hd; omega))
  have hcop3_1 : ∀ b : ℕ, Nat.Coprime (3 ^ b) Acc_1 := fun b =>
    Nat.Coprime.pow_left b ((Nat.Prime.coprime_iff_not_dvd (by decide : Nat.Prime 3)).mpr hAcc1_ndvd3)
  have hcop3_2 : ∀ b : ℕ, Nat.Coprime (3 ^ b) Acc_2 := fun b =>
    Nat.Coprime.pow_left b ((Nat.Prime.coprime_iff_not_dvd (by decide : Nat.Prime 3)).mpr hAcc2_ndvd3)
  have hdvd2_iff :
      ∀ a : ℕ, 2 ^ a ∣ (3 ^ S_1 * X_1 - 2 ^ S_1 * Y_1) ↔ 2 ^ a ∣ (3 ^ S_2 * X_2 - 2 ^ S_2 * Y_2) := by
    intro a
    constructor
    · intro hd
      have hm_dvd : 2 ^ a ∣ Acc_2 * (3 ^ S_1 * X_1 - 2 ^ S_1 * Y_1) := dvd_mul_of_dvd_right hd Acc_2
      rw [hsyz1] at hm_dvd
      exact (hcop2_1 a).dvd_of_dvd_mul_left hm_dvd
    · intro hd
      have hm_dvd : 2 ^ a ∣ Acc_1 * (3 ^ S_2 * X_2 - 2 ^ S_2 * Y_2) := dvd_mul_of_dvd_right hd Acc_1
      rw [← hsyz1] at hm_dvd
      exact (hcop2_2 a).dvd_of_dvd_mul_left hm_dvd
  have hdvd3_iff :
      ∀ b : ℕ, 3 ^ b ∣ (3 ^ S_1 * X_1 - 2 ^ S_1 * Y_1) ↔ 3 ^ b ∣ (3 ^ S_2 * X_2 - 2 ^ S_2 * Y_2) := by
    intro b
    constructor
    · intro hd
      have hm_dvd : 3 ^ b ∣ Acc_2 * (3 ^ S_1 * X_1 - 2 ^ S_1 * Y_1) := dvd_mul_of_dvd_right hd Acc_2
      rw [hsyz1] at hm_dvd
      exact (hcop3_1 b).dvd_of_dvd_mul_left hm_dvd
    · intro hd
      have hm_dvd : 3 ^ b ∣ Acc_1 * (3 ^ S_2 * X_2 - 2 ^ S_2 * Y_2) := dvd_mul_of_dvd_right hd Acc_1
      rw [← hsyz1] at hm_dvd
      exact (hcop3_2 b).dvd_of_dvd_mul_left hm_dvd
  -- Proof of 2059 : 2187 ratio bound:
  have hband1 := dense_core_accumulator_exponential_bands_and_cauchy_pinch.1 L_2 L_1 N hL1
  have hband2 := dense_core_accumulator_exponential_bands_and_cauchy_pinch.1 L_2' L_1' M hL1'
  have hS1_ge7 : 7 ≤ S_1 :=
    waveInteriorExp_ge_seven_of_L1_zero_pos L_2 L_1 (hL1 0 (Nat.zero_le N)) N
  have hp3_S1 : 3 ^ S_1 = 2187 * 3 ^ (S_1 - 7) := three_pow_eq_2187_mul_sub hS1_ge7
  have hup1 : 2059 * Acc_1 < 2187 * 3 ^ (S_1 - 7) := by
    have h := hband1.2.2; rw [hp3_S1] at h; exact h
  have hlow2 : 3 ^ (S_2 - 7) ≤ Acc_2 := hband2.1
  have hAcc2_pos : 1 ≤ Acc_2 := waveInteriorAcc_pos L_2' L_1' (hL1' 0 (Nat.zero_le M)) M
  have hratio :
      2059 * 3 ^ (S_2 - 7) * (3 ^ S_1 * X_1 - 2 ^ S_1 * Y_1) <
        2187 * 3 ^ (S_1 - 7) * (3 ^ S_2 * X_2 - 2 ^ S_2 * Y_2) := by
    rw [hsub1, hsub2]
    have hm_low :
        (2059 * Acc_1) * (19 * 3 ^ (S_2 - 7)) ≤ (2059 * Acc_1) * (19 * Acc_2) :=
      Nat.mul_le_mul_left (2059 * Acc_1) (Nat.mul_le_mul_left 19 hlow2)
    have hm_high :
        (2059 * Acc_1) * (19 * Acc_2) < (2187 * 3 ^ (S_1 - 7)) * (19 * Acc_2) :=
      Nat.mul_lt_mul_of_pos_right hup1 (by omega)
    have hlt_comb := lt_of_le_of_lt hm_low hm_high
    linarith only [hlt_comb]
  exact ⟨hsyz1, hsyz2, hdvd2_iff, hdvd3_iff, hratio⟩

/-!
## Section 113: Dual Single-`2`-Run Collision (`L_2(r_1) = L_2(r_2)` Independent of `L_1`) Archimedean Cutoff (`10 * (p + q) * L_2(r_1) + 11 * q < p * S̃_{r_2} + ...`)

Completing the exact dual of Section 104 for `U`-waves:
In Section 109, we proved that whenever two `U`-waves `r_1 < r_2` have the same `2`-run length
`L_2(r_1) = L_2(r_2)` (with **zero** restriction on any `1`-run `L_1`),
`(2,059 * 3^(10 * L_2(r_1))) ∣ (Ỹ(r_2 + 1) - Ỹ(r_1 + 1))` and `2^11 * 3^(10 * L_2(r_1)) < Ỹ(r_2 + 1)`.
Combining this lower bound at `M = r_2` with Section 60's dual master identity
`3^(S̃_M + 7*L_1(0)) * U(0) + 19 * Acc̃_M = 2^(S̃_M) * Ỹ(M + 1)` and Section 68's bound
`19 * Acc̃_M < 3^(S̃_M + 7*L_1(0))`:
1. Whenever `U(0) + 1 ≤ 2^U_0`, we have `2^(S̃_M) * Ỹ(M + 1) < 3^(S̃_M + 7*L_1(0)) * 2^U_0`.
2. Canceling `3^(10 * L_2(r_1))` directly against `3^(S̃_M + 7*L_1(0))` yields:
     `2^(S̃_M + 11) < 3^(S̃_M + 7*L_1(0) - 10*L_2(r_1)) * 2^U_0`,
   forcing for every `3^q ≤ 2^(p + q)` (`q ≥ 1`):
     `10 * (p + q) * L_2(r_1) + 11 * q < p * S̃_{r_2} + 7 * (p + q) * L_1(0) + q * U_0`
   (`270 * L_2(r_1) + 187 < 10 * S̃_{r_2} + 189 * L_1(0) + 17 * U_0` at `(p, q) = (10, 17)`)!
-/

/-- **Dual Single-`2`-Run Collision (`L_2(r_1) = L_2(r_2)` Independent of `L_1`) Archimedean Cutoff:**
Whenever `(2,059 * 3^E_2) ∣ (Ỹ(M+1) - Ỹ_a)` (`1 ≤ Ỹ_a < Ỹ(M+1)`, `E_2 ≤ S̃_M + 7*L_1(0)`) along a
dual `U`-wave orbit with `U(0) + 1 ≤ 2^U_0`, we have `2^(S̃_M + 11) < 3^(S̃_M + 7*L_1(0) - E_2) * 2^U_0`
and `(p + q) * E_2 + 11 * q < p * S̃_M + 7 * (p + q) * L_1(0) + q * U_0` for all `3^q ≤ 2^(p+q)`. -/
theorem dense_core_dual_single_two_run_collision_archimedean_cutoff
    {U L_1 L_2 : ℕ → ℕ} {M U_0 Y_a E_2 : ℕ}
    (hU0_lt : U 0 + 1 ≤ 2 ^ U_0)
    (hYa_pos : 1 ≤ Y_a) (hYa_lt : Y_a < scaledDualWaveY U L_1 (M + 1))
    (hL1_0 : 1 ≤ L_1 0)
    (hL2 : ∀ t ≤ M, 1 ≤ L_2 t)
    (hrec : ∀ n ≤ M,
      3 ^ (10 * L_2 n + 7 * L_1 n) * U n +
        19 * ((3 ^ (10 * L_2 n) - 2 ^ (10 * L_2 n)) / 58025) =
        2 ^ (10 * L_2 n + 7 * L_1 (n + 1)) * U (n + 1))
    (hE2_le : E_2 ≤ dualWaveInteriorExp L_1 L_2 M + 7 * L_1 0)
    (hdvd_Y : (2059 * 3 ^ E_2) ∣ (scaledDualWaveY U L_1 (M + 1) - Y_a)) :
    let S_M := dualWaveInteriorExp L_1 L_2 M
    2 ^ 11 * 3 ^ E_2 < scaledDualWaveY U L_1 (M + 1) ∧
    2 ^ (S_M + 11) < 3 ^ (S_M + 7 * L_1 0 - E_2) * 2 ^ U_0 ∧
    (∀ p q : ℕ, 1 ≤ q → 3 ^ q ≤ 2 ^ (p + q) →
      (p + q) * E_2 + 11 * q < p * S_M + 7 * (p + q) * L_1 0 + q * U_0) ∧
    27 * E_2 + 187 < 10 * S_M + 189 * L_1 0 + 17 * U_0 := by
  intro S_M
  have hm :=
    (dense_core_dual_one_run_multi_wave_master_identity_and_2059_super_divisibility.2.1
      U L_1 L_2 M hrec).1
  change 3 ^ S_M * (3 ^ (7 * L_1 0) * U 0) + 19 * dualWaveInteriorAcc L_1 L_2 M =
      2 ^ S_M * scaledDualWaveY U L_1 (M + 1) at hm
  have h68 :=
    (dense_core_universal_multi_wave_constant_of_motion_and_three_adic_remainders.2
      U L_1 L_2 M hL1_0 hL2 hrec).2.2.1
  change 6676911 * (19 * dualWaveInteriorAcc L_1 L_2 M) < 3 ^ (S_M + 7 * L_1 0) at h68
  have hp3_M : 3 ^ (S_M + 7 * L_1 0) * U 0 = 3 ^ S_M * (3 ^ (7 * L_1 0) * U 0) := by
    rw [Nat.pow_add]; ring
  have hup_U0 : 2 ^ S_M * scaledDualWaveY U L_1 (M + 1) < 3 ^ (S_M + 7 * L_1 0) * (U 0 + 1) := by
    have hd :
        3 ^ (S_M + 7 * L_1 0) * (U 0 + 1) =
          3 ^ (S_M + 7 * L_1 0) * U 0 + 3 ^ (S_M + 7 * L_1 0) := by ring
    linarith only [hm, h68, hp3_M, hd]
  have hup_2U0 : 2 ^ S_M * scaledDualWaveY U L_1 (M + 1) < 3 ^ (S_M + 7 * L_1 0) * 2 ^ U_0 :=
    lt_of_lt_of_le hup_U0 (Nat.mul_le_mul_left _ hU0_lt)
  rcases hdvd_Y with ⟨K, hK⟩
  have hK_pos : 1 ≤ K := by
    rcases Nat.eq_zero_or_pos K with rfl | hp
    · rw [Nat.mul_zero] at hK; omega
    · exact hp
  have hYM_ge : 2059 * 3 ^ E_2 + Y_a ≤ scaledDualWaveY U L_1 (M + 1) := by
    have h1 : 2059 * 3 ^ E_2 ≤ scaledDualWaveY U L_1 (M + 1) - Y_a := by
      rw [hK]; exact Nat.le_mul_of_pos_right _ hK_pos
    omega
  have h2_11_lt : 2 ^ 11 * 3 ^ E_2 < scaledDualWaveY U L_1 (M + 1) := by
    have h11 : (2 : ℕ) ^ 11 = 2048 := by decide
    rw [h11]
    have hp3_pos : 1 ≤ 3 ^ E_2 := Nat.pow_pos (by decide)
    omega
  have hcomb_lt :
      3 ^ E_2 * 2 ^ (S_M + 11) <
        3 ^ E_2 * (3 ^ (S_M + 7 * L_1 0 - E_2) * 2 ^ U_0) := by
    have hp_lhs : 3 ^ E_2 * 2 ^ (S_M + 11) = 2 ^ S_M * (2 ^ 11 * 3 ^ E_2) := by
      rw [Nat.pow_add 2 S_M 11]; ring
    set E_rem := S_M + 7 * L_1 0 - E_2
    have hexp : S_M + 7 * L_1 0 = E_2 + E_rem := by dsimp [E_rem]; omega
    have hp_rhs :
        3 ^ (S_M + 7 * L_1 0) * 2 ^ U_0 = 3 ^ E_2 * (3 ^ E_rem * 2 ^ U_0) := by
      calc 3 ^ (S_M + 7 * L_1 0) * 2 ^ U_0
          = (3 ^ E_2 * 3 ^ E_rem) * 2 ^ U_0 := by rw [hexp, Nat.pow_add]
        _ = 3 ^ E_2 * (3 ^ E_rem * 2 ^ U_0) := by ring
    rw [hp_lhs, ← hp_rhs]
    exact lt_trans (Nat.mul_lt_mul_of_pos_left h2_11_lt (Nat.pow_pos (by decide))) hup_2U0
  have hcancel_lt : 2 ^ (S_M + 11) < 3 ^ (S_M + 7 * L_1 0 - E_2) * 2 ^ U_0 := by
    refine Nat.lt_of_not_le (fun hge => ?_)
    have hm_ge := Nat.mul_le_mul_left (3 ^ E_2) hge
    linarith only [hcomb_lt, hm_ge]
  have hpq :
      ∀ p q : ℕ, 1 ≤ q → 3 ^ q ≤ 2 ^ (p + q) →
        (p + q) * E_2 + 11 * q < p * S_M + 7 * (p + q) * L_1 0 + q * U_0 := by
    intro p q hq hpq_le
    set E_lhs := S_M + 11
    set E_3 := S_M + 7 * L_1 0 - E_2
    have hpow_q : (2 ^ E_lhs) ^ q < (3 ^ E_3 * 2 ^ U_0) ^ q :=
      pow_lt_pow_of_lt hcancel_lt hq
    have h3_le : (3 ^ E_3) ^ q ≤ 2 ^ ((p + q) * E_3) := by
      calc (3 ^ E_3) ^ q
          = 3 ^ (E_3 * q) := (Nat.pow_mul 3 E_3 q).symm
        _ = 3 ^ (q * E_3) := by rw [Nat.mul_comm E_3 q]
        _ = (3 ^ q) ^ E_3 := Nat.pow_mul 3 q E_3
        _ ≤ (2 ^ (p + q)) ^ E_3 := Nat.pow_le_pow_left hpq_le E_3
        _ = 2 ^ ((p + q) * E_3) := (Nat.pow_mul 2 (p + q) E_3).symm
    have hrhs_le : (3 ^ E_3 * 2 ^ U_0) ^ q ≤ 2 ^ ((p + q) * E_3 + q * U_0) := by
      calc (3 ^ E_3 * 2 ^ U_0) ^ q
          = (3 ^ E_3) ^ q * (2 ^ U_0) ^ q := Nat.mul_pow (3 ^ E_3) (2 ^ U_0) q
        _ ≤ 2 ^ ((p + q) * E_3) * (2 ^ U_0) ^ q := Nat.mul_le_mul_right _ h3_le
        _ = 2 ^ ((p + q) * E_3) * 2 ^ (U_0 * q) := by rw [← Nat.pow_mul 2 U_0 q]
        _ = 2 ^ ((p + q) * E_3) * 2 ^ (q * U_0) := by rw [Nat.mul_comm U_0 q]
        _ = 2 ^ ((p + q) * E_3 + q * U_0) := (Nat.pow_add 2 _ _).symm
    have hlhs_eq : (2 ^ E_lhs) ^ q = 2 ^ (q * E_lhs) := by
      rw [← Nat.pow_mul 2 E_lhs q, Nat.mul_comm E_lhs q]
    have hpow2_lt : 2 ^ (q * E_lhs) < 2 ^ ((p + q) * E_3 + q * U_0) := by
      rw [← hlhs_eq]; exact lt_of_lt_of_le hpow_q hrhs_le
    have hexp_lt : q * E_lhs < (p + q) * E_3 + q * U_0 := by
      refine Nat.lt_of_not_le (fun hge => ?_)
      have hpow_ge : 2 ^ ((p + q) * E_3 + q * U_0) ≤ 2 ^ (q * E_lhs) :=
        Nat.pow_le_pow_right (by decide) hge
      omega
    have hE3_add : E_3 + E_2 = S_M + 7 * L_1 0 := by dsimp [E_3]; omega
    have hexp_rhs :
        (p + q) * E_3 + q * U_0 + (p + q) * E_2 =
          q * S_M + (p * S_M + 7 * (p + q) * L_1 0 + q * U_0) := by
      calc (p + q) * E_3 + q * U_0 + (p + q) * E_2
          = (p + q) * (E_3 + E_2) + q * U_0 := by ring
        _ = (p + q) * (S_M + 7 * L_1 0) + q * U_0 := by rw [hE3_add]
        _ = q * S_M + (p * S_M + 7 * (p + q) * L_1 0 + q * U_0) := by ring
    have hexp_lhs :
        q * E_lhs + (p + q) * E_2 =
          q * S_M + ((p + q) * E_2 + 11 * q) := by
      dsimp [E_lhs]; ring
    omega
  have h10_17 := hpq 10 17 (by decide) (by decide : 3 ^ 17 ≤ 2 ^ (10 + 17))
  exact ⟨h2_11_lt, hcancel_lt, hpq, by linarith only [h10_17]⟩

/-!
## Section 114: Opposite-Sign Additive Middle-Defect Cancellation & Unconditional Non-Vanishing `(2^E_mid, 3^E_mid)` Exponent Restoration

In Section 110, we subtracted the reduced syzygies of two anagram pairs whose middle defects had the
**same** sign (`2^(E_mid + E_suf) * q_Y + 41553 * q_A = 3^(S_K + E_mid) * q_X`), which required
`3^S_K1 * q_X1 < 3^S_K2 * q_X2` to guarantee non-vanishing after subtraction.
What happens when two anagram pairs have **opposite-sign** middle defects (for example, Pair 1 swaps
`A → B` so `Acc_1 ≤ Acc'_1`, while Pair 2 swaps `B → A` inside a different frame `(S_K2, E_suf2)` so
`Acc'_2 ≤ Acc_2`)?
- Pair 1: `2^(E_mid + E_suf1) * q_Y1 + 41553 * q_A = 3^(S_K1 + E_mid) * q_X1`
- Pair 2: `2^(E_mid + E_suf2) * q_Y2 = 3^(S_K2 + E_mid) * q_X2 + 41553 * q_A`
1. **Exact Homogeneous Additive Syzygy (`41,553 * q_A` Canceled by Addition!):**
     `2^E_mid * (2^E_suf1 * q_Y1 + 2^E_suf2 * q_Y2) = 3^E_mid * (3^S_K1 * q_X1 + 3^S_K2 * q_X2)`!
2. **Unconditional Non-Vanishing `(2^E_mid, 3^E_mid)` Restoration (With Zero Ordering Hypothesis!):**
   Because `q_X1, q_X2, q_Y1, q_Y2 ≥ 1` are positive, **their sum never vanishes**:
   - `2^E_mid ∣ (3^S_K1 * q_X1 + 3^S_K2 * q_X2)` and `3^E_mid ∣ (2^E_suf1 * q_Y1 + 2^E_suf2 * q_Y2)`;
   - When `S_K1 ≤ S_K2` and `E_suf1 ≤ E_suf2`:
       `2^(E_mid + E_suf1) ∣ (q_X1 + 3^(S_K2 - S_K1) * q_X2)`  and
       `3^(S_K1 + E_mid) ∣ (q_Y1 + 2^(E_suf2 - E_suf1) * q_Y2)`,
     forcing **`2^(E_mid + E_suf1) ≤ q_X1 + 3^(S_K2 - S_K1) * q_X2`** and
     **`3^(S_K1 + E_mid) ≤ q_Y1 + 2^(E_suf2 - E_suf1) * q_Y2` unconditionally!**
-/

/-- **Opposite-Sign Additive Middle-Defect Cancellation & Unconditional `(2^E_mid, 3^E_mid)` Restoration:**
Whenever Pair 1 (`+ 41553 * q_A` on LHS) and Pair 2 (`+ 41553 * q_A` on RHS) have opposite-sign
middle defects of the same magnitude `q_A`, adding their reduced syzygies cancels `41553 * q_A` and
restores `2^(E_mid + E_suf1) ≤ q_X1 + 3^(S_K2 - S_K1) * q_X2` and
`3^(S_K1 + E_mid) ≤ q_Y1 + 2^(E_suf2 - E_suf1) * q_Y2` with **zero** ordering hypothesis on `q_X` or `q_Y`. -/
theorem dense_core_opposite_sign_additive_middle_defect_cancellation
    {S_K1 S_K2 E_mid E_suf1 E_suf2 q_X1 q_X2 q_Y1 q_Y2 q_A : ℕ}
    (hsyz1 : 2 ^ (E_mid + E_suf1) * q_Y1 + 41553 * q_A = 3 ^ (S_K1 + E_mid) * q_X1)
    (hsyz2 : 2 ^ (E_mid + E_suf2) * q_Y2 = 3 ^ (S_K2 + E_mid) * q_X2 + 41553 * q_A) :
    -- 1. Exact homogeneous additive 4-window syzygy (41553 * q_A canceled by addition):
    2 ^ E_mid * (2 ^ E_suf1 * q_Y1 + 2 ^ E_suf2 * q_Y2) =
      3 ^ E_mid * (3 ^ S_K1 * q_X1 + 3 ^ S_K2 * q_X2) ∧
    -- 2. Full 2^E_mid and 3^E_mid divisibility of the positive sums:
    2 ^ E_mid ∣ (3 ^ S_K1 * q_X1 + 3 ^ S_K2 * q_X2) ∧
    3 ^ E_mid ∣ (2 ^ E_suf1 * q_Y1 + 2 ^ E_suf2 * q_Y2) ∧
    -- 3. Factored divisibilities and unconditional lower bounds when S_K1 ≤ S_K2, E_suf1 ≤ E_suf2:
    (S_K1 ≤ S_K2 → E_suf1 ≤ E_suf2 →
      2 ^ (E_mid + E_suf1) ∣ (q_X1 + 3 ^ (S_K2 - S_K1) * q_X2) ∧
      3 ^ (S_K1 + E_mid) ∣ (q_Y1 + 2 ^ (E_suf2 - E_suf1) * q_Y2) ∧
      (1 ≤ q_X1 → 2 ^ (E_mid + E_suf1) ≤ q_X1 + 3 ^ (S_K2 - S_K1) * q_X2) ∧
      (1 ≤ q_Y1 → 3 ^ (S_K1 + E_mid) ≤ q_Y1 + 2 ^ (E_suf2 - E_suf1) * q_Y2)) := by
  have hp2_1 : 2 ^ (E_mid + E_suf1) * q_Y1 = 2 ^ E_mid * (2 ^ E_suf1 * q_Y1) := by
    rw [Nat.pow_add]; ring
  have hp2_2 : 2 ^ (E_mid + E_suf2) * q_Y2 = 2 ^ E_mid * (2 ^ E_suf2 * q_Y2) := by
    rw [Nat.pow_add]; ring
  have hp3_1 : 3 ^ (S_K1 + E_mid) * q_X1 = 3 ^ E_mid * (3 ^ S_K1 * q_X1) := by
    rw [Nat.pow_add]; ring
  have hp3_2 : 3 ^ (S_K2 + E_mid) * q_X2 = 3 ^ E_mid * (3 ^ S_K2 * q_X2) := by
    rw [Nat.pow_add]; ring
  rw [hp2_1, hp3_1] at hsyz1
  rw [hp2_2, hp3_2] at hsyz2
  have hhom :
      2 ^ E_mid * (2 ^ E_suf1 * q_Y1 + 2 ^ E_suf2 * q_Y2) =
        3 ^ E_mid * (3 ^ S_K1 * q_X1 + 3 ^ S_K2 * q_X2) := by
    have hd1 :
        2 ^ E_mid * (2 ^ E_suf1 * q_Y1 + 2 ^ E_suf2 * q_Y2) =
          2 ^ E_mid * (2 ^ E_suf1 * q_Y1) + 2 ^ E_mid * (2 ^ E_suf2 * q_Y2) := by ring
    have hd2 :
        3 ^ E_mid * (3 ^ S_K1 * q_X1 + 3 ^ S_K2 * q_X2) =
          3 ^ E_mid * (3 ^ S_K1 * q_X1) + 3 ^ E_mid * (3 ^ S_K2 * q_X2) := by ring
    linarith only [hsyz1, hsyz2, hd1, hd2]
  have hcop : Nat.Coprime (2 ^ E_mid) (3 ^ E_mid) :=
    Nat.Coprime.pow _ _ (by decide : Nat.Coprime 2 3)
  have hd2 : 2 ^ E_mid ∣ (3 ^ S_K1 * q_X1 + 3 ^ S_K2 * q_X2) :=
    hcop.dvd_of_dvd_mul_left ⟨2 ^ E_suf1 * q_Y1 + 2 ^ E_suf2 * q_Y2, hhom.symm⟩
  have hd3 : 3 ^ E_mid ∣ (2 ^ E_suf1 * q_Y1 + 2 ^ E_suf2 * q_Y2) :=
    hcop.symm.dvd_of_dvd_mul_left ⟨3 ^ S_K1 * q_X1 + 3 ^ S_K2 * q_X2, hhom⟩
  refine ⟨hhom, hd2, hd3, ?_⟩
  intro hSK_le hEsuf_le
  have hp3_sum :
      3 ^ S_K1 * q_X1 + 3 ^ S_K2 * q_X2 =
        3 ^ S_K1 * (q_X1 + 3 ^ (S_K2 - S_K1) * q_X2) := by
    have hexp : S_K2 = S_K1 + (S_K2 - S_K1) := by omega
    calc 3 ^ S_K1 * q_X1 + 3 ^ S_K2 * q_X2
        = 3 ^ S_K1 * q_X1 + (3 ^ S_K1 * 3 ^ (S_K2 - S_K1)) * q_X2 := by
            rw [← Nat.pow_add, ← hexp]
      _ = 3 ^ S_K1 * (q_X1 + 3 ^ (S_K2 - S_K1) * q_X2) := by ring
  have hp2_sum :
      2 ^ E_suf1 * q_Y1 + 2 ^ E_suf2 * q_Y2 =
        2 ^ E_suf1 * (q_Y1 + 2 ^ (E_suf2 - E_suf1) * q_Y2) := by
    have hexp : E_suf2 = E_suf1 + (E_suf2 - E_suf1) := by omega
    calc 2 ^ E_suf1 * q_Y1 + 2 ^ E_suf2 * q_Y2
        = 2 ^ E_suf1 * q_Y1 + (2 ^ E_suf1 * 2 ^ (E_suf2 - E_suf1)) * q_Y2 := by
            rw [← Nat.pow_add, ← hexp]
      _ = 2 ^ E_suf1 * (q_Y1 + 2 ^ (E_suf2 - E_suf1) * q_Y2) := by ring
  have hhom_factored :
      2 ^ (E_mid + E_suf1) * (q_Y1 + 2 ^ (E_suf2 - E_suf1) * q_Y2) =
        3 ^ (S_K1 + E_mid) * (q_X1 + 3 ^ (S_K2 - S_K1) * q_X2) := by
    rw [Nat.pow_add 2 E_mid E_suf1, Nat.pow_add 3 S_K1 E_mid]
    have h := hhom
    rw [hp2_sum, hp3_sum] at h
    linarith only [h]
  have hcop_full : Nat.Coprime (2 ^ (E_mid + E_suf1)) (3 ^ (S_K1 + E_mid)) :=
    Nat.Coprime.pow _ _ (by decide : Nat.Coprime 2 3)
  have hd2_full : 2 ^ (E_mid + E_suf1) ∣ (q_X1 + 3 ^ (S_K2 - S_K1) * q_X2) :=
    hcop_full.dvd_of_dvd_mul_left ⟨q_Y1 + 2 ^ (E_suf2 - E_suf1) * q_Y2, hhom_factored.symm⟩
  have hd3_full : 3 ^ (S_K1 + E_mid) ∣ (q_Y1 + 2 ^ (E_suf2 - E_suf1) * q_Y2) :=
    hcop_full.symm.dvd_of_dvd_mul_left ⟨q_X1 + 3 ^ (S_K2 - S_K1) * q_X2, hhom_factored⟩
  refine ⟨hd2_full, hd3_full, ?_, ?_⟩
  · intro hqX1_pos
    rcases hd2_full with ⟨KX, hKX⟩
    have hKX_pos : 1 ≤ KX := by
      rcases Nat.eq_zero_or_pos KX with rfl | hp
      · rw [Nat.mul_zero] at hKX; omega
      · exact hp
    rw [hKX]; exact Nat.le_mul_of_pos_right _ hKX_pos
  · intro hqY1_pos
    rcases hd3_full with ⟨KY, hKY⟩
    have hKY_pos : 1 ≤ KY := by
      rcases Nat.eq_zero_or_pos KY with rfl | hp
      · rw [Nat.mul_zero] at hKY; omega
      · exact hp
    rw [hKY]; exact Nat.le_mul_of_pos_right _ hKY_pos

/-!
## Section 115: Sign-Blind Unified Four-Window Middle-Defect Dichotomy (`3^(S_K1 + E_mid) ≤ 2^(E_suf2 - E_suf1) * q_Y2 + q_Y1`)

Putting Section 110 (same-sign subtraction) and Section 114 (opposite-sign addition) together yields
a **completely sign-blind four-window theorem**:
Whenever two anagram pairs in frames `(S_K1, E_suf1)` and `(S_K2, E_suf2)` (`S_K1 ≤ S_K2`,
`E_suf1 ≤ E_suf2`, `3^S_K1 * q_X1 < 3^S_K2 * q_X2`) share the **same unsigned middle defect
magnitude `q_A`**—regardless of whether the two pairs have the same sign or opposite signs in
Section 106's disjunction:
  `2^(E_mid + E_suf) * q_Y + 41553 * q_A = 3^(S_K + E_mid) * q_X  ∨  2^(E_mid + E_suf) * q_Y = 3^(S_K + E_mid) * q_X + 41553 * q_A`,
we have **in all four sign combinations**:
  `2^(E_mid + E_suf1) ≤ 3^(S_K2 - S_K1) * q_X2 + q_X1`  and
  `3^(S_K1 + E_mid) ≤ 2^(E_suf2 - E_suf1) * q_Y2 + q_Y1`!
-/

/-- **Sign-Blind Unified Four-Window Middle-Defect Dichotomy:**
Whenever two anagram pairs share the same unsigned middle defect magnitude `q_A` (in any of the 4
sign combinations of Section 106's disjunction) with `S_K1 ≤ S_K2`, `E_suf1 ≤ E_suf2`,
`1 ≤ q_X1`, `1 ≤ q_Y1`, and `3^S_K1 * q_X1 < 3^S_K2 * q_X2`, we have unconditionally:
`2^(E_mid + E_suf1) ≤ 3^(S_K2 - S_K1) * q_X2 + q_X1` and
`3^(S_K1 + E_mid) ≤ 2^(E_suf2 - E_suf1) * q_Y2 + q_Y1`. -/
theorem dense_core_signed_middle_defect_unconditional_four_window_dichotomy
    {S_K1 S_K2 E_mid E_suf1 E_suf2 q_X1 q_X2 q_Y1 q_Y2 q_A : ℕ}
    (hSK_le : S_K1 ≤ S_K2) (hEsuf_le : E_suf1 ≤ E_suf2)
    (hqX1_pos : 1 ≤ q_X1) (hqY1_pos : 1 ≤ q_Y1)
    (hlt : 3 ^ S_K1 * q_X1 < 3 ^ S_K2 * q_X2)
    (h1 : 2 ^ (E_mid + E_suf1) * q_Y1 + 41553 * q_A = 3 ^ (S_K1 + E_mid) * q_X1 ∨
          2 ^ (E_mid + E_suf1) * q_Y1 = 3 ^ (S_K1 + E_mid) * q_X1 + 41553 * q_A)
    (h2 : 2 ^ (E_mid + E_suf2) * q_Y2 + 41553 * q_A = 3 ^ (S_K2 + E_mid) * q_X2 ∨
          2 ^ (E_mid + E_suf2) * q_Y2 = 3 ^ (S_K2 + E_mid) * q_X2 + 41553 * q_A) :
    (3 ^ (S_K1 + E_mid) ∣ (2 ^ (E_suf2 - E_suf1) * q_Y2 - q_Y1) ∨
     3 ^ (S_K1 + E_mid) ∣ (q_Y1 + 2 ^ (E_suf2 - E_suf1) * q_Y2)) ∧
    2 ^ (E_mid + E_suf1) ≤ 3 ^ (S_K2 - S_K1) * q_X2 + q_X1 ∧
    3 ^ (S_K1 + E_mid) ≤ 2 ^ (E_suf2 - E_suf1) * q_Y2 + q_Y1 := by
  rcases h1 with h1_l | h1_r <;> rcases h2 with h2_l | h2_r
  · -- Case (+, +): Section 110 directly
    have h110 :=
      (dense_core_four_window_middle_defect_cancellation_and_full_exponent_restoration
        h1_l h2_l (le_of_lt hlt)).2.2.2.2 hSK_le hEsuf_le
    have hbounds := h110.2.2 hqX1_pos hqY1_pos hlt
    exact ⟨Or.inl h110.2.1, by omega, by omega⟩
  · -- Case (+, -): Section 114 directly
    have h114 :=
      (dense_core_opposite_sign_additive_middle_defect_cancellation h1_l h2_r).2.2.2
        hSK_le hEsuf_le
    have hbX := h114.2.2.1 hqX1_pos
    have hbY := h114.2.2.2 hqY1_pos
    exact ⟨Or.inr h114.2.1, by omega, by omega⟩
  · -- Case (-, +): Section 114 with Pair 2 and Pair 1 swapped in hsyz
    have hsyz1' : 2 ^ (E_mid + E_suf1) * q_Y1 = 3 ^ (S_K1 + E_mid) * q_X1 + 41553 * q_A := h1_r
    have hsyz2' : 2 ^ (E_mid + E_suf2) * q_Y2 + 41553 * q_A = 3 ^ (S_K2 + E_mid) * q_X2 := h2_l
    have hp2_1 : 2 ^ (E_mid + E_suf1) * q_Y1 = 2 ^ E_mid * (2 ^ E_suf1 * q_Y1) := by
      rw [Nat.pow_add]; ring
    have hp2_2 : 2 ^ (E_mid + E_suf2) * q_Y2 = 2 ^ E_mid * (2 ^ E_suf2 * q_Y2) := by
      rw [Nat.pow_add]; ring
    have hp3_1 : 3 ^ (S_K1 + E_mid) * q_X1 = 3 ^ E_mid * (3 ^ S_K1 * q_X1) := by
      rw [Nat.pow_add]; ring
    have hp3_2 : 3 ^ (S_K2 + E_mid) * q_X2 = 3 ^ E_mid * (3 ^ S_K2 * q_X2) := by
      rw [Nat.pow_add]; ring
    have h1_swap : 2 ^ (E_mid + E_suf1) * q_Y1 + 41553 * 0 = 3 ^ (S_K1 + E_mid) * q_X1 + 41553 * q_A := by
      omega
    -- Notice that adding h1_r and h2_l gives the exact same additive equation as Section 114!
    have hhom_factored :
        2 ^ (E_mid + E_suf1) * (q_Y1 + 2 ^ (E_suf2 - E_suf1) * q_Y2) =
          3 ^ (S_K1 + E_mid) * (q_X1 + 3 ^ (S_K2 - S_K1) * q_X2) := by
      have hexp3 : S_K2 = S_K1 + (S_K2 - S_K1) := by omega
      have hexp2 : E_suf2 = E_suf1 + (E_suf2 - E_suf1) := by omega
      have hs3 :
          3 ^ (S_K1 + E_mid) * q_X1 + 3 ^ (S_K2 + E_mid) * q_X2 =
            3 ^ (S_K1 + E_mid) * (q_X1 + 3 ^ (S_K2 - S_K1) * q_X2) := by
        have h : S_K2 + E_mid = (S_K1 + E_mid) + (S_K2 - S_K1) := by omega
        rw [h, Nat.pow_add 3 (S_K1 + E_mid) (S_K2 - S_K1)]; ring
      have hs2 :
          2 ^ (E_mid + E_suf1) * q_Y1 + 2 ^ (E_mid + E_suf2) * q_Y2 =
            2 ^ (E_mid + E_suf1) * (q_Y1 + 2 ^ (E_suf2 - E_suf1) * q_Y2) := by
        have h : E_mid + E_suf2 = (E_mid + E_suf1) + (E_suf2 - E_suf1) := by omega
        rw [h, Nat.pow_add 2 (E_mid + E_suf1) (E_suf2 - E_suf1)]; ring
      linarith only [h1_r, h2_l, hs3, hs2]
    have hcop_full : Nat.Coprime (2 ^ (E_mid + E_suf1)) (3 ^ (S_K1 + E_mid)) :=
      Nat.Coprime.pow _ _ (by decide : Nat.Coprime 2 3)
    have hd2_full : 2 ^ (E_mid + E_suf1) ∣ (q_X1 + 3 ^ (S_K2 - S_K1) * q_X2) :=
      hcop_full.dvd_of_dvd_mul_left ⟨q_Y1 + 2 ^ (E_suf2 - E_suf1) * q_Y2, hhom_factored.symm⟩
    have hd3_full : 3 ^ (S_K1 + E_mid) ∣ (q_Y1 + 2 ^ (E_suf2 - E_suf1) * q_Y2) :=
      hcop_full.symm.dvd_of_dvd_mul_left ⟨q_X1 + 3 ^ (S_K2 - S_K1) * q_X2, hhom_factored⟩
    rcases hd2_full with ⟨KX, hKX⟩
    have hKX_pos : 1 ≤ KX := by
      rcases Nat.eq_zero_or_pos KX with rfl | hp
      · rw [Nat.mul_zero] at hKX; omega
      · exact hp
    have hbX : 2 ^ (E_mid + E_suf1) ≤ q_X1 + 3 ^ (S_K2 - S_K1) * q_X2 := by
      rw [hKX]; exact Nat.le_mul_of_pos_right _ hKX_pos
    rcases hd3_full with ⟨KY, hKY⟩
    have hKY_pos : 1 ≤ KY := by
      rcases Nat.eq_zero_or_pos KY with rfl | hp
      · rw [Nat.mul_zero] at hKY; omega
      · exact hp
    have hbY : 3 ^ (S_K1 + E_mid) ≤ q_Y1 + 2 ^ (E_suf2 - E_suf1) * q_Y2 := by
      rw [hKY]; exact Nat.le_mul_of_pos_right _ hKY_pos
    exact ⟨Or.inr ⟨KY, hKY⟩, by omega, by omega⟩
  · -- Case (-, -): Subtracting h1_r from h2_r gives the exact same difference equation as Section 110!
    have hs3 :
        3 ^ (S_K2 + E_mid) * q_X2 - 3 ^ (S_K1 + E_mid) * q_X1 =
          3 ^ (S_K1 + E_mid) * (3 ^ (S_K2 - S_K1) * q_X2 - q_X1) := by
      have h : S_K2 + E_mid = (S_K1 + E_mid) + (S_K2 - S_K1) := by omega
      have hsplit :
          3 ^ (S_K2 + E_mid) * q_X2 =
            3 ^ (S_K1 + E_mid) * (3 ^ (S_K2 - S_K1) * q_X2) := by
        rw [h, Nat.pow_add 3 (S_K1 + E_mid) (S_K2 - S_K1)]; ring
      rw [hsplit, ← Nat.mul_sub_left_distrib]
    have hY_gt : 2 ^ (E_mid + E_suf1) * q_Y1 < 2 ^ (E_mid + E_suf2) * q_Y2 := by
      have hm_lt :
          3 ^ E_mid * (3 ^ S_K1 * q_X1) < 3 ^ E_mid * (3 ^ S_K2 * q_X2) :=
        Nat.mul_lt_mul_of_pos_left hlt (Nat.pow_pos (by decide))
      have hp3_1 : 3 ^ (S_K1 + E_mid) * q_X1 = 3 ^ E_mid * (3 ^ S_K1 * q_X1) := by
        rw [Nat.pow_add]; ring
      have hp3_2 : 3 ^ (S_K2 + E_mid) * q_X2 = 3 ^ E_mid * (3 ^ S_K2 * q_X2) := by
        rw [Nat.pow_add]; ring
      linarith only [h1_r, h2_r, hm_lt, hp3_1, hp3_2]
    have hs2 :
        2 ^ (E_mid + E_suf2) * q_Y2 - 2 ^ (E_mid + E_suf1) * q_Y1 =
          2 ^ (E_mid + E_suf1) * (2 ^ (E_suf2 - E_suf1) * q_Y2 - q_Y1) := by
      have h : E_mid + E_suf2 = (E_mid + E_suf1) + (E_suf2 - E_suf1) := by omega
      have hsplit :
          2 ^ (E_mid + E_suf2) * q_Y2 =
            2 ^ (E_mid + E_suf1) * (2 ^ (E_suf2 - E_suf1) * q_Y2) := by
        rw [h, Nat.pow_add 2 (E_mid + E_suf1) (E_suf2 - E_suf1)]; ring
      rw [hsplit, ← Nat.mul_sub_left_distrib]
    have hhom_factored :
        2 ^ (E_mid + E_suf1) * (2 ^ (E_suf2 - E_suf1) * q_Y2 - q_Y1) =
          3 ^ (S_K1 + E_mid) * (3 ^ (S_K2 - S_K1) * q_X2 - q_X1) := by
      have hdiff :
          2 ^ (E_mid + E_suf2) * q_Y2 - 2 ^ (E_mid + E_suf1) * q_Y1 =
            3 ^ (S_K2 + E_mid) * q_X2 - 3 ^ (S_K1 + E_mid) * q_X1 := by omega
      rw [← hs2, ← hs3]; exact hdiff
    have hcop_full : Nat.Coprime (2 ^ (E_mid + E_suf1)) (3 ^ (S_K1 + E_mid)) :=
      Nat.Coprime.pow _ _ (by decide : Nat.Coprime 2 3)
    have hd2_full : 2 ^ (E_mid + E_suf1) ∣ (3 ^ (S_K2 - S_K1) * q_X2 - q_X1) :=
      hcop_full.dvd_of_dvd_mul_left ⟨2 ^ (E_suf2 - E_suf1) * q_Y2 - q_Y1, hhom_factored.symm⟩
    have hd3_full : 3 ^ (S_K1 + E_mid) ∣ (2 ^ (E_suf2 - E_suf1) * q_Y2 - q_Y1) :=
      hcop_full.symm.dvd_of_dvd_mul_left ⟨3 ^ (S_K2 - S_K1) * q_X2 - q_X1, hhom_factored⟩
    have hY_sub_pos : 1 ≤ 2 ^ (E_suf2 - E_suf1) * q_Y2 - q_Y1 := by
      refine Nat.pos_of_ne_zero (fun h0 => ?_)
      rw [h0, Nat.mul_zero] at hs2
      omega
    have hX_sub_pos : 1 ≤ 3 ^ (S_K2 - S_K1) * q_X2 - q_X1 := by
      refine Nat.pos_of_ne_zero (fun h0 => ?_)
      rw [h0, Nat.mul_zero] at hhom_factored
      have hp2_pos : 1 ≤ 2 ^ (E_mid + E_suf1) := Nat.pow_pos (by decide)
      have hm_pos : 1 ≤ 2 ^ (E_mid + E_suf1) * (2 ^ (E_suf2 - E_suf1) * q_Y2 - q_Y1) :=
        Nat.mul_pos hp2_pos hY_sub_pos
      linarith only [hhom_factored, hm_pos]
    rcases hd2_full with ⟨KX, hKX⟩
    have hKX_pos : 1 ≤ KX := by
      rcases Nat.eq_zero_or_pos KX with rfl | hp
      · rw [Nat.mul_zero] at hKX; linarith only [hKX, hX_sub_pos]
      · exact hp
    have hbX : 2 ^ (E_mid + E_suf1) ≤ 3 ^ (S_K2 - S_K1) * q_X2 - q_X1 := by
      rw [hKX]; exact Nat.le_mul_of_pos_right _ hKX_pos
    rcases hd3_full with ⟨KY, hKY⟩
    have hKY_pos : 1 ≤ KY := by
      rcases Nat.eq_zero_or_pos KY with rfl | hp
      · rw [Nat.mul_zero] at hKY; linarith only [hKY, hY_sub_pos]
      · exact hp
    have hbY : 3 ^ (S_K1 + E_mid) ≤ 2 ^ (E_suf2 - E_suf1) * q_Y2 - q_Y1 := by
      rw [hKY]; exact Nat.le_mul_of_pos_right _ hKY_pos
    exact ⟨Or.inl ⟨KY, hKY⟩, by omega, by omega⟩

/-!
## Section 116: Frame-Independent Middle-Defect Palette Pigeonhole Cutoff Across `C + 1` Arbitrary Prefix/Suffix Frames

In Section 107, we applied Pigeonhole to `C + 1` windows that shared the **same** prefix and suffix.
Combining Sections 110 and 111 with Pigeonhole yields a **frame-independent** theorem:
Suppose `C + 1` anagram pairs indexed by `i : Fin (C + 1)`—each in its own **distinct prefix/suffix
frame** `(S_K(i), E_suf(i))` with middle step-sum `E_mid`—draw their middle defect `q_A(i)` from a
palette of at most `C` values (`defectIdx : Fin (C + 1) → Fin C` such that `defectIdx i = defectIdx j → q_A i = q_A j`).
Then there exist `i < j` in `Fin (C + 1)` with `q_A(i) = q_A(j)`, restoring the full
`2^(E_mid + E_suf(i))` and `3^(S_K(i) + E_mid)` divisors and forcing Section 111's full-weight
cutoff `(p + q) * (S_K(i) + E_mid) + p * E_suf(j) + q * E_suf(i) + 15 * q < p * S_M + ...`!
-/

/-- **Frame-Independent Middle-Defect Palette Pigeonhole Cutoff Across `C + 1` Arbitrary Frames:**
Whenever `C + 1` anagram pairs in arbitrary monotone frames `(S_K i, E_suf i)` draw their middle
defects `q_A i` from a palette of size `≤ C`, at least two pairs `i < j` collide in `q_A`, restoring
`3^(S_K i + E_mid) < 2^(E_suf j - E_suf i) * q_Y j` and forcing the full `(p + q) * (S_K i + E_mid)`
Archimedean cutoff. -/
theorem dense_core_frame_independent_middle_defect_palette_pigeonhole_cutoff
    {W L_2 L_1 : ℕ → ℕ} {C E_mid W_0 : ℕ}
    (S_K E_suf q_X q_Y q_A M_end : Fin (C + 1) → ℕ)
    (defectIdx : Fin (C + 1) → Fin C)
    (hW0_lt : W 0 < 2 ^ W_0)
    (hL1_0 : 1 ≤ L_1 0)
    (hrec : ∀ n : ℕ,
      2 ^ (7 * L_1 n + 10 * L_2 (n + 1)) * W (n + 1) +
        19 * ((3 ^ (7 * L_1 n) - 2 ^ (7 * L_1 n)) / 2059) =
        3 ^ (10 * L_2 n + 7 * L_1 n) * W n)
    (hSK_mono : Monotone S_K)
    (hEsuf_mono : Monotone E_suf)
    (hX_strict : StrictMono (fun i => 3 ^ (S_K i) * q_X i))
    (hqX_pos : ∀ i, 1 ≤ q_X i)
    (hqY_pos : ∀ i, 1 ≤ q_Y i)
    (hsyz : ∀ i,
      2 ^ (E_mid + E_suf i) * q_Y i + 41553 * q_A i = 3 ^ (S_K i + E_mid) * q_X i)
    (hY_bound : ∀ i, 58025 * 3 ^ (E_suf i) * q_Y i ≤ scaledWaveY W L_2 (M_end i + 1))
    (hsum_le : ∀ i j, i < j →
      S_K i + E_mid + E_suf j ≤ waveInteriorExp L_2 L_1 (M_end j) + 10 * L_2 0)
    (hpalette : ∀ i j, defectIdx i = defectIdx j → q_A i = q_A j) :
    ∃ i j : Fin (C + 1),
      i < j ∧
      q_A i = q_A j ∧
      2 ^ (E_mid + E_suf i) < 3 ^ (S_K j - S_K i) * q_X j ∧
      3 ^ (S_K i + E_mid) < 2 ^ (E_suf j - E_suf i) * q_Y j ∧
      (∀ p q : ℕ, 1 ≤ q → 3 ^ q ≤ 2 ^ (p + q) →
        (p + q) * (S_K i + E_mid) + p * E_suf j + q * E_suf i + 15 * q <
          p * waveInteriorExp L_2 L_1 (M_end j) + 10 * (p + q) * L_2 0 + q * W_0) ∧
      27 * (S_K i + E_mid) + 10 * E_suf j + 17 * E_suf i + 255 <
        10 * waveInteriorExp L_2 L_1 (M_end j) + 270 * L_2 0 + 17 * W_0 := by
  have hnot_inj : ¬Function.Injective defectIdx := by
    intro hinj
    have hcard := Fintype.card_le_of_injective defectIdx hinj
    simp only [Fintype.card_fin] at hcard
    omega
  rw [Function.Injective] at hnot_inj
  push_neg at hnot_inj
  rcases hnot_inj with ⟨a, b, hab_eq, hab_ne⟩
  have hij_ex : ∃ i j : Fin (C + 1), i < j ∧ defectIdx i = defectIdx j := by
    rcases lt_trichotomy a b with hlt | rfl | hgt
    · exact ⟨a, b, hlt, hab_eq⟩
    · exact absurd rfl hab_ne
    · exact ⟨b, a, hgt, hab_eq.symm⟩
  rcases hij_ex with ⟨i, j, hij, hdef_eq⟩
  have hqA_eq : q_A i = q_A j := hpalette i j hdef_eq
  have hsyz_i := hsyz i
  have hsyz_j := hsyz j
  rw [← hqA_eq] at hsyz_j
  have hSK_ij : S_K i ≤ S_K j := hSK_mono (le_of_lt hij)
  have hEsuf_ij : E_suf i ≤ E_suf j := hEsuf_mono (le_of_lt hij)
  have hX_lt : 3 ^ (S_K i) * q_X i < 3 ^ (S_K j) * q_X j := hX_strict hij
  have h110 :=
    ((dense_core_four_window_middle_defect_cancellation_and_full_exponent_restoration
      hsyz_i hsyz_j (le_of_lt hX_lt)).2.2.2.2 hSK_ij hEsuf_ij).2.2
      (hqX_pos i) (hqY_pos i) hX_lt
  have h111 :=
    dense_core_four_window_middle_cancellation_archimedean_cutoff
      hW0_lt hL1_0 (fun n _ => hrec n) hEsuf_ij (hsum_le i j hij) h110.2 (hY_bound j)
  exact ⟨i, j, hij, hqA_eq, h110.1, h110.2, h111.2.2.1, h111.2.2.2⟩

/-!
## Section 117: Bounded-Run Abelian Step-Sum Linear Corridor (`17*N + 7 ≤ S_N ≤ (17*N + 7)*B`) & Mandatory Pigeonhole Anagram Existence Under Arbitrary Subword Complexity

Why must macro-wave anagrams (`S^{(r_1)}_N = S^{(r_2)}_N`) occur at a **linear horizon** `O(N)` in any
bounded-run trajectory (`1 ≤ L_1(t), L_2(t) ≤ B`), **even if its ordered subword complexity `p(N)` is
exponential (`B^(2N + 1)`)**?
1. **Universal Two-Sided Linear Step-Sum Band (`17*N + 7 ≤ S_N ≤ (17*N + 7)*B`):**
   By induction on `N ∈ ℕ`, whenever `1 ≤ L_1(t) ≤ B` (`t ≤ N`) and `1 ≤ L_2(t + 1) ≤ B` (`t < N`):
     `17 * N + 7 ≤ waveInteriorExp L_2 L_1 N ≤ (17 * N + 7) * B`!
2. **Mandatory Pigeonhole Anagram Existence Within `(17 * N + 7) * (B - 1) + 2` Windows:**
   Consequently, for any `(17 * N + 7) * (B - 1) + 2` window positions `r(0) < r(1) < ... < r(C)`
   (`C = (17 * N + 7) * (B - 1) + 1`), the normalized step-sum `S^{(r(i))}_N - (17 * N + 7)` lies in
   `Fin ((17 * N + 7) * (B - 1) + 1)`. By the Pigeonhole Principle, **there ALWAYS exist two windows
   `i < j` with the exact same interior step-sum `S^{(r(i))}_N = S^{(r(j))}_N`** (forming an exact
   macro-wave anagram), **regardless of how high the ordered subword complexity of the orbit is!**
-/

private lemma waveInteriorExp_le_seventeen_mul_add_seven_mul
    (L_2 L_1 : ℕ → ℕ) (N B : ℕ)
    (hL1_B : ∀ t ≤ N, L_1 t ≤ B)
    (hL2_B : ∀ t < N, L_2 (t + 1) ≤ B) :
    waveInteriorExp L_2 L_1 N ≤ (17 * N + 7) * B := by
  induction N with
  | zero =>
      simp only [waveInteriorExp, Nat.mul_zero, Nat.zero_add]
      exact Nat.mul_le_mul_left 7 (hL1_B 0 (Nat.le_refl 0))
  | succ k ih =>
      have ih_k := ih (fun t ht => hL1_B t (Nat.le_succ_of_le ht))
        (fun t ht => hL2_B t (Nat.lt_succ_of_lt ht))
      have hL1_k1 : L_1 (k + 1) ≤ B := hL1_B (k + 1) (Nat.le_refl _)
      have hL2_k1 : L_2 (k + 1) ≤ B := hL2_B k (Nat.lt_succ_self k)
      change waveInteriorExp L_2 L_1 k + (10 * L_2 (k + 1) + 7 * L_1 (k + 1)) ≤
        (17 * (k + 1) + 7) * B
      have hstep : 10 * L_2 (k + 1) + 7 * L_1 (k + 1) ≤ 17 * B := by omega
      have hdist : (17 * (k + 1) + 7) * B = (17 * k + 7) * B + 17 * B := by ring
      omega

/-- **Bounded-Run Abelian Step-Sum Linear Corridor & Mandatory Pigeonhole Anagram Existence:**
1. Every `(N + 1)`-wave block with interior runs in `[1, B]` satisfies
   `17 * N + 7 ≤ waveInteriorExp L_2 L_1 N ≤ (17 * N + 7) * B`.
2. Among any `(17 * N + 7) * (B - 1) + 2` windows `r(0) < ... < r(C)` along a bounded-run sequence,
   there always exist `i < j` with identical interior step-sums `S^{(r(i))}_N = S^{(r(j))}_N`. -/
theorem dense_core_bounded_run_abelian_step_sum_pigeonhole_anagram_existence :
    -- 1. Universal two-sided linear step-sum corridor for bounded runs in [1, B]:
    (∀ (L_2 L_1 : ℕ → ℕ) (N B : ℕ),
      (∀ t ≤ N, 1 ≤ L_1 t) →
      (∀ t < N, 1 ≤ L_2 (t + 1)) →
      (∀ t ≤ N, L_1 t ≤ B) →
      (∀ t < N, L_2 (t + 1) ≤ B) →
      17 * N + 7 ≤ waveInteriorExp L_2 L_1 N ∧
      waveInteriorExp L_2 L_1 N ≤ (17 * N + 7) * B) ∧
    -- 2. Mandatory Pigeonhole anagram existence among any (17*N + 7)*(B - 1) + 2 windows:
    (∀ (L_2 L_1 : ℕ → ℕ) (N B : ℕ)
       (r : Fin ((17 * N + 7) * (B - 1) + 2) → ℕ),
      1 ≤ B →
      (∀ n : ℕ, 1 ≤ L_1 n ∧ L_1 n ≤ B) →
      (∀ n : ℕ, 1 ≤ L_2 n ∧ L_2 n ≤ B) →
      ∃ i j : Fin ((17 * N + 7) * (B - 1) + 2),
        i < j ∧
        waveInteriorExp (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) N =
          waveInteriorExp (fun t => L_2 (r j + t)) (fun t => L_1 (r j + t)) N) := by
  refine ⟨fun L_2 L_1 N B h1 h2 h3 h4 =>
    ⟨waveInteriorExp_ge_seventeen_mul_add_seven L_2 L_1 N h1 h2,
     waveInteriorExp_le_seventeen_mul_add_seven_mul L_2 L_1 N B h3 h4⟩, ?_⟩
  intro L_2 L_1 N B r hB hL1 hL2
  set C := (17 * N + 7) * (B - 1) + 1
  have hband :
      ∀ i : Fin (C + 1),
        17 * N + 7 ≤ waveInteriorExp (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) N ∧
        waveInteriorExp (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) N ≤ (17 * N + 7) * B := by
    intro i
    exact ⟨waveInteriorExp_ge_seventeen_mul_add_seven _ _ N
      (fun t _ => (hL1 (r i + t)).1) (fun t _ => (hL2 (r i + (t + 1))).1),
      waveInteriorExp_le_seventeen_mul_add_seven_mul _ _ N B
      (fun t _ => (hL1 (r i + t)).2) (fun t _ => (hL2 (r i + (t + 1))).2)⟩
  let stepIdx : Fin (C + 1) → Fin C := fun i =>
    ⟨waveInteriorExp (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) N - (17 * N + 7), by
      have hi := hband i
      have hB_sub : (17 * N + 7) * B - (17 * N + 7) = (17 * N + 7) * (B - 1) := by
        have h1 : B = (B - 1) + 1 := by omega
        calc (17 * N + 7) * B - (17 * N + 7)
            = (17 * N + 7) * ((B - 1) + 1) - (17 * N + 7) := by rw [← h1]
          _ = (17 * N + 7) * (B - 1) + (17 * N + 7) - (17 * N + 7) := by ring_nf
          _ = (17 * N + 7) * (B - 1) := Nat.add_sub_cancel _ _
      dsimp [C]
      omega⟩
  have hnot_inj : ¬Function.Injective stepIdx := by
    intro hinj
    have hcard := Fintype.card_le_of_injective stepIdx hinj
    simp only [Fintype.card_fin] at hcard
    omega
  rw [Function.Injective] at hnot_inj
  push_neg at hnot_inj
  rcases hnot_inj with ⟨a, b, hab_eq, hab_ne⟩
  have hij_ex : ∃ i j : Fin (C + 1), i < j ∧ stepIdx i = stepIdx j := by
    rcases lt_trichotomy a b with hlt | rfl | hgt
    · exact ⟨a, b, hlt, hab_eq⟩
    · exact absurd rfl hab_ne
    · exact ⟨b, a, hgt, hab_eq.symm⟩
  rcases hij_ex with ⟨i, j, hij, hstep_eq⟩
  have hval_eq : (stepIdx i).1 = (stepIdx j).1 := congrArg Fin.val hstep_eq
  dsimp [stepIdx] at hval_eq
  have hi := (hband i).1
  have hj := (hband j).1
  exact ⟨i, j, hij, by omega⟩

/-!
## Section 118: Internal Junction Bidirectional Anagram Sieve & Homogeneous Defect-Free Junction Syzygy (`(58,025 * 2^(S_{K,2}) * 3^(E_{suf,1})) ∣ (W(m') - W(m))`)

Why was a single block's middle divergence `E_mid` able to separate the prefix `S_K` from the suffix
`E_suf` in Sections 91 and 106? Because inside a single block, `S_K` acts on the start node `0` while
`E_suf` acts on the end node `end`, with the divergent middle sitting **between** them.
Now consider the **internal junction** `(m, m')` between a left anagram pair (Block 1, ending at
`(m, m')` with shared suffix step-sum `E_suf1`) and a right anagram pair (Block 2, starting at
`(m, m')` with shared prefix step-sum `S_K2`):
- Block 1's suffix `E_suf1` sits immediately to the **left** of `(m, m')`, delivering
  `58025 * 3 ^ E_suf1 ∣ (Y(m') - Y(m))` directly to `(m, m')` (`Y(m') - Y(m) = 58025 * 3 ^ E_suf1 * q_Y`)!
- Block 2's prefix `S_K2` sits immediately to the **right** of `(m, m')`, delivering
  `58025 * 2 ^ S_K2 ∣ (X(m') - X(m))` directly to the **same** junction `(m, m')`
  (`X(m') - X(m) = 58025 * 2 ^ S_K2 * q_X`)!
There is **no divergent middle between Block 1's suffix and Block 2's prefix**—they meet head-on at
the single junction `(m, m')`!
1. **Unconditional Lower-Run Factor Extraction (`L_2(m) ≤ L_2(m')`):**
   Even when `L_2(m) < L_2(m')`, since `X(m') - X(m) = 3^(10*L_2(m)) * (3^(10*ΔL) * W(m') - W(m))`
   and `Y(m') - Y(m) = 2^(10*L_2(m)) * (2^(10*ΔL) * W(m') - W(m))`, coprimality gives:
   - `(58025 * 2 ^ S_K2 * 3 ^ (10 * L_2 m)) ∣ (X(m') - X(m))`,
   - `(58025 * 2 ^ (10 * L_2 m) * 3 ^ E_suf1) ∣ (Y(m') - Y(m))`.
2. **Matching Junction `2`-Run (`L_2(m) = L_2(m')`) — Homogeneous Defect-Free Junction Syzygy & Product Divisibility:**
   When `L_2(m) = L_2(m')`, `2^(10*L_2(m)) * (X(m') - X(m)) = 3^(10*L_2(m)) * (Y(m') - Y(m))` holds
   with **zero middle-defect term**, yielding:
     `2 ^ (10 * L_2 m + S_K2) * q_X = 3 ^ (10 * L_2 m + E_suf1) * q_Y`,
   forcing `W(m) < W(m')` strictly and the **multiplicative product divisibility** on the single
   state difference `W(m') - W(m)`:
     `(58025 * 2 ^ S_K2 * 3 ^ E_suf1) ∣ (W(m') - W(m))` and
     `58025 * 2 ^ S_K2 * 3 ^ E_suf1 ≤ W(m') - W(m) < W(m')`!
-/

/-- **Internal Junction Bidirectional Anagram Sieve & Product Divisibility:**
At any internal junction `(m, m')` where the left anagram supplies `(58025 * 3 ^ E_suf1) ∣ (Y(m') - Y(m))`
and the right anagram supplies `(58025 * 2 ^ S_K2) ∣ (X(m') - X(m))`:
1. Whenever `L_2(m) ≤ L_2(m')`, `(58025 * 2 ^ S_K2 * 3 ^ (10 * L_2 m)) ∣ (X(m') - X(m))` and
   `(58025 * 2 ^ (10 * L_2 m) * 3 ^ E_suf1) ∣ (Y(m') - Y(m))`.
2. Whenever `L_2(m) = L_2(m')`, `(58025 * 2 ^ S_K2 * 3 ^ E_suf1) ∣ (W(m') - W(m))`, and if
   `X(m) < X(m')` then `W(m) < W(m')` and `58025 * 2 ^ S_K2 * 3 ^ E_suf1 ≤ W(m') - W(m) < W(m')`. -/
theorem dense_core_internal_junction_bidirectional_anagram_sieve_and_product_divisibility
    {W L_2 : ℕ → ℕ} {m m' S_K2 E_suf1 : ℕ}
    (hdvd_X : (58025 * 2 ^ S_K2) ∣ (scaledWaveX W L_2 m' - scaledWaveX W L_2 m))
    (hdvd_Y : (58025 * 3 ^ E_suf1) ∣ (scaledWaveY W L_2 m' - scaledWaveY W L_2 m)) :
    -- 1. Lower-run factor extraction whenever L_2(m) ≤ L_2(m'):
    (L_2 m ≤ L_2 m' →
      scaledWaveX W L_2 m ≤ scaledWaveX W L_2 m' →
      scaledWaveY W L_2 m ≤ scaledWaveY W L_2 m' →
      (58025 * 2 ^ S_K2) ∣ (3 ^ (10 * (L_2 m' - L_2 m)) * W m' - W m) ∧
      (58025 * 3 ^ E_suf1) ∣ (2 ^ (10 * (L_2 m' - L_2 m)) * W m' - W m) ∧
      (58025 * 2 ^ S_K2 * 3 ^ (10 * L_2 m)) ∣ (scaledWaveX W L_2 m' - scaledWaveX W L_2 m) ∧
      (58025 * 2 ^ (10 * L_2 m) * 3 ^ E_suf1) ∣ (scaledWaveY W L_2 m' - scaledWaveY W L_2 m)) ∧
    -- 2. Matching junction 2-run (L_2(m) = L_2(m')) multiplicative product divisibility & lower bound:
    (L_2 m = L_2 m' →
      scaledWaveX W L_2 m < scaledWaveX W L_2 m' →
      W m < W m' ∧
      (58025 * 2 ^ S_K2 * 3 ^ E_suf1) ∣ (W m' - W m) ∧
      58025 * 2 ^ S_K2 * 3 ^ E_suf1 ≤ W m' - W m ∧
      (1 ≤ W m → 58025 * 2 ^ S_K2 * 3 ^ E_suf1 < W m') ∧
      (58025 * 2 ^ S_K2 * 3 ^ (10 * L_2 m + E_suf1)) ∣
        (scaledWaveX W L_2 m' - scaledWaveX W L_2 m) ∧
      (58025 * 2 ^ (10 * L_2 m + S_K2) * 3 ^ E_suf1) ∣
        (scaledWaveY W L_2 m' - scaledWaveY W L_2 m)) := by
  have hpart1 :
      L_2 m ≤ L_2 m' →
      scaledWaveX W L_2 m ≤ scaledWaveX W L_2 m' →
      scaledWaveY W L_2 m ≤ scaledWaveY W L_2 m' →
      (58025 * 2 ^ S_K2) ∣ (3 ^ (10 * (L_2 m' - L_2 m)) * W m' - W m) ∧
      (58025 * 3 ^ E_suf1) ∣ (2 ^ (10 * (L_2 m' - L_2 m)) * W m' - W m) ∧
      (58025 * 2 ^ S_K2 * 3 ^ (10 * L_2 m)) ∣ (scaledWaveX W L_2 m' - scaledWaveX W L_2 m) ∧
      (58025 * 2 ^ (10 * L_2 m) * 3 ^ E_suf1) ∣ (scaledWaveY W L_2 m' - scaledWaveY W L_2 m) := by
    intro hL_le _ _
    have hexp_split : 10 * L_2 m' = 10 * L_2 m + 10 * (L_2 m' - L_2 m) := by omega
    have hX_factor :
        scaledWaveX W L_2 m' - scaledWaveX W L_2 m =
          3 ^ (10 * L_2 m) * (3 ^ (10 * (L_2 m' - L_2 m)) * W m' - W m) := by
      dsimp [scaledWaveX]
      rw [hexp_split, Nat.pow_add]
      have hmul :
          3 ^ (10 * L_2 m) * 3 ^ (10 * (L_2 m' - L_2 m)) * W m' =
            3 ^ (10 * L_2 m) * (3 ^ (10 * (L_2 m' - L_2 m)) * W m') := by ring
      rw [hmul, ← Nat.mul_sub_left_distrib]
    have hY_factor :
        scaledWaveY W L_2 m' - scaledWaveY W L_2 m =
          2 ^ (10 * L_2 m) * (2 ^ (10 * (L_2 m' - L_2 m)) * W m' - W m) := by
      dsimp [scaledWaveY]
      rw [hexp_split, Nat.pow_add]
      have hmul :
          2 ^ (10 * L_2 m) * 2 ^ (10 * (L_2 m' - L_2 m)) * W m' =
            2 ^ (10 * L_2 m) * (2 ^ (10 * (L_2 m' - L_2 m)) * W m') := by ring
      rw [hmul, ← Nat.mul_sub_left_distrib]
    have hcop_X : Nat.Coprime (58025 * 2 ^ S_K2) (3 ^ (10 * L_2 m)) :=
      Nat.Coprime.mul
        (Nat.Coprime.pow_right _ (by decide : Nat.Coprime 58025 3))
        (Nat.Coprime.pow _ _ (by decide : Nat.Coprime 2 3))
    have hcop_Y : Nat.Coprime (58025 * 3 ^ E_suf1) (2 ^ (10 * L_2 m)) :=
      Nat.Coprime.mul
        (Nat.Coprime.pow_right _ (by decide : Nat.Coprime 58025 2))
        (Nat.Coprime.pow _ _ (by decide : Nat.Coprime 3 2))
    have hdX_inner : (58025 * 2 ^ S_K2) ∣ (3 ^ (10 * (L_2 m' - L_2 m)) * W m' - W m) := by
      rw [hX_factor] at hdvd_X
      exact hcop_X.dvd_of_dvd_mul_left hdvd_X
    have hdY_inner : (58025 * 3 ^ E_suf1) ∣ (2 ^ (10 * (L_2 m' - L_2 m)) * W m' - W m) := by
      rw [hY_factor] at hdvd_Y
      exact hcop_Y.dvd_of_dvd_mul_left hdvd_Y
    rcases hdX_inner with ⟨kX, hkX⟩
    have hdX_full :
        (58025 * 2 ^ S_K2 * 3 ^ (10 * L_2 m)) ∣ (scaledWaveX W L_2 m' - scaledWaveX W L_2 m) := by
      refine ⟨kX, ?_⟩
      rw [hX_factor, hkX]; ring
    rcases hdY_inner with ⟨kY, hkY⟩
    have hdY_full :
        (58025 * 2 ^ (10 * L_2 m) * 3 ^ E_suf1) ∣ (scaledWaveY W L_2 m' - scaledWaveY W L_2 m) := by
      refine ⟨kY, ?_⟩
      rw [hY_factor, hkY]; ring
    exact ⟨⟨kX, hkX⟩, ⟨kY, hkY⟩, hdX_full, hdY_full⟩
  refine ⟨hpart1, ?_⟩
  intro hL_eq hX_lt
  have hW_lt : W m < W m' := by
    dsimp [scaledWaveX] at hX_lt
    rw [← hL_eq] at hX_lt
    exact Nat.lt_of_mul_lt_mul_left hX_lt
  have hY_lt : scaledWaveY W L_2 m < scaledWaveY W L_2 m' := by
    dsimp [scaledWaveY]
    rw [← hL_eq]
    exact Nat.mul_lt_mul_of_pos_left hW_lt (Nat.pow_pos (by decide))
  have hp1 := hpart1 (le_of_eq hL_eq) (le_of_lt hX_lt) (le_of_lt hY_lt)
  have hsub0 : L_2 m' - L_2 m = 0 := by omega
  have hd_2 : (58025 * 2 ^ S_K2) ∣ (W m' - W m) := by
    have h := hp1.1
    rw [hsub0, Nat.mul_zero, Nat.pow_zero, Nat.one_mul] at h
    exact h
  have hd_3 : (58025 * 3 ^ E_suf1) ∣ (W m' - W m) := by
    have h := hp1.2.1
    rw [hsub0, Nat.mul_zero, Nat.pow_zero, Nat.one_mul] at h
    exact h
  have hd_3_only : 3 ^ E_suf1 ∣ (W m' - W m) :=
    dvd_trans (dvd_mul_left (3 ^ E_suf1) 58025) hd_3
  have hcop_prod : Nat.Coprime (58025 * 2 ^ S_K2) (3 ^ E_suf1) :=
    Nat.Coprime.mul
      (Nat.Coprime.pow_right _ (by decide : Nat.Coprime 58025 3))
      (Nat.Coprime.pow _ _ (by decide : Nat.Coprime 2 3))
  have hd_prod : (58025 * 2 ^ S_K2 * 3 ^ E_suf1) ∣ (W m' - W m) :=
    hcop_prod.mul_dvd_of_dvd_of_dvd hd_2 hd_3_only
  rcases hd_prod with ⟨K, hK⟩
  have hK_pos : 1 ≤ K := by
    rcases Nat.eq_zero_or_pos K with rfl | hp
    · rw [Nat.mul_zero] at hK; omega
    · exact hp
  have hge_diff : 58025 * 2 ^ S_K2 * 3 ^ E_suf1 ≤ W m' - W m := by
    rw [hK]; exact Nat.le_mul_of_pos_right _ hK_pos
  have hlt_Wm' : 1 ≤ W m → 58025 * 2 ^ S_K2 * 3 ^ E_suf1 < W m' := by
    intro hWm_pos
    omega
  have hdX_prod :
      (58025 * 2 ^ S_K2 * 3 ^ (10 * L_2 m + E_suf1)) ∣
        (scaledWaveX W L_2 m' - scaledWaveX W L_2 m) := by
    refine ⟨K, ?_⟩
    dsimp [scaledWaveX]
    rw [← hL_eq, ← Nat.mul_sub_left_distrib, hK, Nat.pow_add]
    ring
  have hdY_prod :
      (58025 * 2 ^ (10 * L_2 m + S_K2) * 3 ^ E_suf1) ∣
        (scaledWaveY W L_2 m' - scaledWaveY W L_2 m) := by
    refine ⟨K, ?_⟩
    dsimp [scaledWaveY]
    rw [← hL_eq, ← Nat.mul_sub_left_distrib, hK, Nat.pow_add]
    ring
  exact ⟨hW_lt, ⟨K, hK⟩, hge_diff, hlt_Wm', hdX_prod, hdY_prod⟩

/-!
## Section 119: Internal Junction Bidirectional Archimedean Cutoff (`17*S_{K,2} + 27*E_{suf,1} + 170*L_2(M+1) + 255 < 10*S_M + 270*L_2(0) + 17*W_0`)

Combining Section 118's multiplicative junction bound `58025 * 2 ^ S_K2 * 3 ^ E_suf1 < W(M + 1)`
at the junction node `m' = M + 1` with the single-point Archimedean upper bound at `M + 1`
(`2^(S_M + 10*L_2(M+1)) * W(M+1) < 3^(S_M + 10*L_2(0)) * W(0)`) cancels `3 ^ E_suf1` directly
against `3^(S_M + 10*L_2(0))` while keeping `2 ^ S_K2` on the LHS:
  `58025 * 2 ^ (S_M + 10 * L_2 (M + 1) + S_K2) < 3 ^ (S_M + 10 * L_2 0 - E_suf1) * W 0`!
Notice the critical improvement over Section 91's Joint Prefix+Suffix Cutoff:
- In Section 91, combining a prefix `S_K` and suffix `E_suf` of a single block required bounding
  two different states (`W(r_2)` and `W(end)`), doubling the RHS to `2*p*S_pre + p*E_mid` and
  reducing the prefix weight on the LHS to `(q - p) * S_K = 7 * S_K`.
- At an **internal junction** `m' = M + 1`, both `2 ^ S_K2` and `3 ^ E_suf1` divide the **single**
  state difference `W(M + 1) - W(m)`, so we invoke the Archimedean bound **only once** at `M + 1`:
    `q * S_K2 + (p + q) * E_suf1 + 10 * q * L_2 (M + 1) + 15 * q < p * S_M + 10 * (p + q) * L_2 0 + q * W_0`,
  and at `(p, q) = (10, 17)`:
    `17 * S_K2 + 27 * E_suf1 + 170 * L_2 (M + 1) + 255 < 10 * S_M + 270 * L_2 0 + 17 * W_0`!
-/

/-- **Internal Junction Bidirectional Archimedean Cutoff:**
Whenever an internal junction at `M + 1` satisfies `58025 * 2 ^ S_K2 * 3 ^ E_suf1 < W(M + 1)` with
`E_suf1 ≤ S_M + 10 * L_2 0`, canceling `3 ^ E_suf1` against `3 ^ (S_M + 10 * L_2 0)` forces:
`q * S_K2 + (p + q) * E_suf1 + 10 * q * L_2 (M + 1) + 15 * q < p * S_M + 10 * (p + q) * L_2 0 + q * W_0`
(`17 * S_K2 + 27 * E_suf1 + 170 * L_2 (M + 1) + 255 < 10 * S_M + 270 * L_2 0 + 17 * W_0`). -/
theorem dense_core_internal_junction_bidirectional_archimedean_cutoff
    {W L_2 L_1 : ℕ → ℕ} {M W_0 S_K2 E_suf1 : ℕ}
    (hW0_lt : W 0 < 2 ^ W_0)
    (hL1_0 : 1 ≤ L_1 0)
    (hrec : ∀ n ≤ M,
      2 ^ (7 * L_1 n + 10 * L_2 (n + 1)) * W (n + 1) +
        19 * ((3 ^ (7 * L_1 n) - 2 ^ (7 * L_1 n)) / 2059) =
        3 ^ (10 * L_2 n + 7 * L_1 n) * W n)
    (hEsuf_le : E_suf1 ≤ waveInteriorExp L_2 L_1 M + 10 * L_2 0)
    (hjunc_lt : 58025 * 2 ^ S_K2 * 3 ^ E_suf1 < W (M + 1)) :
    let S_M := waveInteriorExp L_2 L_1 M
    58025 * 2 ^ (S_M + 10 * L_2 (M + 1) + S_K2) <
      3 ^ (S_M + 10 * L_2 0 - E_suf1) * W 0 ∧
    58025 * 2 ^ (S_M + 10 * L_2 (M + 1) + S_K2) <
      3 ^ (S_M + 10 * L_2 0 - E_suf1) * 2 ^ W_0 ∧
    (∀ p q : ℕ, 1 ≤ q → 3 ^ q ≤ 2 ^ (p + q) →
      q * S_K2 + (p + q) * E_suf1 + 10 * q * L_2 (M + 1) + 15 * q <
        p * S_M + 10 * (p + q) * L_2 0 + q * W_0) ∧
    17 * S_K2 + 27 * E_suf1 + 170 * L_2 (M + 1) + 255 <
      10 * S_M + 270 * L_2 0 + 17 * W_0 := by
  intro S_M
  have hAcc_pos : 1 ≤ waveInteriorAcc L_2 L_1 M :=
    waveInteriorAcc_pos L_2 L_1 hL1_0 M
  have hm :=
    (dense_core_symmetric_multi_wave_master_identity_and_boundary_independence.2
      W L_2 L_1 M hrec).1
  change 2 ^ S_M * (2 ^ (10 * L_2 (M + 1)) * W (M + 1)) + 19 * waveInteriorAcc L_2 L_1 M =
      3 ^ S_M * (3 ^ (10 * L_2 0) * W 0) at hm
  have hp2_M :
      2 ^ (S_M + 10 * L_2 (M + 1)) * W (M + 1) =
        2 ^ S_M * (2 ^ (10 * L_2 (M + 1)) * W (M + 1)) := by
    rw [Nat.pow_add]; ring
  have hp3_M :
      3 ^ (S_M + 10 * L_2 0) * W 0 = 3 ^ S_M * (3 ^ (10 * L_2 0) * W 0) := by
    rw [Nat.pow_add]; ring
  have hup_W0 : 2 ^ (S_M + 10 * L_2 (M + 1)) * W (M + 1) < 3 ^ (S_M + 10 * L_2 0) * W 0 := by
    linarith only [hm, hp2_M, hp3_M, hAcc_pos]
  have hm_lt :
      2 ^ (S_M + 10 * L_2 (M + 1)) * (58025 * 2 ^ S_K2 * 3 ^ E_suf1) <
        2 ^ (S_M + 10 * L_2 (M + 1)) * W (M + 1) :=
    Nat.mul_lt_mul_of_pos_left hjunc_lt (Nat.pow_pos (by decide))
  have hlhs_combine :
      2 ^ (S_M + 10 * L_2 (M + 1)) * (58025 * 2 ^ S_K2 * 3 ^ E_suf1) =
        3 ^ E_suf1 * (58025 * 2 ^ (S_M + 10 * L_2 (M + 1) + S_K2)) := by
    rw [Nat.pow_add 2 (S_M + 10 * L_2 (M + 1)) S_K2]; ring
  have hrhs_split :
      3 ^ (S_M + 10 * L_2 0) * W 0 =
        3 ^ E_suf1 * (3 ^ (S_M + 10 * L_2 0 - E_suf1) * W 0) := by
    set E_rem := S_M + 10 * L_2 0 - E_suf1
    have hexp : S_M + 10 * L_2 0 = E_suf1 + E_rem := by dsimp [E_rem]; omega
    calc 3 ^ (S_M + 10 * L_2 0) * W 0
        = (3 ^ E_suf1 * 3 ^ E_rem) * W 0 := by rw [hexp, Nat.pow_add]
      _ = 3 ^ E_suf1 * (3 ^ E_rem * W 0) := by ring
  have hcancel_W0 :
      58025 * 2 ^ (S_M + 10 * L_2 (M + 1) + S_K2) <
        3 ^ (S_M + 10 * L_2 0 - E_suf1) * W 0 := by
    have hlt_mul :
        3 ^ E_suf1 * (58025 * 2 ^ (S_M + 10 * L_2 (M + 1) + S_K2)) <
          3 ^ E_suf1 * (3 ^ (S_M + 10 * L_2 0 - E_suf1) * W 0) := by
      rw [← hlhs_combine, ← hrhs_split]
      exact lt_trans hm_lt hup_W0
    exact Nat.lt_of_mul_lt_mul_left hlt_mul
  have hcancel_2W0 :
      58025 * 2 ^ (S_M + 10 * L_2 (M + 1) + S_K2) <
        3 ^ (S_M + 10 * L_2 0 - E_suf1) * 2 ^ W_0 := by
    have hW0_mul :
        3 ^ (S_M + 10 * L_2 0 - E_suf1) * W 0 <
          3 ^ (S_M + 10 * L_2 0 - E_suf1) * 2 ^ W_0 :=
      Nat.mul_lt_mul_of_pos_left hW0_lt (Nat.pow_pos (by decide))
    exact lt_trans hcancel_W0 hW0_mul
  have hpq :
      ∀ p q : ℕ, 1 ≤ q → 3 ^ q ≤ 2 ^ (p + q) →
        q * S_K2 + (p + q) * E_suf1 + 10 * q * L_2 (M + 1) + 15 * q <
          p * S_M + 10 * (p + q) * L_2 0 + q * W_0 := by
    intro p q hq hpq_le
    set E_lhs := S_M + 10 * L_2 (M + 1) + S_K2
    set E_3 := S_M + 10 * L_2 0 - E_suf1
    have h2_15_lt : 2 ^ 15 * 2 ^ E_lhs < 3 ^ E_3 * 2 ^ W_0 := by
      have h2_15_le : 2 ^ 15 ≤ 58025 := by decide
      exact lt_of_le_of_lt (Nat.mul_le_mul_right (2 ^ E_lhs) h2_15_le) hcancel_2W0
    have hpow_q : (2 ^ 15 * 2 ^ E_lhs) ^ q < (3 ^ E_3 * 2 ^ W_0) ^ q :=
      pow_lt_pow_of_lt h2_15_lt hq
    have hlhs_ge : 2 ^ (q * E_lhs + 15 * q) ≤ (2 ^ 15 * 2 ^ E_lhs) ^ q := by
      have heq : 2 ^ (q * E_lhs + 15 * q) = (2 ^ 15 * 2 ^ E_lhs) ^ q := by
        calc 2 ^ (q * E_lhs + 15 * q)
            = 2 ^ (15 * q) * 2 ^ (q * E_lhs) := by rw [Nat.add_comm, Nat.pow_add]
          _ = (2 ^ 15) ^ q * (2 ^ E_lhs) ^ q := by
              rw [Nat.pow_mul 2 15 q, Nat.mul_comm q E_lhs, Nat.pow_mul 2 E_lhs q]
          _ = (2 ^ 15 * 2 ^ E_lhs) ^ q := (Nat.mul_pow (2 ^ 15) (2 ^ E_lhs) q).symm
      exact le_of_eq heq
    have h3_le : (3 ^ E_3) ^ q ≤ 2 ^ ((p + q) * E_3) := by
      calc (3 ^ E_3) ^ q
          = 3 ^ (E_3 * q) := (Nat.pow_mul 3 E_3 q).symm
        _ = 3 ^ (q * E_3) := by rw [Nat.mul_comm E_3 q]
        _ = (3 ^ q) ^ E_3 := Nat.pow_mul 3 q E_3
        _ ≤ (2 ^ (p + q)) ^ E_3 := Nat.pow_le_pow_left hpq_le E_3
        _ = 2 ^ ((p + q) * E_3) := (Nat.pow_mul 2 (p + q) E_3).symm
    have hrhs_le : (3 ^ E_3 * 2 ^ W_0) ^ q ≤ 2 ^ ((p + q) * E_3 + q * W_0) := by
      calc (3 ^ E_3 * 2 ^ W_0) ^ q
          = (3 ^ E_3) ^ q * (2 ^ W_0) ^ q := Nat.mul_pow (3 ^ E_3) (2 ^ W_0) q
        _ ≤ 2 ^ ((p + q) * E_3) * (2 ^ W_0) ^ q := Nat.mul_le_mul_right _ h3_le
        _ = 2 ^ ((p + q) * E_3) * 2 ^ (W_0 * q) := by rw [← Nat.pow_mul 2 W_0 q]
        _ = 2 ^ ((p + q) * E_3) * 2 ^ (q * W_0) := by rw [Nat.mul_comm W_0 q]
        _ = 2 ^ ((p + q) * E_3 + q * W_0) := (Nat.pow_add 2 _ _).symm
    have hpow2_lt : 2 ^ (q * E_lhs + 15 * q) < 2 ^ ((p + q) * E_3 + q * W_0) :=
      lt_of_le_of_lt hlhs_ge (lt_of_lt_of_le hpow_q hrhs_le)
    have hexp_lt : q * E_lhs + 15 * q < (p + q) * E_3 + q * W_0 := by
      refine Nat.lt_of_not_le (fun hge => ?_)
      have hpow_ge : 2 ^ ((p + q) * E_3 + q * W_0) ≤ 2 ^ (q * E_lhs + 15 * q) :=
        Nat.pow_le_pow_right (by decide) hge
      omega
    have hE3_expand :
        (p + q) * E_3 + (p + q) * E_suf1 = (p + q) * S_M + 10 * (p + q) * L_2 0 := by
      have h1 : E_3 + E_suf1 = S_M + 10 * L_2 0 := by dsimp [E_3]; omega
      calc (p + q) * E_3 + (p + q) * E_suf1
          = (p + q) * (E_3 + E_suf1) := (Nat.mul_add (p + q) E_3 E_suf1).symm
        _ = (p + q) * (S_M + 10 * L_2 0) := by rw [h1]
        _ = (p + q) * S_M + 10 * (p + q) * L_2 0 := by ring
    have hElhs_expand :
        q * E_lhs = q * S_M + 10 * q * L_2 (M + 1) + q * S_K2 := by
      dsimp [E_lhs]; ring
    have hSM_split : (p + q) * S_M = p * S_M + q * S_M := Nat.add_mul p q S_M
    linarith only [hexp_lt, hE3_expand, hElhs_expand, hSM_split]
  have h10_17 := hpq 10 17 (by decide) (by decide : 3 ^ 17 ≤ 2 ^ (10 + 17))
  exact ⟨hcancel_W0, hcancel_2W0, hpq, by linarith only [h10_17]⟩

/-!
## Section 120: Two-Block Concatenated Anagram Accumulator Decomposition & Cross-Block Complementarity Law

How does the multi-wave accumulator `waveInteriorAcc` behave across a **two-block piecewise anagram**
where Block 1 (`S_{N_1} = S'_{N'_1} = S_1`) and Block 2 (`S^tail_{N_2} = S'^tail_{N'_2} = S_2`) meet
across a matching bridge `2`-run `L_2(N_1 + 1) = L'_2(N'_1 + 1)` (`E_bridge = 10 * L_2(N_1 + 1)`)?
By `waveInteriorAcc_shift_comp` (Section 74):
  `Acc_{N_1 + 1 + N_2} = 3 ^ (E_bridge + S_2) * Acc_1 + 2 ^ (S_1 + E_bridge) * Acc_2`!
Notice the **Cross-Block Complementarity** built into this formula:
1. Block 1's accumulator difference `Acc'_1 - Acc_1` is multiplied by `3 ^ (E_bridge + S_2)`, which
   is divisible by `3 ^ S_K2` for **any** prefix step-sum `S_K2 ≤ E_bridge + S_2` of Block 2!
2. Block 2's accumulator difference `Acc'_2 - Acc_2` is multiplied by `2 ^ (S_1 + E_bridge)`, which
   is divisible by `2 ^ E_suf1` for **any** suffix step-sum `E_suf1 ≤ S_1 + E_bridge` of Block 1!
3. Therefore, whenever `(3045 * 2 ^ E_suf1) ∣ (Acc'_1 - Acc_1)` (from Block 1's suffix) and
   `(3045 * 3 ^ S_K2) ∣ (Acc'_2 - Acc_2)` (from Block 2's prefix), **both** terms in
   `Acc'_tot - Acc_tot` are divisible by `3045 * 2 ^ E_suf1 * 3 ^ S_K2`, so:
     `(3045 * 2 ^ E_suf1 * 3 ^ S_K2) ∣ (Acc'_tot - Acc_tot)`!
4. Furthermore, if Block 1 is an exact interior match (`Acc_1 = Acc'_1`), then Term 1 vanishes and
   `(3045 * 2 ^ (S_1 + E_bridge + E_suf2) * 3 ^ S_K2) ∣ (Acc'_tot - Acc_tot)` (amplifying the `2`-adic
   exponent by the entire step-sum `S_1 + E_bridge` of Block 1!). Symmetrically, if Block 2 is an
   exact interior match (`Acc_2 = Acc'_2`), then `(3045 * 2 ^ E_suf1 * 3 ^ (S_K1 + E_bridge + S_2)) ∣ (Acc'_tot - Acc_tot)`!
-/

/-- **Two-Block Concatenated Anagram Accumulator Decomposition & Cross-Block Complementarity Law:**
Across any two-block piecewise anagram (`S_{N_1} = S'_{N'_1}`, `L_2(N_1+1) = L'_2(N'_1+1)`,
`S^tail_{N_2} = S'^tail_{N'_2}`):
1. The concatenated step-sums match: `S_{N_1 + 1 + N_2} = S'_{N'_1 + 1 + N'_2}`.
2. `Acc'_tot - Acc_tot = 3^(E_bridge + S_2) * (Acc'_1 - Acc_1) + 2^(S_1 + E_bridge) * (Acc'_2 - Acc_2)`.
3. Cross-Block Complementarity: `(3045 * 2 ^ E_suf1) ∣ (Acc'_1 - Acc_1)` and
   `(3045 * 3 ^ S_K2) ∣ (Acc'_2 - Acc_2)` imply `(3045 * 2 ^ E_suf1 * 3 ^ S_K2) ∣ (Acc'_tot - Acc_tot)`.
4. Half-Block Exact Match Amplification: if `Acc_1 = Acc'_1` then `2^(S_1 + E_bridge)` amplifies
   Block 2's `2`-adic divisor; if `Acc_2 = Acc'_2` then `3^(E_bridge + S_2)` amplifies Block 1's `3`-adic divisor. -/
theorem dense_core_two_block_concatenated_anagram_accumulator_decomposition
    (L_2 L_1 L_2' L_1' : ℕ → ℕ) (N_1 N_1' N_2 N_2' : ℕ)
    (hS1 : waveInteriorExp L_2 L_1 N_1 = waveInteriorExp L_2' L_1' N_1')
    (hL_bridge : L_2 (N_1 + 1) = L_2' (N_1' + 1))
    (hS2 :
      waveInteriorExp (fun t => L_2 (N_1 + 1 + t)) (fun t => L_1 (N_1 + 1 + t)) N_2 =
        waveInteriorExp (fun t => L_2' (N_1' + 1 + t)) (fun t => L_1' (N_1' + 1 + t)) N_2') :
    let S_1 := waveInteriorExp L_2 L_1 N_1
    let E_bridge := 10 * L_2 (N_1 + 1)
    let S_2 := waveInteriorExp (fun t => L_2 (N_1 + 1 + t)) (fun t => L_1 (N_1 + 1 + t)) N_2
    let Acc_1 := waveInteriorAcc L_2 L_1 N_1
    let Acc_1' := waveInteriorAcc L_2' L_1' N_1'
    let Acc_2 := waveInteriorAcc (fun t => L_2 (N_1 + 1 + t)) (fun t => L_1 (N_1 + 1 + t)) N_2
    let Acc_2' := waveInteriorAcc (fun t => L_2' (N_1' + 1 + t)) (fun t => L_1' (N_1' + 1 + t)) N_2'
    let Acc_tot := waveInteriorAcc L_2 L_1 (N_1 + 1 + N_2)
    let Acc_tot' := waveInteriorAcc L_2' L_1' (N_1' + 1 + N_2')
    -- 1. Concatenated step-sum equality:
    waveInteriorExp L_2 L_1 (N_1 + 1 + N_2) = S_1 + E_bridge + S_2 ∧
    waveInteriorExp L_2' L_1' (N_1' + 1 + N_2') = S_1 + E_bridge + S_2 ∧
    -- 2. Concatenated accumulator difference decomposition:
    (Acc_1 ≤ Acc_1' → Acc_2 ≤ Acc_2' →
      Acc_tot' - Acc_tot =
        3 ^ (E_bridge + S_2) * (Acc_1' - Acc_1) + 2 ^ (S_1 + E_bridge) * (Acc_2' - Acc_2) ∧
      -- 3. Cross-block complementarity divisibility:
      (∀ E_suf1 S_K2 : ℕ,
        E_suf1 ≤ S_1 + E_bridge →
        S_K2 ≤ E_bridge + S_2 →
        (3045 * 2 ^ E_suf1) ∣ (Acc_1' - Acc_1) →
        (3045 * 3 ^ S_K2) ∣ (Acc_2' - Acc_2) →
        (3045 * 2 ^ E_suf1 * 3 ^ S_K2) ∣ (Acc_tot' - Acc_tot)) ∧
      -- 4a. Block-1 exact interior match ⟹ 2^(S_1 + E_bridge) amplification of Block 2:
      (∀ E_suf2 S_K2 : ℕ,
        Acc_1 = Acc_1' →
        (3045 * 2 ^ E_suf2 * 3 ^ S_K2) ∣ (Acc_2' - Acc_2) →
        (3045 * 2 ^ (S_1 + E_bridge + E_suf2) * 3 ^ S_K2) ∣ (Acc_tot' - Acc_tot)) ∧
      -- 4b. Block-2 exact interior match ⟹ 3^(E_bridge + S_2) amplification of Block 1:
      (∀ E_suf1 S_K1 : ℕ,
        Acc_2 = Acc_2' →
        (3045 * 2 ^ E_suf1 * 3 ^ S_K1) ∣ (Acc_1' - Acc_1) →
        (3045 * 2 ^ E_suf1 * 3 ^ (S_K1 + E_bridge + S_2)) ∣ (Acc_tot' - Acc_tot))) := by
  intro S_1 E_bridge S_2 Acc_1 Acc_1' Acc_2 Acc_2' Acc_tot Acc_tot'
  have hexp_1 := waveInteriorExp_shift_comp L_2 L_1 N_1 N_2
  have hexp_2 := waveInteriorExp_shift_comp L_2' L_1' N_1' N_2'
  rw [← hS1, ← hL_bridge, ← hS2] at hexp_2
  have hacc_1 := waveInteriorAcc_shift_comp L_2 L_1 N_1 N_2
  have hacc_2 := waveInteriorAcc_shift_comp L_2' L_1' N_1' N_2'
  rw [← hS1, ← hL_bridge, ← hS2] at hacc_2
  refine ⟨hexp_1, hexp_2, ?_⟩
  intro hle_1 hle_2
  have hdiff_eq :
      Acc_tot' - Acc_tot =
        3 ^ (E_bridge + S_2) * (Acc_1' - Acc_1) + 2 ^ (S_1 + E_bridge) * (Acc_2' - Acc_2) := by
    change Acc_tot' - Acc_tot =
      3 ^ (E_bridge + S_2) * (Acc_1' - Acc_1) + 2 ^ (S_1 + E_bridge) * (Acc_2' - Acc_2)
    have hm1 :
        3 ^ (E_bridge + S_2) * (Acc_1' - Acc_1) =
          3 ^ (E_bridge + S_2) * Acc_1' - 3 ^ (E_bridge + S_2) * Acc_1 :=
      Nat.mul_sub_left_distrib _ _ _
    have hm2 :
        2 ^ (S_1 + E_bridge) * (Acc_2' - Acc_2) =
          2 ^ (S_1 + E_bridge) * Acc_2' - 2 ^ (S_1 + E_bridge) * Acc_2 :=
      Nat.mul_sub_left_distrib _ _ _
    have hge1 : 3 ^ (E_bridge + S_2) * Acc_1 ≤ 3 ^ (E_bridge + S_2) * Acc_1' :=
      Nat.mul_le_mul_left _ hle_1
    have hge2 : 2 ^ (S_1 + E_bridge) * Acc_2 ≤ 2 ^ (S_1 + E_bridge) * Acc_2' :=
      Nat.mul_le_mul_left _ hle_2
    change Acc_tot = 3 ^ (E_bridge + S_2) * Acc_1 + 2 ^ (S_1 + E_bridge) * Acc_2 at hacc_1
    change Acc_tot' = 3 ^ (E_bridge + S_2) * Acc_1' + 2 ^ (S_1 + E_bridge) * Acc_2' at hacc_2
    omega
  have hcomp_dvd :
      ∀ E_suf1 S_K2 : ℕ,
        E_suf1 ≤ S_1 + E_bridge →
        S_K2 ≤ E_bridge + S_2 →
        (3045 * 2 ^ E_suf1) ∣ (Acc_1' - Acc_1) →
        (3045 * 3 ^ S_K2) ∣ (Acc_2' - Acc_2) →
        (3045 * 2 ^ E_suf1 * 3 ^ S_K2) ∣ (Acc_tot' - Acc_tot) := by
    intro E_suf1 S_K2 hE_le hS_le ⟨k1, hk1⟩ ⟨k2, hk2⟩
    have hp3_split :
        3 ^ (E_bridge + S_2) = 3 ^ S_K2 * 3 ^ (E_bridge + S_2 - S_K2) := by
      calc 3 ^ (E_bridge + S_2)
          = 3 ^ (S_K2 + (E_bridge + S_2 - S_K2)) := by congr 1; omega
        _ = 3 ^ S_K2 * 3 ^ (E_bridge + S_2 - S_K2) := Nat.pow_add 3 _ _
    have hp2_split :
        2 ^ (S_1 + E_bridge) = 2 ^ E_suf1 * 2 ^ (S_1 + E_bridge - E_suf1) := by
      calc 2 ^ (S_1 + E_bridge)
          = 2 ^ (E_suf1 + (S_1 + E_bridge - E_suf1)) := by congr 1; omega
        _ = 2 ^ E_suf1 * 2 ^ (S_1 + E_bridge - E_suf1) := Nat.pow_add 2 _ _
    refine ⟨3 ^ (E_bridge + S_2 - S_K2) * k1 + 2 ^ (S_1 + E_bridge - E_suf1) * k2, ?_⟩
    rw [hdiff_eq, hk1, hk2, hp3_split, hp2_split]
    ring
  have hamp_2 :
      ∀ E_suf2 S_K2 : ℕ,
        Acc_1 = Acc_1' →
        (3045 * 2 ^ E_suf2 * 3 ^ S_K2) ∣ (Acc_2' - Acc_2) →
        (3045 * 2 ^ (S_1 + E_bridge + E_suf2) * 3 ^ S_K2) ∣ (Acc_tot' - Acc_tot) := by
    intro E_suf2 S_K2 h1_eq ⟨k2, hk2⟩
    refine ⟨k2, ?_⟩
    have hsub0 : Acc_1' - Acc_1 = 0 := by omega
    rw [hdiff_eq, hsub0, Nat.mul_zero, Nat.zero_add, hk2,
      Nat.pow_add 2 (S_1 + E_bridge) E_suf2]
    ring
  have hamp_1 :
      ∀ E_suf1 S_K1 : ℕ,
        Acc_2 = Acc_2' →
        (3045 * 2 ^ E_suf1 * 3 ^ S_K1) ∣ (Acc_1' - Acc_1) →
        (3045 * 2 ^ E_suf1 * 3 ^ (S_K1 + E_bridge + S_2)) ∣ (Acc_tot' - Acc_tot) := by
    intro E_suf1 S_K1 h2_eq ⟨k1, hk1⟩
    refine ⟨k1, ?_⟩
    have hsub0 : Acc_2' - Acc_2 = 0 := by omega
    have hexp3 : S_K1 + E_bridge + S_2 = (E_bridge + S_2) + S_K1 := by omega
    rw [hdiff_eq, hsub0, Nat.mul_zero, Nat.add_zero, hk1, hexp3,
      Nat.pow_add 3 (E_bridge + S_2) S_K1]
    ring
  exact ⟨hdiff_eq, hcomp_dvd, hamp_2, hamp_1⟩

/-!
## Section 121: Boundary-Locked & Two-Block Junction-Locked Abelian Step-Sum Pigeonhole Theorems (`O(B^2 * N)` and `O(B^3 * N_1 * N_2)` Horizons)

In Section 117, we proved that among any `(17 * N + 7) * (B - 1) + 2` windows along a bounded-run
orbit (`1 ≤ L_1(n), L_2(n) ≤ B`), Pigeonhole guarantees two windows `i < j` with identical interior
step-sums `S^{(r(i))}_N = S^{(r(j))}_N`.
Now we refine the Pigeonhole map to lock the **boundary and internal junction `2`-runs** at the
same time:
1. **Boundary-Locked Abelian Step-Sum Pigeonhole (`B * ((17 * N + 7) * (B - 1) + 1) + 1` Windows):**
   Since `L_2(r(i)) ∈ {1, ..., B}` (`B` values) and `S^{(r(i))}_N` takes at most
   `C_N := (17 * N + 7) * (B - 1) + 1` values, the joint index
   `(L_2(r(i)) - 1) * C_N + (S^{(r(i))}_N - (17 * N + 7))` lies in `Fin (B * C_N)`.
   By Pigeonhole, among any `B * C_N + 1` windows `r(0) < ... < r(B * C_N)`, there ALWAYS exist
   `i < j` with **both** `L_2(r(i)) = L_2(r(j))` **and** `S^{(r(i))}_N = S^{(r(j))}_N`!
2. **Two-Block Junction-Locked Simultaneous Anagram Pigeonhole (`B * C_{N_1} * C_{N_2} + 1` Windows):**
   For a two-block window of `(N_1 + 1) + (N_2 + 1)` waves meeting at internal junction
   `m(i) = r(i) + N_1 + 1`, the triple `(L_2(m(i)), S^{(r(i))}_{N_1}, S^{(m(i))}_{N_2})` takes at
   most `B * C_{N_1} * C_{N_2}` values (`O(B^3 * N_1 * N_2)`).
   By Pigeonhole, among any `B * C_{N_1} * C_{N_2} + 1` windows, there ALWAYS exist `i < j` that
   simultaneously have:
   - Matching Block-1 interior step-sums `S^{(r(i))}_{N_1} = S^{(r(j))}_{N_1}`,
   - Matching internal junction `2`-runs `L_2(r(i) + N_1 + 1) = L_2(r(j) + N_1 + 1)`,
   - Matching Block-2 interior step-sums `S^{(r(i) + N_1 + 1)}_{N_2} = S^{(r(j) + N_1 + 1)}_{N_2}`,
   - And matching concatenated `(N_1 + 1 + N_2)`-wave interior step-sums
     `S^{(r(i))}_{N_1 + 1 + N_2} = S^{(r(j))}_{N_1 + 1 + N_2}`!
-/

/-- **Boundary-Locked & Two-Block Junction-Locked Abelian Step-Sum Pigeonhole Theorems:**
1. Among any `B * ((17 * N + 7) * (B - 1) + 1) + 1` windows along a bounded-run sequence in `[1, B]`,
   there exist `i < j` with both `L_2(r i) = L_2(r j)` and `S^{(r i)}_N = S^{(r j)}_N`.
2. Among any `B * ((17 * N_1 + 7) * (B - 1) + 1) * ((17 * N_2 + 7) * (B - 1) + 1) + 1` windows,
   there exist `i < j` that are simultaneous Block-1 anagrams, Block-2 anagrams, total
   `(N_1 + 1 + N_2)`-wave anagrams, and have matching internal junction `2`-runs
   `L_2(r i + N_1 + 1) = L_2(r j + N_1 + 1)`. -/
theorem dense_core_bounded_run_boundary_locked_and_two_block_anagram_pigeonhole :
    -- 1. Boundary-locked abelian step-sum Pigeonhole (O(B^2 * N) windows):
    (∀ (L_2 L_1 : ℕ → ℕ) (N B : ℕ)
       (r : Fin (B * ((17 * N + 7) * (B - 1) + 1) + 1) → ℕ),
      1 ≤ B →
      (∀ n : ℕ, 1 ≤ L_1 n ∧ L_1 n ≤ B) →
      (∀ n : ℕ, 1 ≤ L_2 n ∧ L_2 n ≤ B) →
      ∃ i j : Fin (B * ((17 * N + 7) * (B - 1) + 1) + 1),
        i < j ∧
        L_2 (r i) = L_2 (r j) ∧
        waveInteriorExp (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) N =
          waveInteriorExp (fun t => L_2 (r j + t)) (fun t => L_1 (r j + t)) N) ∧
    -- 2. Two-block junction-locked simultaneous anagram Pigeonhole (O(B^3 * N_1 * N_2) windows):
    (∀ (L_2 L_1 : ℕ → ℕ) (N_1 N_2 B : ℕ)
       (r : Fin (B * ((17 * N_1 + 7) * (B - 1) + 1) * ((17 * N_2 + 7) * (B - 1) + 1) + 1) → ℕ),
      1 ≤ B →
      (∀ n : ℕ, 1 ≤ L_1 n ∧ L_1 n ≤ B) →
      (∀ n : ℕ, 1 ≤ L_2 n ∧ L_2 n ≤ B) →
      ∃ i j : Fin (B * ((17 * N_1 + 7) * (B - 1) + 1) * ((17 * N_2 + 7) * (B - 1) + 1) + 1),
        i < j ∧
        L_2 (r i + N_1 + 1) = L_2 (r j + N_1 + 1) ∧
        waveInteriorExp (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) N_1 =
          waveInteriorExp (fun t => L_2 (r j + t)) (fun t => L_1 (r j + t)) N_1 ∧
        waveInteriorExp (fun t => L_2 (r i + N_1 + 1 + t)) (fun t => L_1 (r i + N_1 + 1 + t)) N_2 =
          waveInteriorExp (fun t => L_2 (r j + N_1 + 1 + t)) (fun t => L_1 (r j + N_1 + 1 + t)) N_2 ∧
        waveInteriorExp (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) (N_1 + 1 + N_2) =
          waveInteriorExp (fun t => L_2 (r j + t)) (fun t => L_1 (r j + t)) (N_1 + 1 + N_2)) := by
  refine ⟨?_, ?_⟩
  · intro L_2 L_1 N B r hB hL1 hL2
    let C_N := (17 * N + 7) * (B - 1) + 1
    let M_tot := B * C_N
    have hband :
        ∀ i : Fin (M_tot + 1),
          (L_2 (r i) - 1 < B) ∧
          (waveInteriorExp (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) N - (17 * N + 7) < C_N) ∧
          17 * N + 7 ≤ waveInteriorExp (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) N := by
      intro i
      have hL2_ri := hL2 (r i)
      have hmin := waveInteriorExp_ge_seventeen_mul_add_seven
        (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) N
        (fun t _ => (hL1 (r i + t)).1) (fun t _ => (hL2 (r i + (t + 1))).1)
      have hmax := waveInteriorExp_le_seventeen_mul_add_seven_mul
        (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) N B
        (fun t _ => (hL1 (r i + t)).2) (fun t _ => (hL2 (r i + (t + 1))).2)
      have hB_sub : (17 * N + 7) * B - (17 * N + 7) = (17 * N + 7) * (B - 1) := by
        have h1 : B = (B - 1) + 1 := by omega
        calc (17 * N + 7) * B - (17 * N + 7)
            = (17 * N + 7) * ((B - 1) + 1) - (17 * N + 7) := by rw [← h1]
          _ = (17 * N + 7) * (B - 1) + (17 * N + 7) - (17 * N + 7) := by ring_nf
          _ = (17 * N + 7) * (B - 1) := Nat.add_sub_cancel _ _
      dsimp [C_N]
      refine ⟨by omega, by omega, hmin⟩
    let codeIdx : Fin (M_tot + 1) → Fin M_tot := fun i =>
      ⟨(L_2 (r i) - 1) * C_N +
        (waveInteriorExp (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) N - (17 * N + 7)), by
        have hi := hband i
        have h1 : L_2 (r i) - 1 + 1 ≤ B := hi.1
        have h2 :
            (L_2 (r i) - 1) * C_N +
              (waveInteriorExp (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) N - (17 * N + 7)) <
              (L_2 (r i) - 1) * C_N + C_N :=
          Nat.add_lt_add_left hi.2.1 _
        have h3 : (L_2 (r i) - 1) * C_N + C_N = (L_2 (r i) - 1 + 1) * C_N := by ring
        have h4 : (L_2 (r i) - 1 + 1) * C_N ≤ B * C_N := Nat.mul_le_mul_right C_N h1
        dsimp [M_tot]
        omega⟩
    have hnot_inj : ¬Function.Injective codeIdx := by
      intro hinj
      have hcard := Fintype.card_le_of_injective codeIdx hinj
      simp only [Fintype.card_fin] at hcard
      omega
    rw [Function.Injective] at hnot_inj
    push_neg at hnot_inj
    rcases hnot_inj with ⟨a, b, hab_eq, hab_ne⟩
    have hij_ex : ∃ i j : Fin (M_tot + 1), i < j ∧ codeIdx i = codeIdx j := by
      rcases lt_trichotomy a b with hlt | rfl | hgt
      · exact ⟨a, b, hlt, hab_eq⟩
      · exact absurd rfl hab_ne
      · exact ⟨b, a, hgt, hab_eq.symm⟩
    rcases hij_ex with ⟨i, j, hij, hcode_eq⟩
    have hval_eq : (codeIdx i).1 = (codeIdx j).1 := congrArg Fin.val hcode_eq
    dsimp [codeIdx] at hval_eq
    have hi := hband i
    have hj := hband j
    set a_i := L_2 (r i) - 1
    set a_j := L_2 (r j) - 1
    set b_i := waveInteriorExp (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) N - (17 * N + 7)
    set b_j := waveInteriorExp (fun t => L_2 (r j + t)) (fun t => L_1 (r j + t)) N - (17 * N + 7)
    have hbi_lt : b_i < C_N := hi.2.1
    have hbj_lt : b_j < C_N := hj.2.1
    have ha_eq : a_i = a_j := by
      rcases lt_trichotomy a_i a_j with hlt | heq | hgt
      · have hle : a_i + 1 ≤ a_j := hlt
        have hm : (a_i + 1) * C_N ≤ a_j * C_N := Nat.mul_le_mul_right C_N hle
        have hd : (a_i + 1) * C_N = a_i * C_N + C_N := by ring
        omega
      · exact heq
      · have hle : a_j + 1 ≤ a_i := hgt
        have hm : (a_j + 1) * C_N ≤ a_i * C_N := Nat.mul_le_mul_right C_N hle
        have hd : (a_j + 1) * C_N = a_j * C_N + C_N := by ring
        omega
    have hb_eq : b_i = b_j := by
      rw [ha_eq] at hval_eq
      omega
    have hL_ri := (hL2 (r i)).1
    have hL_rj := (hL2 (r j)).1
    have hmin_i := hi.2.2
    have hmin_j := hj.2.2
    refine ⟨i, j, hij, ?_, ?_⟩
    · dsimp [a_i, a_j] at ha_eq; omega
    · dsimp [b_i, b_j] at hb_eq; omega
  · intro L_2 L_1 N_1 N_2 B r hB hL1 hL2
    let C_1 := (17 * N_1 + 7) * (B - 1) + 1
    let C_2 := (17 * N_2 + 7) * (B - 1) + 1
    let M_tot := B * C_1 * C_2
    have hband :
        ∀ i : Fin (M_tot + 1),
          (L_2 (r i + N_1 + 1) - 1 < B) ∧
          (waveInteriorExp (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) N_1 - (17 * N_1 + 7) < C_1) ∧
          17 * N_1 + 7 ≤ waveInteriorExp (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) N_1 ∧
          (waveInteriorExp (fun t => L_2 (r i + N_1 + 1 + t)) (fun t => L_1 (r i + N_1 + 1 + t)) N_2 -
            (17 * N_2 + 7) < C_2) ∧
          17 * N_2 + 7 ≤
            waveInteriorExp (fun t => L_2 (r i + N_1 + 1 + t)) (fun t => L_1 (r i + N_1 + 1 + t)) N_2 := by
      intro i
      have hL2_m := hL2 (r i + N_1 + 1)
      have hmin1 := waveInteriorExp_ge_seventeen_mul_add_seven
        (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) N_1
        (fun t _ => (hL1 (r i + t)).1) (fun t _ => (hL2 (r i + (t + 1))).1)
      have hmax1 := waveInteriorExp_le_seventeen_mul_add_seven_mul
        (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) N_1 B
        (fun t _ => (hL1 (r i + t)).2) (fun t _ => (hL2 (r i + (t + 1))).2)
      have hmin2 := waveInteriorExp_ge_seventeen_mul_add_seven
        (fun t => L_2 (r i + N_1 + 1 + t)) (fun t => L_1 (r i + N_1 + 1 + t)) N_2
        (fun t _ => (hL1 (r i + N_1 + 1 + t)).1) (fun t _ => (hL2 (r i + N_1 + 1 + (t + 1))).1)
      have hmax2 := waveInteriorExp_le_seventeen_mul_add_seven_mul
        (fun t => L_2 (r i + N_1 + 1 + t)) (fun t => L_1 (r i + N_1 + 1 + t)) N_2 B
        (fun t _ => (hL1 (r i + N_1 + 1 + t)).2) (fun t _ => (hL2 (r i + N_1 + 1 + (t + 1))).2)
      have hB_sub1 : (17 * N_1 + 7) * B - (17 * N_1 + 7) = (17 * N_1 + 7) * (B - 1) := by
        have h1 : B = (B - 1) + 1 := by omega
        calc (17 * N_1 + 7) * B - (17 * N_1 + 7)
            = (17 * N_1 + 7) * ((B - 1) + 1) - (17 * N_1 + 7) := by rw [← h1]
          _ = (17 * N_1 + 7) * (B - 1) + (17 * N_1 + 7) - (17 * N_1 + 7) := by ring_nf
          _ = (17 * N_1 + 7) * (B - 1) := Nat.add_sub_cancel _ _
      have hB_sub2 : (17 * N_2 + 7) * B - (17 * N_2 + 7) = (17 * N_2 + 7) * (B - 1) := by
        have h1 : B = (B - 1) + 1 := by omega
        calc (17 * N_2 + 7) * B - (17 * N_2 + 7)
            = (17 * N_2 + 7) * ((B - 1) + 1) - (17 * N_2 + 7) := by rw [← h1]
          _ = (17 * N_2 + 7) * (B - 1) + (17 * N_2 + 7) - (17 * N_2 + 7) := by ring_nf
          _ = (17 * N_2 + 7) * (B - 1) := Nat.add_sub_cancel _ _
      dsimp [C_1, C_2]
      refine ⟨by omega, by omega, hmin1, by omega, hmin2⟩
    let codeIdx : Fin (M_tot + 1) → Fin M_tot := fun i =>
      ⟨((L_2 (r i + N_1 + 1) - 1) * C_1 +
          (waveInteriorExp (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) N_1 - (17 * N_1 + 7))) * C_2 +
        (waveInteriorExp (fun t => L_2 (r i + N_1 + 1 + t)) (fun t => L_1 (r i + N_1 + 1 + t)) N_2 -
          (17 * N_2 + 7)), by
        have hi := hband i
        set a := L_2 (r i + N_1 + 1) - 1
        set b1 := waveInteriorExp (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) N_1 - (17 * N_1 + 7)
        set b2 :=
          waveInteriorExp (fun t => L_2 (r i + N_1 + 1 + t)) (fun t => L_1 (r i + N_1 + 1 + t)) N_2 -
            (17 * N_2 + 7)
        have ha1 : a + 1 ≤ B := hi.1
        have hb1_lt : a * C_1 + b1 < (a + 1) * C_1 := by
          have hd : (a + 1) * C_1 = a * C_1 + C_1 := by ring
          rw [hd]
          exact Nat.add_lt_add_left hi.2.1 _
        have hab1_le : a * C_1 + b1 + 1 ≤ B * C_1 := by
          have hm : (a + 1) * C_1 ≤ B * C_1 := Nat.mul_le_mul_right C_1 ha1
          omega
        have hb2_lt : (a * C_1 + b1) * C_2 + b2 < (a * C_1 + b1 + 1) * C_2 := by
          have hd : (a * C_1 + b1 + 1) * C_2 = (a * C_1 + b1) * C_2 + C_2 := by ring
          rw [hd]
          exact Nat.add_lt_add_left hi.2.2.2.1 _
        have htot_le : (a * C_1 + b1 + 1) * C_2 ≤ B * C_1 * C_2 :=
          Nat.mul_le_mul_right C_2 hab1_le
        dsimp [M_tot]
        omega⟩
    have hnot_inj : ¬Function.Injective codeIdx := by
      intro hinj
      have hcard := Fintype.card_le_of_injective codeIdx hinj
      simp only [Fintype.card_fin] at hcard
      omega
    rw [Function.Injective] at hnot_inj
    push_neg at hnot_inj
    rcases hnot_inj with ⟨a, b, hab_eq, hab_ne⟩
    have hij_ex : ∃ i j : Fin (M_tot + 1), i < j ∧ codeIdx i = codeIdx j := by
      rcases lt_trichotomy a b with hlt | rfl | hgt
      · exact ⟨a, b, hlt, hab_eq⟩
      · exact absurd rfl hab_ne
      · exact ⟨b, a, hgt, hab_eq.symm⟩
    rcases hij_ex with ⟨i, j, hij, hcode_eq⟩
    have hval_eq : (codeIdx i).1 = (codeIdx j).1 := congrArg Fin.val hcode_eq
    dsimp [codeIdx] at hval_eq
    have hi := hband i
    have hj := hband j
    set a_i := L_2 (r i + N_1 + 1) - 1
    set a_j := L_2 (r j + N_1 + 1) - 1
    set b1_i := waveInteriorExp (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) N_1 - (17 * N_1 + 7)
    set b1_j := waveInteriorExp (fun t => L_2 (r j + t)) (fun t => L_1 (r j + t)) N_1 - (17 * N_1 + 7)
    set b2_i :=
      waveInteriorExp (fun t => L_2 (r i + N_1 + 1 + t)) (fun t => L_1 (r i + N_1 + 1 + t)) N_2 -
        (17 * N_2 + 7)
    set b2_j :=
      waveInteriorExp (fun t => L_2 (r j + N_1 + 1 + t)) (fun t => L_1 (r j + N_1 + 1 + t)) N_2 -
        (17 * N_2 + 7)
    set p_i := a_i * C_1 + b1_i
    set p_j := a_j * C_1 + b1_j
    have hb2i_lt : b2_i < C_2 := hi.2.2.2.1
    have hb2j_lt : b2_j < C_2 := hj.2.2.2.1
    have hp_eq : p_i = p_j := by
      rcases lt_trichotomy p_i p_j with hlt | heq | hgt
      · have hle : p_i + 1 ≤ p_j := hlt
        have hm : (p_i + 1) * C_2 ≤ p_j * C_2 := Nat.mul_le_mul_right C_2 hle
        have hd : (p_i + 1) * C_2 = p_i * C_2 + C_2 := by ring
        omega
      · exact heq
      · have hle : p_j + 1 ≤ p_i := hgt
        have hm : (p_j + 1) * C_2 ≤ p_i * C_2 := Nat.mul_le_mul_right C_2 hle
        have hd : (p_j + 1) * C_2 = p_j * C_2 + C_2 := by ring
        omega
    have hb2_eq : b2_i = b2_j := by
      rw [hp_eq] at hval_eq
      omega
    dsimp [p_i, p_j] at hp_eq
    have hb1i_lt : b1_i < C_1 := hi.2.1
    have hb1j_lt : b1_j < C_1 := hj.2.1
    have ha_eq : a_i = a_j := by
      rcases lt_trichotomy a_i a_j with hlt | heq | hgt
      · have hle : a_i + 1 ≤ a_j := hlt
        have hm : (a_i + 1) * C_1 ≤ a_j * C_1 := Nat.mul_le_mul_right C_1 hle
        have hd : (a_i + 1) * C_1 = a_i * C_1 + C_1 := by ring
        omega
      · exact heq
      · have hle : a_j + 1 ≤ a_i := hgt
        have hm : (a_j + 1) * C_1 ≤ a_i * C_1 := Nat.mul_le_mul_right C_1 hle
        have hd : (a_j + 1) * C_1 = a_j * C_1 + C_1 := by ring
        omega
    have hb1_eq : b1_i = b1_j := by
      rw [ha_eq] at hp_eq
      omega
    have hL_mi := (hL2 (r i + N_1 + 1)).1
    have hL_mj := (hL2 (r j + N_1 + 1)).1
    have hmin1_i := hi.2.2.1
    have hmin1_j := hj.2.2.1
    have hmin2_i := hi.2.2.2.2
    have hmin2_j := hj.2.2.2.2
    have hL_eq : L_2 (r i + N_1 + 1) = L_2 (r j + N_1 + 1) := by
      dsimp [a_i, a_j] at ha_eq; omega
    have hS1_eq :
        waveInteriorExp (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) N_1 =
          waveInteriorExp (fun t => L_2 (r j + t)) (fun t => L_1 (r j + t)) N_1 := by
      dsimp [b1_i, b1_j] at hb1_eq; omega
    have hS2_eq :
        waveInteriorExp (fun t => L_2 (r i + N_1 + 1 + t)) (fun t => L_1 (r i + N_1 + 1 + t)) N_2 =
          waveInteriorExp (fun t => L_2 (r j + N_1 + 1 + t)) (fun t => L_1 (r j + N_1 + 1 + t)) N_2 := by
      dsimp [b2_i, b2_j] at hb2_eq; omega
    have hStot_eq :
        waveInteriorExp (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) (N_1 + 1 + N_2) =
          waveInteriorExp (fun t => L_2 (r j + t)) (fun t => L_1 (r j + t)) (N_1 + 1 + N_2) := by
      have hc_i := waveInteriorExp_shift_comp (fun t => L_2 (r i + t)) (fun t => L_1 (r i + t)) N_1 N_2
      have hc_j := waveInteriorExp_shift_comp (fun t => L_2 (r j + t)) (fun t => L_1 (r j + t)) N_1 N_2
      have hfun_L2_i : (fun t => L_2 (r i + (N_1 + 1 + t))) = (fun t => L_2 (r i + N_1 + 1 + t)) := by
        funext t; congr 1; omega
      have hfun_L1_i : (fun t => L_1 (r i + (N_1 + 1 + t))) = (fun t => L_1 (r i + N_1 + 1 + t)) := by
        funext t; congr 1; omega
      have hfun_L2_j : (fun t => L_2 (r j + (N_1 + 1 + t))) = (fun t => L_2 (r j + N_1 + 1 + t)) := by
        funext t; congr 1; omega
      have hfun_L1_j : (fun t => L_1 (r j + (N_1 + 1 + t))) = (fun t => L_1 (r j + N_1 + 1 + t)) := by
        funext t; congr 1; omega
      have hmid_i : r i + (N_1 + 1) = r i + N_1 + 1 := by omega
      have hmid_j : r j + (N_1 + 1) = r j + N_1 + 1 := by omega
      rw [hfun_L2_i, hfun_L1_i, hmid_i] at hc_i
      rw [hfun_L2_j, hfun_L1_j, hmid_j] at hc_j
      rw [hc_i, hc_j, hS1_eq, hL_eq, hS2_eq]
    exact ⟨i, j, hij, hL_eq, hS1_eq, hS2_eq, hStot_eq⟩

/-!
## Section 122: Two-Block Junction-Coupled Reduced Syzygy & Boosted Exponent Restoration Across a Matching Internal Junction

When Block 1 (with step-sum `S_1 = S_{K,1} + E_{mid,1} + E_{suf,1}`) and Block 2 (with step-sum
`S_2 = S_{K,2} + E_{mid,2} + E_{suf,2}`) meet at a matching internal junction `L_2(m) = L_2(m')`
(`E_bridge = 10 * L_2(m)`), Section 118 proves that the junction state difference
`ΔW_mid = W(m') - W(m)` factors as:
  `ΔW_mid = 58025 * 2 ^ S_K2 * 3 ^ E_suf1 * q_mid`  (`q_mid ≥ 1`)!
Consequently:
- At the end of Block 1 (`m, m'`), the scaled `Y`-quotient is `q_{Y,mid} = 2 ^ (E_bridge + S_K2) * q_mid`,
- At the start of Block 2 (`m, m'`), the scaled `X`-quotient is `q_{X,mid} = 3 ^ (E_suf1 + E_bridge) * q_mid`.
Substituting these into the reduced anagram syzygies (Section 106) of Block 1 and Block 2 couples
them through the **single integer quotient `q_mid`** and **boosts** both blocks' exponents across
the junction:
1. **Left Block Junction-Coupled Syzygy (`2`-adic exponent boosted by `E_bridge + S_{K,2}`):**
     `2 ^ (E_mid1 + E_suf1 + E_bridge + S_K2) * q_mid ± 41553 * q_A1 = 3 ^ (S_K1 + E_mid1) * q_X1`.
2. **Right Block Junction-Coupled Syzygy (`3`-adic exponent boosted by `E_{suf,1} + E_bridge`):**
     `2 ^ (E_mid2 + E_suf2) * q_Y2 ± 41553 * q_A2 = 3 ^ (E_suf1 + E_bridge + S_K2 + E_mid2) * q_mid`.
3. **Boosted Four-Window Defect Cancellation Across the Junction:**
   Whenever two right-block anagram pairs share the unsigned middle defect `q_A2` (with either sign!),
   Section 115 applied with effective prefix `S_eff := E_suf1 + E_bridge + S_K2` restores the
   **junction-boosted `3`-adic power**:
     `3 ^ (E_suf1 + E_bridge + S_K2 + E_mid2) ≤ 2 ^ (E_suf2' - E_suf2) * q_Y2' + q_Y2`!
-/

/-- **Two-Block Junction-Coupled Reduced Syzygy & Boosted Exponent Restoration:**
When `q_{Y,mid} = 2 ^ (E_bridge + S_K2) * q_mid` in Block 1 and `q_{X,mid} = 3 ^ (E_suf1 + E_bridge) * q_mid`
in Block 2 (`q_mid ≥ 1`):
1. Block 1 satisfies the boosted reduced syzygy with `2`-exponent `E_mid1 + E_suf1 + E_bridge + S_K2`.
2. Block 2 satisfies the boosted reduced syzygy with `3`-exponent `E_suf1 + E_bridge + S_K2 + E_mid2`.
3. Any two right-block pairs sharing `q_A2` (with either sign) satisfy the boosted restoration bound
   `3 ^ (E_suf1(1) + E_bridge(1) + S_K2(1) + E_mid2) ≤ 2 ^ (E_suf2(2) - E_suf2(1)) * q_Y2(2) + q_Y2(1)`. -/
theorem dense_core_two_block_junction_coupled_reduced_syzygy_and_boosted_restoration :
    -- 1. Junction-coupled syzygy transformation for Block 1 and Block 2:
    (∀ {S_K1 E_mid1 E_suf1 E_bridge S_K2 E_mid2 E_suf2 q_X1 q_mid q_Y2 q_A1 q_A2 : ℕ},
      (2 ^ (E_mid1 + E_suf1) * (2 ^ (E_bridge + S_K2) * q_mid) + 41553 * q_A1 =
          3 ^ (S_K1 + E_mid1) * q_X1 ∨
        2 ^ (E_mid1 + E_suf1) * (2 ^ (E_bridge + S_K2) * q_mid) =
          3 ^ (S_K1 + E_mid1) * q_X1 + 41553 * q_A1) →
      (2 ^ (E_mid2 + E_suf2) * q_Y2 + 41553 * q_A2 =
          3 ^ (S_K2 + E_mid2) * (3 ^ (E_suf1 + E_bridge) * q_mid) ∨
        2 ^ (E_mid2 + E_suf2) * q_Y2 =
          3 ^ (S_K2 + E_mid2) * (3 ^ (E_suf1 + E_bridge) * q_mid) + 41553 * q_A2) →
      (2 ^ (E_mid1 + E_suf1 + E_bridge + S_K2) * q_mid + 41553 * q_A1 =
          3 ^ (S_K1 + E_mid1) * q_X1 ∨
        2 ^ (E_mid1 + E_suf1 + E_bridge + S_K2) * q_mid =
          3 ^ (S_K1 + E_mid1) * q_X1 + 41553 * q_A1) ∧
      (2 ^ (E_mid2 + E_suf2) * q_Y2 + 41553 * q_A2 =
          3 ^ (E_suf1 + E_bridge + S_K2 + E_mid2) * q_mid ∨
        2 ^ (E_mid2 + E_suf2) * q_Y2 =
          3 ^ (E_suf1 + E_bridge + S_K2 + E_mid2) * q_mid + 41553 * q_A2)) ∧
    -- 2. Sign-blind boosted 4-window restoration across two junction-coupled right blocks sharing q_A2:
    (∀ {S_eff1 S_eff2 E_mid2 E_suf2_1 E_suf2_2 q_mid1 q_mid2 q_Y2_1 q_Y2_2 q_A2 : ℕ},
      S_eff1 ≤ S_eff2 →
      E_suf2_1 ≤ E_suf2_2 →
      1 ≤ q_mid1 → 1 ≤ q_mid2 → 1 ≤ q_Y2_1 → 1 ≤ q_Y2_2 →
      3 ^ S_eff1 * q_mid1 < 3 ^ S_eff2 * q_mid2 →
      (2 ^ (E_mid2 + E_suf2_1) * q_Y2_1 + 41553 * q_A2 = 3 ^ (S_eff1 + E_mid2) * q_mid1 ∨
       2 ^ (E_mid2 + E_suf2_1) * q_Y2_1 = 3 ^ (S_eff1 + E_mid2) * q_mid1 + 41553 * q_A2) →
      (2 ^ (E_mid2 + E_suf2_2) * q_Y2_2 + 41553 * q_A2 = 3 ^ (S_eff2 + E_mid2) * q_mid2 ∨
       2 ^ (E_mid2 + E_suf2_2) * q_Y2_2 = 3 ^ (S_eff2 + E_mid2) * q_mid2 + 41553 * q_A2) →
      2 ^ (E_mid2 + E_suf2_1) ≤ 3 ^ (S_eff2 - S_eff1) * q_mid2 + q_mid1 ∧
      3 ^ (S_eff1 + E_mid2) ≤ 2 ^ (E_suf2_2 - E_suf2_1) * q_Y2_2 + q_Y2_1) := by
  refine ⟨?_, ?_⟩
  · intro S_K1 E_mid1 E_suf1 E_bridge S_K2 E_mid2 E_suf2 q_X1 q_mid q_Y2 q_A1 q_A2 h1 h2
    have hp2 :
        2 ^ (E_mid1 + E_suf1 + E_bridge + S_K2) * q_mid =
          2 ^ (E_mid1 + E_suf1) * (2 ^ (E_bridge + S_K2) * q_mid) := by
      have hexp : E_mid1 + E_suf1 + E_bridge + S_K2 = (E_mid1 + E_suf1) + (E_bridge + S_K2) := by
        omega
      rw [hexp, Nat.pow_add]; ring
    have hp3 :
        3 ^ (E_suf1 + E_bridge + S_K2 + E_mid2) * q_mid =
          3 ^ (S_K2 + E_mid2) * (3 ^ (E_suf1 + E_bridge) * q_mid) := by
      have hexp : E_suf1 + E_bridge + S_K2 + E_mid2 = (S_K2 + E_mid2) + (E_suf1 + E_bridge) := by
        omega
      rw [hexp, Nat.pow_add]; ring
    rw [hp2, hp3]
    exact ⟨h1, h2⟩
  · intro S_eff1 S_eff2 E_mid2 E_suf2_1 E_suf2_2 q_mid1 q_mid2 q_Y2_1 q_Y2_2 q_A2
      hS_le hE_le hqm1 _ hqY1 _ hlt h1 h2
    have h115 :=
      dense_core_signed_middle_defect_unconditional_four_window_dichotomy
        hS_le hE_le hqm1 hqY1 hlt h1 h2
    exact ⟨h115.2.1, h115.2.2⟩

/-!
## Section 123: Horizon-Free Local Window Junction Cutoff & Contrapositive Exponential Start-State Floor at `r_2` (`2 ^ W_start ≤ W(r_2)`)

In Section 119, we propagated the internal junction bound `58025 * 2 ^ S_K2 * 3 ^ E_suf1 < W(m')`
back to `W(0)` at the origin, which placed the global step-sum `p * S_{m' - 1}` on the RHS.
What if instead we propagate from the junction `m' = r_2 + N'_1 + 1` back **only across Block 1 of
Window 2** to `W(r_2)` (whose step-sum is `S_1 = S^{(r_2)}_{N'_1}`, **completely independent of how
far down the orbit `r_2` is**)?
Applying Section 119 to the shifted trajectory starting at `r_2` proves:
1. **Exact Local `(2, 3)`-Power Squeeze on `W(r_2)` and `X(r_2)` (`E_suf1 ≤ S_1 + 10 * L_2(r_2)`):**
     `58025 * 2 ^ (S_1 + 10 * L_2 (r_2 + N'_1 + 1) + S_K2) < 3 ^ (S_1 + 10 * L_2 r_2 - E_suf1) * W r_2`!
2. **Horizon-Free Local Junction Cutoff (Under Any Start-State Bound `W(r_2) < 2 ^ W_start`):**
     `q * S_K2 + (p + q) * E_suf1 + 10 * q * L_2 (r_2 + N'_1 + 1) + 15 * q < p * S_1 + 10 * (p + q) * L_2 r_2 + q * W_start`,
   and at `(p, q) = (10, 17)`:
     `17 * S_K2 + 27 * E_suf1 + 170 * L_2 (r_2 + N'_1 + 1) + 255 < 10 * S_1 + 270 * L_2 r_2 + 17 * W_start`!
   Notice that the RHS depends **only on the local block step-sum `S_1`** and has **zero dependence
   on the window index `r_2`**!
3. **Contrapositive Exponential Start-State Floor (`2 ^ W_start ≤ W(r_2)`):**
   Whenever the local junction overlap satisfies
   `p * S_1 + 10 * (p + q) * L_2 r_2 + q * W_start ≤ q * S_K2 + (p + q) * E_suf1 + 10 * q * L_2 (r_2 + N'_1 + 1) + 15 * q`,
   the start state of Window 2 must satisfy `2 ^ W_start ≤ W(r_2)`!
-/

/-- **Horizon-Free Local Window Junction Cutoff & Contrapositive Exponential Start-State Floor at `r_2`:**
Propagating across Block 1 of Window 2 (`r_2 → r_2 + N'_1 + 1`, with local step-sum `S_1`) yields a
cutoff whose step-sum term `p * S_1` is completely independent of the window horizon `r_2`, and by
contrapositive forces the exponential lower bound `2 ^ W_start ≤ W(r_2)` whenever the local junction
overlap exceeds `p * S_1 + 10 * (p + q) * L_2(r_2) + q * W_start`. -/
theorem dense_core_local_window_horizon_free_junction_cutoff_and_start_state_floor
    {W L_2 L_1 : ℕ → ℕ} {r_2 N_1' S_K2 E_suf1 : ℕ}
    (hL1_r2 : 1 ≤ L_1 r_2)
    (hrec : ∀ n ≤ N_1',
      2 ^ (7 * L_1 (r_2 + n) + 10 * L_2 (r_2 + n + 1)) * W (r_2 + n + 1) +
        19 * ((3 ^ (7 * L_1 (r_2 + n)) - 2 ^ (7 * L_1 (r_2 + n))) / 2059) =
        3 ^ (10 * L_2 (r_2 + n) + 7 * L_1 (r_2 + n)) * W (r_2 + n))
    (hEsuf_le :
      E_suf1 ≤ waveInteriorExp (fun t => L_2 (r_2 + t)) (fun t => L_1 (r_2 + t)) N_1' + 10 * L_2 r_2)
    (hjunc_lt : 58025 * 2 ^ S_K2 * 3 ^ E_suf1 < W (r_2 + N_1' + 1)) :
    let S_1 := waveInteriorExp (fun t => L_2 (r_2 + t)) (fun t => L_1 (r_2 + t)) N_1'
    -- 1. Exact local (2, 3)-power lower bound on W(r_2):
    58025 * 2 ^ (S_1 + 10 * L_2 (r_2 + N_1' + 1) + S_K2) <
      3 ^ (S_1 + 10 * L_2 r_2 - E_suf1) * W r_2 ∧
    -- 2. Horizon-free local junction cutoff whenever W(r_2) < 2 ^ W_start:
    (∀ W_start : ℕ, W r_2 < 2 ^ W_start →
      (∀ p q : ℕ, 1 ≤ q → 3 ^ q ≤ 2 ^ (p + q) →
        q * S_K2 + (p + q) * E_suf1 + 10 * q * L_2 (r_2 + N_1' + 1) + 15 * q <
          p * S_1 + 10 * (p + q) * L_2 r_2 + q * W_start) ∧
      17 * S_K2 + 27 * E_suf1 + 170 * L_2 (r_2 + N_1' + 1) + 255 <
        10 * S_1 + 270 * L_2 r_2 + 17 * W_start) ∧
    -- 3. Contrapositive exponential start-state floor on W(r_2):
    (∀ W_start p q : ℕ, 1 ≤ q → 3 ^ q ≤ 2 ^ (p + q) →
      p * S_1 + 10 * (p + q) * L_2 r_2 + q * W_start ≤
        q * S_K2 + (p + q) * E_suf1 + 10 * q * L_2 (r_2 + N_1' + 1) + 15 * q →
      2 ^ W_start ≤ W r_2) := by
  intro S_1
  let W_sh := fun t => W (r_2 + t)
  let L_2_sh := fun t => L_2 (r_2 + t)
  let L_1_sh := fun t => L_1 (r_2 + t)
  have hL1_sh0 : 1 ≤ L_1_sh 0 := hL1_r2
  have hrec_sh :
      ∀ n ≤ N_1',
        2 ^ (7 * L_1_sh n + 10 * L_2_sh (n + 1)) * W_sh (n + 1) +
          19 * ((3 ^ (7 * L_1_sh n) - 2 ^ (7 * L_1_sh n)) / 2059) =
          3 ^ (10 * L_2_sh n + 7 * L_1_sh n) * W_sh n := by
    intro n hn
    dsimp [W_sh, L_2_sh, L_1_sh]
    have hidx : r_2 + (n + 1) = r_2 + n + 1 := by omega
    rw [hidx]
    exact hrec n hn
  have hEsuf_sh : E_suf1 ≤ waveInteriorExp L_2_sh L_1_sh N_1' + 10 * L_2_sh 0 := hEsuf_le
  have hjunc_sh : 58025 * 2 ^ S_K2 * 3 ^ E_suf1 < W_sh (N_1' + 1) := by
    dsimp [W_sh]
    have hidx : r_2 + (N_1' + 1) = r_2 + N_1' + 1 := by omega
    rw [hidx]
    exact hjunc_lt
  have hAcc_pos : 1 ≤ waveInteriorAcc L_2_sh L_1_sh N_1' :=
    waveInteriorAcc_pos L_2_sh L_1_sh hL1_sh0 N_1'
  have hm :=
    (dense_core_symmetric_multi_wave_master_identity_and_boundary_independence.2
      W_sh L_2_sh L_1_sh N_1' hrec_sh).1
  change 2 ^ S_1 * (2 ^ (10 * L_2_sh (N_1' + 1)) * W_sh (N_1' + 1)) +
      19 * waveInteriorAcc L_2_sh L_1_sh N_1' =
      3 ^ S_1 * (3 ^ (10 * L_2_sh 0) * W_sh 0) at hm
  have hidx_m : r_2 + (N_1' + 1) = r_2 + N_1' + 1 := by omega
  have hp2_M :
      2 ^ (S_1 + 10 * L_2 (r_2 + N_1' + 1)) * W (r_2 + N_1' + 1) =
        2 ^ S_1 * (2 ^ (10 * L_2_sh (N_1' + 1)) * W_sh (N_1' + 1)) := by
    dsimp [W_sh, L_2_sh]
    rw [hidx_m, Nat.pow_add]; ring
  have hp3_M :
      3 ^ (S_1 + 10 * L_2 r_2) * W r_2 = 3 ^ S_1 * (3 ^ (10 * L_2_sh 0) * W_sh 0) := by
    dsimp [W_sh, L_2_sh]
    rw [Nat.pow_add]; ring
  have hup_Wr2 :
      2 ^ (S_1 + 10 * L_2 (r_2 + N_1' + 1)) * W (r_2 + N_1' + 1) <
        3 ^ (S_1 + 10 * L_2 r_2) * W r_2 := by
    linarith only [hm, hp2_M, hp3_M, hAcc_pos]
  have hm_lt :
      2 ^ (S_1 + 10 * L_2 (r_2 + N_1' + 1)) * (58025 * 2 ^ S_K2 * 3 ^ E_suf1) <
        2 ^ (S_1 + 10 * L_2 (r_2 + N_1' + 1)) * W (r_2 + N_1' + 1) :=
    Nat.mul_lt_mul_of_pos_left hjunc_lt (Nat.pow_pos (by decide))
  have hlhs_combine :
      2 ^ (S_1 + 10 * L_2 (r_2 + N_1' + 1)) * (58025 * 2 ^ S_K2 * 3 ^ E_suf1) =
        3 ^ E_suf1 * (58025 * 2 ^ (S_1 + 10 * L_2 (r_2 + N_1' + 1) + S_K2)) := by
    rw [Nat.pow_add 2 (S_1 + 10 * L_2 (r_2 + N_1' + 1)) S_K2]; ring
  have hrhs_split :
      3 ^ (S_1 + 10 * L_2 r_2) * W r_2 =
        3 ^ E_suf1 * (3 ^ (S_1 + 10 * L_2 r_2 - E_suf1) * W r_2) := by
    set E_rem := S_1 + 10 * L_2 r_2 - E_suf1
    have hexp : S_1 + 10 * L_2 r_2 = E_suf1 + E_rem := by dsimp [E_rem]; omega
    calc 3 ^ (S_1 + 10 * L_2 r_2) * W r_2
        = (3 ^ E_suf1 * 3 ^ E_rem) * W r_2 := by rw [hexp, Nat.pow_add]
      _ = 3 ^ E_suf1 * (3 ^ E_rem * W r_2) := by ring
  have hcancel_Wr2 :
      58025 * 2 ^ (S_1 + 10 * L_2 (r_2 + N_1' + 1) + S_K2) <
        3 ^ (S_1 + 10 * L_2 r_2 - E_suf1) * W r_2 := by
    have hlt_mul :
        3 ^ E_suf1 * (58025 * 2 ^ (S_1 + 10 * L_2 (r_2 + N_1' + 1) + S_K2)) <
          3 ^ E_suf1 * (3 ^ (S_1 + 10 * L_2 r_2 - E_suf1) * W r_2) := by
      rw [← hlhs_combine, ← hrhs_split]
      exact lt_trans hm_lt hup_Wr2
    exact Nat.lt_of_mul_lt_mul_left hlt_mul
  have hlocal :
      ∀ W_start : ℕ, W r_2 < 2 ^ W_start →
        (∀ p q : ℕ, 1 ≤ q → 3 ^ q ≤ 2 ^ (p + q) →
          q * S_K2 + (p + q) * E_suf1 + 10 * q * L_2 (r_2 + N_1' + 1) + 15 * q <
            p * S_1 + 10 * (p + q) * L_2 r_2 + q * W_start) ∧
        17 * S_K2 + 27 * E_suf1 + 170 * L_2 (r_2 + N_1' + 1) + 255 <
          10 * S_1 + 270 * L_2 r_2 + 17 * W_start := by
    intro W_start hW_lt
    have hW0_sh : W_sh 0 < 2 ^ W_start := hW_lt
    have h119 :=
      dense_core_internal_junction_bidirectional_archimedean_cutoff
        hW0_sh hL1_sh0 hrec_sh hEsuf_sh hjunc_sh
    dsimp [W_sh, L_2_sh, L_1_sh] at h119
    rw [hidx_m] at h119
    exact ⟨h119.2.2.1, h119.2.2.2⟩
  have hcontra :
      ∀ W_start p q : ℕ, 1 ≤ q → 3 ^ q ≤ 2 ^ (p + q) →
        p * S_1 + 10 * (p + q) * L_2 r_2 + q * W_start ≤
          q * S_K2 + (p + q) * E_suf1 + 10 * q * L_2 (r_2 + N_1' + 1) + 15 * q →
        2 ^ W_start ≤ W r_2 := by
    intro W_start p q hq hpq_le hge
    refine Nat.le_of_not_lt (fun hlt => ?_)
    have hcut := (hlocal W_start hlt).1 p q hq hpq_le
    omega
  exact ⟨hcancel_Wr2, hlocal, hcontra⟩

/-!
## Section 124: Two-Block First-Divergence Exponential Dominance Law (`2^(S_1 + E_bridge) * Δ_2 < 3^(E_bridge + S_2) * Δ_1`)

Why can a divergence `Δ_2 = |Acc'_2 - Acc_2|` in Block 2 **never** cancel a divergence
`Δ_1 = |Acc'_1 - Acc_1|` in Block 1 inside a concatenated two-block anagram, **even when Block 1
and Block 2 diverge with opposite signs**?
By the First-Divergence Cauchy Pinch (Sections 90 and 95):
- Block 1's divergence at cumulative step-sum `E_div1` (`E_div1 + 10 ≤ S_1`) satisfies:
    `54569 * 2 ^ E_div1 * 3 ^ (S_1 - E_div1 - 10) < 2059 * Δ_1`,
- Block 2's divergence at cumulative step-sum `E_div2` (`E_div2 ≤ S_2`) satisfies:
    `2059 * Δ_2 < 2 ^ E_div2 * 3 ^ (S_2 - E_div2)` (and in fact any `Δ_2` satisfies `2059 * Δ_2 < 3 ^ S_2`).
In the shift-composition formula `Acc_tot = 3 ^ (E_bridge + S_2) * Acc_1 + 2 ^ (S_1 + E_bridge) * Acc_2`:
- Term 1 (`3 ^ (E_bridge + S_2) * 2059 * Δ_1`) exceeds
    `54569 * 2 ^ E_div1 * 3 ^ (S_1 - E_div1 - 10 + E_bridge + S_2)`,
- Term 2 (`2 ^ (S_1 + E_bridge) * 2059 * Δ_2`) is strictly less than
    `2 ^ (S_1 + E_bridge + E_div2) * 3 ^ (S_2 - E_div2)`.
Setting `Δ_div := (S_1 - E_div1) + E_bridge + E_div2 ≥ 10`:
Since `2 ^ 10 = 1024 < 54569` and `2 ≤ 3`, we have `2 ^ Δ_div < 54569 * 3 ^ (Δ_div - 10)` for every
`Δ_div ≥ 10`! Consequently:
  `2 ^ (S_1 + E_bridge) * Δ_2 < 3 ^ (E_bridge + S_2) * Δ_1` **strictly and unconditionally**!
-/

/-- **Two-Block First-Divergence Exponential Dominance Law:**
Whenever Block 1 diverges at `E_div1` with `E_div1 + 10 ≤ S_1` and Cauchy-pinch lower bound
`54569 * 2 ^ E_div1 * 3 ^ (S_1 - E_div1 - 10) < 2059 * Δ_1`, and Block 2 satisfies the Cauchy-pinch
upper bound `2059 * Δ_2 < 2 ^ E_div2 * 3 ^ (S_2 - E_div2)` with `E_div2 ≤ S_2`, Block 1's weighted
contribution `3 ^ (E_bridge + S_2) * Δ_1` strictly dominates Block 2's weighted contribution
`2 ^ (S_1 + E_bridge) * Δ_2`:
`2 ^ (S_1 + E_bridge) * Δ_2 < 3 ^ (E_bridge + S_2) * Δ_1`! -/
theorem dense_core_two_block_first_divergence_dominance_and_opposite_sign_pinch
    {S_1 E_bridge S_2 E_div1 E_div2 Δ_1 Δ_2 : ℕ}
    (hdiv1_le : E_div1 + 10 ≤ S_1)
    (hdiv2_le : E_div2 ≤ S_2)
    (hpinch1 : 54569 * 2 ^ E_div1 * 3 ^ (S_1 - E_div1 - 10) < 2059 * Δ_1)
    (hpinch2 : 2059 * Δ_2 < 2 ^ E_div2 * 3 ^ (S_2 - E_div2)) :
    let Δ_div := (S_1 - E_div1) + E_bridge + E_div2
    10 ≤ Δ_div ∧
    2 ^ Δ_div < 54569 * 3 ^ (Δ_div - 10) ∧
    2 ^ (S_1 + E_bridge) * (2059 * Δ_2) < 3 ^ (E_bridge + S_2) * (2059 * Δ_1) ∧
    2 ^ (S_1 + E_bridge) * Δ_2 < 3 ^ (E_bridge + S_2) * Δ_1 := by
  intro Δ_div
  have hΔ_ge10 : 10 ≤ Δ_div := by dsimp [Δ_div]; omega
  have hpow_dom : 2 ^ Δ_div < 54569 * 3 ^ (Δ_div - 10) := by
    have hsplit : Δ_div = 10 + (Δ_div - 10) := by omega
    calc 2 ^ Δ_div
        = 2 ^ (10 + (Δ_div - 10)) := by rw [← hsplit]
      _ = 1024 * 2 ^ (Δ_div - 10) := by rw [Nat.pow_add]
      _ ≤ 1024 * 3 ^ (Δ_div - 10) :=
          Nat.mul_le_mul_left 1024 (Nat.pow_le_pow_left (by decide) (Δ_div - 10))
      _ < 54569 * 3 ^ (Δ_div - 10) :=
          Nat.mul_lt_mul_of_pos_right (by decide : 1024 < 54569) (Nat.pow_pos (by decide))
  have hT2_lt :
      2 ^ (S_1 + E_bridge) * (2059 * Δ_2) <
        2 ^ E_div1 * 3 ^ (S_2 - E_div2) * 2 ^ Δ_div := by
    have hm :
        2 ^ (S_1 + E_bridge) * (2059 * Δ_2) <
          2 ^ (S_1 + E_bridge) * (2 ^ E_div2 * 3 ^ (S_2 - E_div2)) :=
      Nat.mul_lt_mul_of_pos_left hpinch2 (Nat.pow_pos (by decide))
    have hexp_eq :
        2 ^ (S_1 + E_bridge) * (2 ^ E_div2 * 3 ^ (S_2 - E_div2)) =
          2 ^ E_div1 * 3 ^ (S_2 - E_div2) * 2 ^ Δ_div := by
      have h2_eq : S_1 + E_bridge + E_div2 = E_div1 + Δ_div := by dsimp [Δ_div]; omega
      calc 2 ^ (S_1 + E_bridge) * (2 ^ E_div2 * 3 ^ (S_2 - E_div2))
          = 2 ^ (S_1 + E_bridge + E_div2) * 3 ^ (S_2 - E_div2) := by
              rw [Nat.pow_add 2 (S_1 + E_bridge) E_div2]; ring
        _ = (2 ^ E_div1 * 2 ^ Δ_div) * 3 ^ (S_2 - E_div2) := by
              rw [h2_eq, Nat.pow_add 2 E_div1 Δ_div]
        _ = 2 ^ E_div1 * 3 ^ (S_2 - E_div2) * 2 ^ Δ_div := by ring
    rw [← hexp_eq]
    exact hm
  have hT1_gt :
      2 ^ E_div1 * 3 ^ (S_2 - E_div2) * (54569 * 3 ^ (Δ_div - 10)) <
        3 ^ (E_bridge + S_2) * (2059 * Δ_1) := by
    have hm :
        3 ^ (E_bridge + S_2) * (54569 * 2 ^ E_div1 * 3 ^ (S_1 - E_div1 - 10)) <
          3 ^ (E_bridge + S_2) * (2059 * Δ_1) :=
      Nat.mul_lt_mul_of_pos_left hpinch1 (Nat.pow_pos (by decide))
    have hexp_eq :
        3 ^ (E_bridge + S_2) * (54569 * 2 ^ E_div1 * 3 ^ (S_1 - E_div1 - 10)) =
          2 ^ E_div1 * 3 ^ (S_2 - E_div2) * (54569 * 3 ^ (Δ_div - 10)) := by
      have h3_eq : (E_bridge + S_2) + (S_1 - E_div1 - 10) = (S_2 - E_div2) + (Δ_div - 10) := by
        dsimp [Δ_div]; omega
      calc 3 ^ (E_bridge + S_2) * (54569 * 2 ^ E_div1 * 3 ^ (S_1 - E_div1 - 10))
          = 54569 * 2 ^ E_div1 * 3 ^ ((E_bridge + S_2) + (S_1 - E_div1 - 10)) := by
              rw [Nat.pow_add 3 (E_bridge + S_2) (S_1 - E_div1 - 10)]; ring
        _ = 54569 * 2 ^ E_div1 * (3 ^ (S_2 - E_div2) * 3 ^ (Δ_div - 10)) := by
              rw [h3_eq, Nat.pow_add 3 (S_2 - E_div2) (Δ_div - 10)]
        _ = 2 ^ E_div1 * 3 ^ (S_2 - E_div2) * (54569 * 3 ^ (Δ_div - 10)) := by ring
    rw [← hexp_eq]
    exact hm
  have hmid_lt :
      2 ^ E_div1 * 3 ^ (S_2 - E_div2) * 2 ^ Δ_div <
        2 ^ E_div1 * 3 ^ (S_2 - E_div2) * (54569 * 3 ^ (Δ_div - 10)) :=
    Nat.mul_lt_mul_of_pos_left hpow_dom
      (Nat.mul_pos (Nat.pow_pos (by decide)) (Nat.pow_pos (by decide)))
  have h2059_lt :
      2 ^ (S_1 + E_bridge) * (2059 * Δ_2) < 3 ^ (E_bridge + S_2) * (2059 * Δ_1) :=
    lt_trans hT2_lt (lt_trans hmid_lt hT1_gt)
  have hdom : 2 ^ (S_1 + E_bridge) * Δ_2 < 3 ^ (E_bridge + S_2) * Δ_1 := by
    have hmul :
        2059 * (2 ^ (S_1 + E_bridge) * Δ_2) < 2059 * (3 ^ (E_bridge + S_2) * Δ_1) := by
      linarith only [h2059_lt]
    exact Nat.lt_of_mul_lt_mul_left hmul
  exact ⟨hΔ_ge10, hpow_dom, h2059_lt, hdom⟩

/-!
## Section 125: `K`-Junction Chain Simultaneous & Cumulative Archimedean Cutoff Across Multi-Block Anagram Chains

Suppose a trajectory exhibits a chain of `K` internal junctions (`1 ≤ K`, indexed by `k : Fin K`)
at positions `m(k) + 1`, where each junction `k` has left shared suffix `E_suf(k)` and right shared
prefix `S_pre(k)` satisfying `58025 * 2 ^ (S_pre k) * 3 ^ (E_suf k) < W (m k + 1)`.
By Section 119:
1. **Simultaneous Pointwise Junction Cutoffs (`∀ k : Fin K`):**
     `q * S_pre k + (p + q) * E_suf k + 10 * q * L_2 (m k + 1) + 15 * q < p * S_{m k} + 10 * (p + q) * L_2 0 + q * W_0`.
2. **Cumulative `K`-Junction Additive Cutoff (Summing over `k ∈ Finset.univ`):**
     `q * (∑ k, S_pre k) + (p + q) * (∑ k, E_suf k) + 10 * q * (∑ k, L_2 (m k + 1)) + 15 * q * K < p * (∑ k, S_{m k}) + 10 * (p + q) * K * L_2 0 + q * K * W_0`,
   and at `(p, q) = (10, 17)`:
     `17 * (∑ k, S_pre k) + 27 * (∑ k, E_suf k) + 170 * (∑ k, L_2 (m k + 1)) + 255 * K < 10 * (∑ k, S_{m k}) + 270 * K * L_2 0 + 17 * K * W_0`!
-/

/-- **`K`-Junction Chain Simultaneous & Cumulative Archimedean Cutoff:**
Across any `K ≥ 1` internal junctions `m(k) + 1` (`k : Fin K`) satisfying
`58025 * 2 ^ (S_pre k) * 3 ^ (E_suf k) < W (m k + 1)`, every junction satisfies Section 119's
single-point cutoff and their sum satisfies the cumulative `K`-junction additive cutoff. -/
theorem dense_core_multi_junction_chain_cumulative_and_extremal_archimedean_cutoff
    {W L_2 L_1 : ℕ → ℕ} {K W_0 : ℕ}
    (m S_pre E_suf : Fin K → ℕ)
    (hK : 1 ≤ K)
    (hW0_lt : W 0 < 2 ^ W_0)
    (hL1_0 : 1 ≤ L_1 0)
    (hrec : ∀ n : ℕ,
      2 ^ (7 * L_1 n + 10 * L_2 (n + 1)) * W (n + 1) +
        19 * ((3 ^ (7 * L_1 n) - 2 ^ (7 * L_1 n)) / 2059) =
        3 ^ (10 * L_2 n + 7 * L_1 n) * W n)
    (hEsuf_le : ∀ k : Fin K, E_suf k ≤ waveInteriorExp L_2 L_1 (m k) + 10 * L_2 0)
    (hjunc_lt : ∀ k : Fin K, 58025 * 2 ^ (S_pre k) * 3 ^ (E_suf k) < W (m k + 1)) :
    -- 1. Pointwise cutoff at every junction k ∈ Fin K:
    (∀ k : Fin K, ∀ p q : ℕ, 1 ≤ q → 3 ^ q ≤ 2 ^ (p + q) →
      q * S_pre k + (p + q) * E_suf k + 10 * q * L_2 (m k + 1) + 15 * q <
        p * waveInteriorExp L_2 L_1 (m k) + 10 * (p + q) * L_2 0 + q * W_0) ∧
    -- 2. Cumulative K-junction additive cutoff for all (p, q):
    (∀ p q : ℕ, 1 ≤ q → 3 ^ q ≤ 2 ^ (p + q) →
      q * (∑ k : Fin K, S_pre k) + (p + q) * (∑ k : Fin K, E_suf k) +
        10 * q * (∑ k : Fin K, L_2 (m k + 1)) + 15 * q * K <
        p * (∑ k : Fin K, waveInteriorExp L_2 L_1 (m k)) +
          10 * (p + q) * K * L_2 0 + q * K * W_0) ∧
    -- 3. Cumulative K-junction cutoff at (p, q) = (10, 17):
    17 * (∑ k : Fin K, S_pre k) + 27 * (∑ k : Fin K, E_suf k) +
      170 * (∑ k : Fin K, L_2 (m k + 1)) + 255 * K <
      10 * (∑ k : Fin K, waveInteriorExp L_2 L_1 (m k)) +
        270 * K * L_2 0 + 17 * K * W_0 := by
  have hpt :
      ∀ k : Fin K, ∀ p q : ℕ, 1 ≤ q → 3 ^ q ≤ 2 ^ (p + q) →
        q * S_pre k + (p + q) * E_suf k + 10 * q * L_2 (m k + 1) + 15 * q <
          p * waveInteriorExp L_2 L_1 (m k) + 10 * (p + q) * L_2 0 + q * W_0 := by
    intro k p q hq hpq_le
    exact (dense_core_internal_junction_bidirectional_archimedean_cutoff
      hW0_lt hL1_0 (fun n _ => hrec n) (hEsuf_le k) (hjunc_lt k)).2.2.1 p q hq hpq_le
  have hcum :
      ∀ p q : ℕ, 1 ≤ q → 3 ^ q ≤ 2 ^ (p + q) →
        q * (∑ k : Fin K, S_pre k) + (p + q) * (∑ k : Fin K, E_suf k) +
          10 * q * (∑ k : Fin K, L_2 (m k + 1)) + 15 * q * K <
          p * (∑ k : Fin K, waveInteriorExp L_2 L_1 (m k)) +
            10 * (p + q) * K * L_2 0 + q * K * W_0 := by
    intro p q hq hpq_le
    have hne : (Finset.univ : Finset (Fin K)).Nonempty := by
      exact ⟨⟨0, hK⟩, Finset.mem_univ _⟩
    have hsum_lt :
        (∑ k : Fin K,
          (q * S_pre k + (p + q) * E_suf k + 10 * q * L_2 (m k + 1) + 15 * q)) <
          (∑ k : Fin K,
            (p * waveInteriorExp L_2 L_1 (m k) + 10 * (p + q) * L_2 0 + q * W_0)) :=
      Finset.sum_lt_sum_of_nonempty hne (fun k _ => hpt k p q hq hpq_le)
    simp only [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_const,
      Finset.card_univ, Fintype.card_fin, smul_eq_mul] at hsum_lt
    linarith only [hsum_lt]
  have h10_17 := hcum 10 17 (by decide) (by decide : 3 ^ 17 ≤ 2 ^ (10 + 17))
  exact ⟨hpt, hcum, by linarith only [h10_17]⟩

/-!
## Section 126: Horizon-Free Forward Prefix-to-End & Backward Suffix-to-Start Local Anagram Cutoffs (and Contrapositive Exponential State Floors)

In Section 106, we proved the two sign-independent mutual defect-absorption cross-bounds across any
anagram pair (`S_{J+D} = S'_{J'+D} = S_end`, with `S_end = S_J + E_suf`):
1. **Forward Prefix-to-End Absorption Bound:**
     `58024 * 3 ^ S_end < 2 ^ (S_end - S_K) * Y'(end') = 2 ^ (S_end - S_K + 10 * L_2_end') * W_end'`.
   Notice that **neither `W(0)` nor `W'(0')` appears in this inequality**! Applying any rational
   lower bound `2 ^ (p' + q') ≤ 3 ^ q'` (`1 ≤ q'`, e.g. `(p', q') = (7, 12)` where `2 ^ 19 ≤ 3 ^ 12`)
   proves that whenever `W_end' < 2 ^ W_end`:
     `p' * S_end + q' * S_K + 15 * q' < 10 * q' * L_2_end' + q' * W_end`,
   and at `(p', q') = (7, 12)`:
     `7 * S_end + 12 * S_K + 180 < 120 * L_2_end' + 12 * W_end` (**with zero step-sum on the RHS!**).
   By contrapositive, whenever `10 * q' * L_2_end' + q' * W_end ≤ p' * S_end + q' * S_K + 15 * q'`,
   the terminal state of Window 2 must satisfy `2 ^ W_end ≤ W_end'`!
2. **Backward Suffix-to-Start Absorption Bound:**
     `58025 * 2 ^ S_end < 3 ^ S_J * X'(0') = 3 ^ (S_J + 10 * L_2_0') * W_0'`.
   Applying any rational upper bound `3 ^ q ≤ 2 ^ (p + q)` (`1 ≤ q`, e.g. `(p, q) = (10, 17)`)
   proves that whenever `W_0' < 2 ^ W_start`:
     `q * E_suf + 15 * q < p * S_J + 10 * (p + q) * L_2_0' + q * W_start`,
   and at `(p, q) = (10, 17)`:
     `17 * E_suf + 255 < 10 * S_J + 270 * L_2_0' + 17 * W_start`!
   By contrapositive, whenever `p * S_J + 10 * (p + q) * L_2_0' + q * W_start ≤ q * E_suf + 15 * q`,
   the initial state of Window 2 must satisfy `2 ^ W_start ≤ W_0'`!
-/

/-- **Horizon-Free Forward Prefix-to-End & Backward Suffix-to-Start Local Anagram Cutoffs:**
1. From `58024 * 3 ^ S_end < 2 ^ (S_end - S_K + 10 * L_2_end') * W_end'` (`S_K ≤ S_end`), any
   `W_end' < 2 ^ W_end` forces `p' * S_end + q' * S_K + 15 * q' < 10 * q' * L_2_end' + q' * W_end`
   (`7 * S_end + 12 * S_K + 180 < 120 * L_2_end' + 12 * W_end`), and by contrapositive forces
   `2 ^ W_end ≤ W_end'`.
2. From `58025 * 2 ^ (S_J + E_suf) < 3 ^ (S_J + 10 * L_2_0') * W_0'`, any `W_0' < 2 ^ W_start`
   forces `q * E_suf + 15 * q < p * S_J + 10 * (p + q) * L_2_0' + q * W_start`
   (`17 * E_suf + 255 < 10 * S_J + 270 * L_2_0' + 17 * W_start`), and by contrapositive forces
   `2 ^ W_start ≤ W_0'`. -/
theorem dense_core_forward_prefix_to_end_and_backward_suffix_to_start_local_cutoffs :
    -- 1. Forward prefix-to-end step-sum-free RHS cutoff & contrapositive terminal floor:
    (∀ {S_end S_K L_2_end' W_end' : ℕ},
      S_K ≤ S_end →
      58024 * 3 ^ S_end < 2 ^ (S_end - S_K + 10 * L_2_end') * W_end' →
      (∀ W_end : ℕ, W_end' < 2 ^ W_end →
        (∀ p' q' : ℕ, 1 ≤ q' → 2 ^ (p' + q') ≤ 3 ^ q' →
          p' * S_end + q' * S_K + 15 * q' < 10 * q' * L_2_end' + q' * W_end) ∧
        7 * S_end + 12 * S_K + 180 < 120 * L_2_end' + 12 * W_end) ∧
      (∀ W_end p' q' : ℕ, 1 ≤ q' → 2 ^ (p' + q') ≤ 3 ^ q' →
        10 * q' * L_2_end' + q' * W_end ≤ p' * S_end + q' * S_K + 15 * q' →
        2 ^ W_end ≤ W_end')) ∧
    -- 2. Backward suffix-to-start local cutoff & contrapositive start-state floor:
    (∀ {S_J E_suf L_2_0' W_0' : ℕ},
      58025 * 2 ^ (S_J + E_suf) < 3 ^ (S_J + 10 * L_2_0') * W_0' →
      (∀ W_start : ℕ, W_0' < 2 ^ W_start →
        (∀ p q : ℕ, 1 ≤ q → 3 ^ q ≤ 2 ^ (p + q) →
          q * E_suf + 15 * q < p * S_J + 10 * (p + q) * L_2_0' + q * W_start) ∧
        17 * E_suf + 255 < 10 * S_J + 270 * L_2_0' + 17 * W_start) ∧
      (∀ W_start p q : ℕ, 1 ≤ q → 3 ^ q ≤ 2 ^ (p + q) →
        p * S_J + 10 * (p + q) * L_2_0' + q * W_start ≤ q * E_suf + 15 * q →
        2 ^ W_start ≤ W_0')) := by
  refine ⟨?_, ?_⟩
  · intro S_end S_K L_2_end' W_end' hSK_le hfwd
    have hcut :
        ∀ W_end : ℕ, W_end' < 2 ^ W_end →
          (∀ p' q' : ℕ, 1 ≤ q' → 2 ^ (p' + q') ≤ 3 ^ q' →
            p' * S_end + q' * S_K + 15 * q' < 10 * q' * L_2_end' + q' * W_end) ∧
          7 * S_end + 12 * S_K + 180 < 120 * L_2_end' + 12 * W_end := by
      intro W_end hW_lt
      have hpq' :
          ∀ p' q' : ℕ, 1 ≤ q' → 2 ^ (p' + q') ≤ 3 ^ q' →
            p' * S_end + q' * S_K + 15 * q' < 10 * q' * L_2_end' + q' * W_end := by
        intro p' q' hq' hpq'_le
        set E_rhs := S_end - S_K + 10 * L_2_end'
        have h2_15_lt : 2 ^ 15 * 3 ^ S_end < 2 ^ (E_rhs + W_end) := by
          have h1 : 2 ^ 15 * 3 ^ S_end ≤ 58024 * 3 ^ S_end :=
            Nat.mul_le_mul_right (3 ^ S_end) (by decide : 2 ^ 15 ≤ 58024)
          have h2 : 2 ^ E_rhs * W_end' < 2 ^ E_rhs * 2 ^ W_end :=
            Nat.mul_lt_mul_of_pos_left hW_lt (Nat.pow_pos (by decide))
          rw [Nat.pow_add 2 E_rhs W_end]
          exact lt_of_le_of_lt h1 (lt_trans hfwd h2)
        have hpow_q' : (2 ^ 15 * 3 ^ S_end) ^ q' < (2 ^ (E_rhs + W_end)) ^ q' :=
          pow_lt_pow_of_lt h2_15_lt hq'
        have h3_ge : 2 ^ ((p' + q') * S_end) ≤ (3 ^ S_end) ^ q' := by
          calc 2 ^ ((p' + q') * S_end)
              = (2 ^ (p' + q')) ^ S_end := Nat.pow_mul 2 (p' + q') S_end
            _ ≤ (3 ^ q') ^ S_end := Nat.pow_le_pow_left hpq'_le S_end
            _ = 3 ^ (q' * S_end) := (Nat.pow_mul 3 q' S_end).symm
            _ = 3 ^ (S_end * q') := by rw [Nat.mul_comm q' S_end]
            _ = (3 ^ S_end) ^ q' := Nat.pow_mul 3 S_end q'
        have hlhs_ge : 2 ^ (15 * q' + (p' + q') * S_end) ≤ (2 ^ 15 * 3 ^ S_end) ^ q' := by
          calc 2 ^ (15 * q' + (p' + q') * S_end)
              = 2 ^ (15 * q') * 2 ^ ((p' + q') * S_end) := Nat.pow_add 2 _ _
            _ = (2 ^ 15) ^ q' * 2 ^ ((p' + q') * S_end) := by rw [Nat.pow_mul 2 15 q']
            _ ≤ (2 ^ 15) ^ q' * (3 ^ S_end) ^ q' := Nat.mul_le_mul_left _ h3_ge
            _ = (2 ^ 15 * 3 ^ S_end) ^ q' := (Nat.mul_pow (2 ^ 15) (3 ^ S_end) q').symm
        have hrhs_eq : (2 ^ (E_rhs + W_end)) ^ q' = 2 ^ (q' * (E_rhs + W_end)) := by
          rw [← Nat.pow_mul 2 (E_rhs + W_end) q', Nat.mul_comm (E_rhs + W_end) q']
        have hpow2_lt : 2 ^ (15 * q' + (p' + q') * S_end) < 2 ^ (q' * (E_rhs + W_end)) := by
          rw [← hrhs_eq]
          exact lt_of_le_of_lt hlhs_ge hpow_q'
        have hexp_lt : 15 * q' + (p' + q') * S_end < q' * (E_rhs + W_end) := by
          refine Nat.lt_of_not_le (fun hge => ?_)
          have hp_ge : 2 ^ (q' * (E_rhs + W_end)) ≤ 2 ^ (15 * q' + (p' + q') * S_end) :=
            Nat.pow_le_pow_right (by decide) hge
          omega
        have hErhs_expand :
            q' * (E_rhs + W_end) + q' * S_K =
              q' * S_end + 10 * q' * L_2_end' + q' * W_end := by
          have h1 : (E_rhs + W_end) + S_K = S_end + 10 * L_2_end' + W_end := by
            dsimp [E_rhs]; omega
          calc q' * (E_rhs + W_end) + q' * S_K
              = q' * ((E_rhs + W_end) + S_K) := (Nat.mul_add q' (E_rhs + W_end) S_K).symm
            _ = q' * (S_end + 10 * L_2_end' + W_end) := by rw [h1]
            _ = q' * S_end + 10 * q' * L_2_end' + q' * W_end := by ring
        have hSend_split : (p' + q') * S_end = p' * S_end + q' * S_end :=
          Nat.add_mul p' q' S_end
        linarith only [hexp_lt, hErhs_expand, hSend_split]
      have h7_12 := hpq' 7 12 (by decide) (by decide : 2 ^ (7 + 12) ≤ 3 ^ 12)
      exact ⟨hpq', by linarith only [h7_12]⟩
    refine ⟨hcut, ?_⟩
    intro W_end p' q' hq' hpq'_le hge
    refine Nat.le_of_not_lt (fun hlt => ?_)
    have hc := (hcut W_end hlt).1 p' q' hq' hpq'_le
    omega
  · intro S_J E_suf L_2_0' W_0' hbwd
    have hcut :
        ∀ W_start : ℕ, W_0' < 2 ^ W_start →
          (∀ p q : ℕ, 1 ≤ q → 3 ^ q ≤ 2 ^ (p + q) →
            q * E_suf + 15 * q < p * S_J + 10 * (p + q) * L_2_0' + q * W_start) ∧
          17 * E_suf + 255 < 10 * S_J + 270 * L_2_0' + 17 * W_start := by
      intro W_start hW_lt
      have hpq :
          ∀ p q : ℕ, 1 ≤ q → 3 ^ q ≤ 2 ^ (p + q) →
            q * E_suf + 15 * q < p * S_J + 10 * (p + q) * L_2_0' + q * W_start := by
        intro p q hq hpq_le
        set E_lhs := S_J + E_suf
        set E_3 := S_J + 10 * L_2_0'
        have h2_15_lt : 2 ^ 15 * 2 ^ E_lhs < 3 ^ E_3 * 2 ^ W_start := by
          have h1 : 2 ^ 15 * 2 ^ E_lhs ≤ 58025 * 2 ^ E_lhs :=
            Nat.mul_le_mul_right (2 ^ E_lhs) (by decide : 2 ^ 15 ≤ 58025)
          have h2 : 3 ^ E_3 * W_0' < 3 ^ E_3 * 2 ^ W_start :=
            Nat.mul_lt_mul_of_pos_left hW_lt (Nat.pow_pos (by decide))
          exact lt_of_le_of_lt h1 (lt_trans hbwd h2)
        have hpow_q : (2 ^ 15 * 2 ^ E_lhs) ^ q < (3 ^ E_3 * 2 ^ W_start) ^ q :=
          pow_lt_pow_of_lt h2_15_lt hq
        have hlhs_eq : 2 ^ (q * E_lhs + 15 * q) = (2 ^ 15 * 2 ^ E_lhs) ^ q := by
          calc 2 ^ (q * E_lhs + 15 * q)
              = 2 ^ (15 * q) * 2 ^ (q * E_lhs) := by rw [Nat.add_comm, Nat.pow_add]
            _ = (2 ^ 15) ^ q * (2 ^ E_lhs) ^ q := by
                rw [Nat.pow_mul 2 15 q, Nat.mul_comm q E_lhs, Nat.pow_mul 2 E_lhs q]
            _ = (2 ^ 15 * 2 ^ E_lhs) ^ q := (Nat.mul_pow (2 ^ 15) (2 ^ E_lhs) q).symm
        have h3_le : (3 ^ E_3) ^ q ≤ 2 ^ ((p + q) * E_3) := by
          calc (3 ^ E_3) ^ q
              = 3 ^ (E_3 * q) := (Nat.pow_mul 3 E_3 q).symm
            _ = 3 ^ (q * E_3) := by rw [Nat.mul_comm E_3 q]
            _ = (3 ^ q) ^ E_3 := Nat.pow_mul 3 q E_3
            _ ≤ (2 ^ (p + q)) ^ E_3 := Nat.pow_le_pow_left hpq_le E_3
            _ = 2 ^ ((p + q) * E_3) := (Nat.pow_mul 2 (p + q) E_3).symm
        have hrhs_le : (3 ^ E_3 * 2 ^ W_start) ^ q ≤ 2 ^ ((p + q) * E_3 + q * W_start) := by
          calc (3 ^ E_3 * 2 ^ W_start) ^ q
              = (3 ^ E_3) ^ q * (2 ^ W_start) ^ q := Nat.mul_pow (3 ^ E_3) (2 ^ W_start) q
            _ ≤ 2 ^ ((p + q) * E_3) * (2 ^ W_start) ^ q := Nat.mul_le_mul_right _ h3_le
            _ = 2 ^ ((p + q) * E_3) * 2 ^ (W_start * q) := by rw [← Nat.pow_mul 2 W_start q]
            _ = 2 ^ ((p + q) * E_3) * 2 ^ (q * W_start) := by rw [Nat.mul_comm W_start q]
            _ = 2 ^ ((p + q) * E_3 + q * W_start) := (Nat.pow_add 2 _ _).symm
        have hpow2_lt : 2 ^ (q * E_lhs + 15 * q) < 2 ^ ((p + q) * E_3 + q * W_start) := by
          rw [hlhs_eq]
          exact lt_of_lt_of_le hpow_q hrhs_le
        have hexp_lt : q * E_lhs + 15 * q < (p + q) * E_3 + q * W_start := by
          refine Nat.lt_of_not_le (fun hge => ?_)
          have hp_ge : 2 ^ ((p + q) * E_3 + q * W_start) ≤ 2 ^ (q * E_lhs + 15 * q) :=
            Nat.pow_le_pow_right (by decide) hge
          omega
        have hElhs_expand : q * E_lhs = q * S_J + q * E_suf := by dsimp [E_lhs]; ring
        have hE3_expand :
            (p + q) * E_3 = p * S_J + q * S_J + 10 * (p + q) * L_2_0' := by
          dsimp [E_3]; ring
        linarith only [hexp_lt, hElhs_expand, hE3_expand]
      have h10_17 := hpq 10 17 (by decide) (by decide : 3 ^ 17 ≤ 2 ^ (10 + 17))
      exact ⟨hpq, by linarith only [h10_17]⟩
    refine ⟨hcut, ?_⟩
    intro W_start p q hq hpq_le hge
    refine Nat.le_of_not_lt (fun hlt => ?_)
    have hc := (hcut W_start hlt).1 p q hq hpq_le
    omega

/-!
## Section 127: Unconditional Abelian Anagram Scaled-State Jump & Terminal State Growth Theorem (Requiring Zero Shared Prefix and Zero Shared Suffix!)

What happens when two windows `(W, L_2, L_1)` and `(W', L'_2, L'_1)` are **pure step-sum anagrams**
(`S_N = S'_M = S_end`) with **zero** shared prefix and **zero** shared suffix?
By Section 102 Part 2, for **any** two waves `r_1 < r_2` in a Dense Core orbit (with **no**
run-matching assumption at all!), the universal CRT locks hold:
  `7,427,200 ∣ (X'(0) - X(0))`  and  `126,900,675 ∣ (Y'(M + 1) - Y(N + 1))`!
Since `X(0) < X'(0)` and `Y(N + 1) < Y'(M + 1)`, we have `7427200 ≤ X'(0) - X(0)` and
`126900675 ≤ Y'(M + 1) - Y(N + 1)`.
Combining these with the scaled master identities on both windows and `19 * Acc'_M < 3 ^ S_end`:
1. **Unconditional Terminal Scaled Jump (`7,427,199 * 3 ^ S_end < 2 ^ S_end * (Y'(M+1) - Y(N+1))`):**
     `2 ^ S_end * (Y'(M + 1) - Y(N + 1)) = 3 ^ S_end * (X'(0) - X(0)) + 19 * Acc_N - 19 * Acc'_M > 7427199 * 3 ^ S_end`!
2. **Unconditional Initial Scaled Jump (`126,900,675 * 2 ^ S_end < 3 ^ S_end * X'(0)`):**
     `126900675 * 2 ^ S_end ≤ 2 ^ S_end * Y'(M + 1) < 3 ^ S_end * X'(0)`!
3. **Step-Sum-Free Terminal Cutoff (`7 * S_end + 264 < 120 * L'_2(M + 1) + 12 * W_end`):**
   Since `2 ^ 22 = 4,194,304 ≤ 7,427,199`, for every rational lower bound `2 ^ (p' + q') ≤ 3 ^ q'`
   (`1 ≤ q'`), whenever `W'(M + 1) < 2 ^ W_end`:
     `p' * S_end + 22 * q' < 10 * q' * L'_2 (M + 1) + q' * W_end`,
   and at `(p', q') = (7, 12)`:
     `7 * S_end + 264 < 120 * L'_2 (M + 1) + 12 * W_end`!
