    have hcopY3_all : Nat.Coprime (Nat.gcd (U (N + 1)) (19 * Acc_N)) (3 ^ (S_N + 7 * L_1 0)) := by
      have hndvd3_Acc :=
        (dense_core_dualWaveInteriorAcc_telescopic_cross_defect_and_mirror_collapses.1
