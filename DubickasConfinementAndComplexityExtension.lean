        · omega
        · exfalso; have := hno101_0 h0; omega
        · exfalso; have := hno11_0 h0; omega
        · exfalso; have := hno11_0 h0; omega
      have hmatch : ∀ t < W + 3, dubCarry ξ 0 (2 + t) = dubCarry ξ 0 (5 + t) := by
